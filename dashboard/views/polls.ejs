<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"/><title>Polls - Legendary Bot</title><meta name="viewport" content="width=device-width, initial-scale=1.0"/><link rel="stylesheet" href="/style.css"/><link rel="icon" type="image/png" href="/favicon.png?v=10.0.0"/></head><body><div class="app-shell"><%- include("partials/sidebar") %><main class="main-content"><%- include("partials/topbar", { pageTitle: "Polls", pageSubtitle: "Create quick reaction polls from the dashboard." }) %><% if (success) { %><div class="alert success"><%= success %></div><% } %><% if (error) { %><div class="alert error"><%= error %></div><% } %><section class="hero-card"><div class="hero-text"><div class="hero-icon-wrap"><img src="<%= botAvatar %>" class="hero-bot-avatar"/></div><div><h2>📊 Poll Builder</h2><p>Send a clean poll embed to any channel. Members vote using number reactions.</p></div></div></section><section class="section-card"><div class="section-header"><h2>Create Poll</h2><p>Add 2-5 options.</p></div><form method="POST" action="/polls/send" class="form-stack padded-form"><label class="form-group"><span>Channel</span><select name="channelId" class="input" required><option value="">Select a channel</option><% channelGroups.forEach(group => { %><optgroup label="📁 <%= group.name %>"><% group.channels.forEach(channel => { %><option value="<%= channel.id %>"># <%= channel.name %></option><% }) %></optgroup><% }) %></select></label><label class="form-group"><span>Question</span><input name="question" class="input" placeholder="What should we do next?" required/></label><div class="mini-grid"><input name="option1" class="input" placeholder="Option 1" required/><input name="option2" class="input" placeholder="Option 2" required/><input name="option3" class="input" placeholder="Option 3"/><input name="option4" class="input" placeholder="Option 4"/><input name="option5" class="input" placeholder="Option 5"/></div><div class="color-row"><input type="color" name="color" class="color-picker" value="#8b5cf6"/><input class="input color-hex-input" value="#8b5cf6" oninput="this.previousElementSibling.value=this.value"/></div><button class="primary-btn" type="submit">Send Poll</button></form></section></main></div><script src="/dashboard.js"></script><script src="/assets/js/site-music.js"></script></body></html>
