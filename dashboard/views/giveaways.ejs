<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Giveaways - Legendary Bot</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="stylesheet" href="/style.css" />
  <link rel="icon" type="image/png" href="/favicon.png?v=giveaway-v2" />
  <style>
    .giveaway-page { display: grid; gap: 18px; }
    .giveaway-hero {
      position: relative; overflow: hidden; border-radius: 30px; padding: 30px;
      background:
        radial-gradient(circle at 15% 15%, rgba(236,72,153,.34), transparent 32rem),
        radial-gradient(circle at 86% 20%, rgba(245,158,11,.24), transparent 30rem),
        linear-gradient(135deg, rgba(28,12,38,.94), rgba(28,18,6,.92));
      border: 1px solid rgba(255,255,255,.14);
      box-shadow: 0 26px 80px rgba(0,0,0,.28);
    }
    .giveaway-hero::after { content: "🎉"; position: absolute; right: 26px; bottom: -18px; font-size: 9rem; opacity: .13; animation: gaFloat 2.8s ease-in-out infinite; }
    .ga-badge { display: inline-flex; align-items: center; gap: 8px; padding: 8px 12px; border-radius: 999px; background: rgba(245,158,11,.14); border: 1px solid rgba(245,158,11,.32); color: #fde68a; font-weight: 1000; font-size: .82rem; }
    .giveaway-hero h1 { margin: 14px 0 0; font-size: clamp(2.25rem, 5vw, 4.8rem); letter-spacing: -.08em; line-height: .92; }
    .giveaway-hero p { max-width: 820px; margin: 12px 0 0; color: #ffe4f3; line-height: 1.65; }
    .ga-stat-grid { display: grid; grid-template-columns: repeat(4, minmax(0,1fr)); gap: 14px; }
    .ga-stat, .ga-card { border: 1px solid rgba(255,255,255,.12); background: rgba(255,255,255,.055); border-radius: 24px; padding: 18px; box-shadow: 0 18px 44px rgba(0,0,0,.18); }
    .ga-stat span { color: #fbcfe8; font-weight: 900; font-size: .8rem; text-transform: uppercase; letter-spacing: .09em; }
    .ga-stat strong { display: block; margin-top: 8px; font-size: 2rem; letter-spacing: -.05em; }
    .ga-layout { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(340px, .85fr); gap: 18px; align-items: start; }
    .ga-card h2, .ga-card h3 { margin: 0 0 10px; }
    .ga-muted { color: #fed7aa; line-height: 1.55; margin: 0 0 14px; }
    .ga-form { display: grid; gap: 13px; }
    .ga-field { display: grid; gap: 7px; font-weight: 1000; }
    .ga-input, .ga-select, .ga-textarea { width: 100%; border-radius: 16px; border: 1px solid rgba(255,255,255,.13); background: rgba(255,255,255,.075); color: #fff; padding: 12px 13px; outline: none; font-weight: 850; }
    .ga-select option { color: #111827; background: #fff; }
    .ga-textarea { min-height: 105px; resize: vertical; line-height: 1.5; }
    .ga-row { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 12px; }
    .ga-toggle { display: flex; align-items: center; gap: 10px; font-weight: 1000; padding: 12px; border-radius: 15px; background: rgba(255,255,255,.055); border: 1px solid rgba(255,255,255,.10); }
    .ga-toggle input { width: 19px; height: 19px; accent-color: #f59e0b; }
    .ga-btn { border: 0; border-radius: 16px; padding: 12px 16px; font-weight: 1000; color: #190b05; background: linear-gradient(135deg,#f59e0b,#ec4899); cursor: pointer; text-decoration: none; display: inline-flex; justify-content: center; align-items: center; gap: 8px; }
    .ga-btn.secondary { color: #fff; background: rgba(255,255,255,.08); border: 1px solid rgba(255,255,255,.13); }
    .ga-btn.danger { color: #fff; background: rgba(239,68,68,.16); border: 1px solid rgba(239,68,68,.35); }
    .ga-table { display: grid; gap: 10px; }
    .ga-run { display: grid; gap: 10px; padding: 14px; border-radius: 18px; background: rgba(0,0,0,.18); border: 1px solid rgba(255,255,255,.10); }
    .ga-run-top { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; }
    .ga-run-title { font-size: 1.05rem; font-weight: 1000; }
    .ga-pill { display: inline-flex; align-items: center; border-radius: 999px; padding: 6px 9px; font-weight: 1000; font-size: .78rem; border: 1px solid rgba(255,255,255,.13); background: rgba(255,255,255,.07); color: #fff; }
    .ga-pill.live { color: #bbf7d0; border-color: rgba(34,197,94,.35); background: rgba(34,197,94,.12); }
    .ga-pill.locked { color: #fde68a; border-color: rgba(245,158,11,.35); background: rgba(245,158,11,.13); }
    .ga-run-meta { display: flex; flex-wrap: wrap; gap: 8px; color: #fed7aa; font-size: .88rem; font-weight: 800; }
    .ga-actions { display: flex; flex-wrap: wrap; gap: 8px; }
    .ga-empty { padding: 18px; border-radius: 18px; border: 1px dashed rgba(255,255,255,.16); color: #fed7aa; text-align: center; }
    .ga-premium-box { border-radius: 22px; padding: 18px; background: linear-gradient(135deg, rgba(245,158,11,.18), rgba(236,72,153,.14)); border: 1px solid rgba(245,158,11,.28); }
    @keyframes gaFloat { 50% { transform: translateY(-8px) rotate(6deg) scale(1.06); } }
    @media (max-width: 980px) { .ga-layout, .ga-stat-grid { grid-template-columns: 1fr; } .giveaway-hero { padding: 24px; } }
    @media (max-width: 650px) { .ga-row { grid-template-columns: 1fr; } .ga-run-top { flex-direction: column; } }
  </style>
</head>
<body>
  <div class="app-shell">
    <%- include("partials/sidebar") %>

    <main class="main-content">
      <%- include("partials/topbar", {
        pageTitle: "Giveaways",
        pageSubtitle: premiumEnabled ? "Premium giveaway control center for this server." : "Premium giveaway dashboard preview."
      }) %>

      <% if (success) { %><div class="alert success"><%= success %></div><% } %>
      <% if (error) { %><div class="alert error"><%= error %></div><% } %>

      <section class="giveaway-page">
        <div class="giveaway-hero">
          <span class="ga-badge"><%= premiumEnabled ? "💎 Premium Active" : "🔒 Premium Feature" %></span>
          <h1>Giveaway Dashboard</h1>
          <p>Create giveaways from the dashboard, post them to Discord, track entries, end/delete runs, and prepare the system for the full GiveX merge.</p>
        </div>

        <div class="ga-stat-grid">
          <div class="ga-stat"><span>Active</span><strong><%= giveawayStats.active %></strong></div>
          <div class="ga-stat"><span>Ended</span><strong><%= giveawayStats.ended %></strong></div>
          <div class="ga-stat"><span>Total</span><strong><%= giveawayStats.total %></strong></div>
          <div class="ga-stat"><span>Entries</span><strong><%= giveawayStats.entries %></strong></div>
        </div>

        <div class="ga-layout">
          <div class="ga-card">
            <h2>➕ Create Giveaway</h2>
            <p class="ga-muted">Choose a channel, prize, duration, winners, and message text. The bot will post a Discord giveaway message with Join and Entries buttons.</p>
            <form class="ga-form" method="POST" action="<%= routeBase || '' %>/dashboard/giveaways/create">
              <label class="ga-field">
                <span>Prize</span>
                <input class="ga-input" name="prize" placeholder="Example: Nitro, 20 cats, VIP role" required />
              </label>

              <label class="ga-field">
                <span>Channel</span>
                <select class="ga-select" name="channelId" required>
                  <option value="">Select a channel</option>
                  <% (channelGroups || []).forEach(group => { %>
                    <optgroup label="📁 <%= group.name %>">
                      <% (group.channels || []).forEach(channel => { %>
                        <option value="<%= channel.id %>"># <%= channel.name %></option>
                      <% }) %>
                    </optgroup>
                  <% }) %>
                </select>
              </label>

              <div class="ga-row">
                <label class="ga-field">
                  <span>Duration minutes</span>
                  <input class="ga-input" type="number" min="1" max="525600" name="durationMinutes" value="<%= giveawayConfig.defaultDurationMinutes || 1440 %>" />
                </label>
                <label class="ga-field">
                  <span>Winners</span>
                  <input class="ga-input" type="number" min="1" max="25" name="winnersCount" value="<%= giveawayConfig.defaultWinners || 1 %>" />
                </label>
              </div>

              <label class="ga-field">
                <span>Description</span>
                <textarea class="ga-textarea" name="description" placeholder="Click Join to enter!">Click Join to enter!</textarea>
              </label>

              <button class="ga-btn" type="submit">🎉 Create + Post Giveaway</button>
            </form>
          </div>

          <div class="ga-card">
            <h2>⚙ Giveaway Settings</h2>
            <p class="ga-muted">Server-wide giveaway defaults. Premium is checked by Guild ID, so premium applies to the whole server.</p>
            <form class="ga-form" method="POST" action="<%= routeBase || '' %>/dashboard/giveaways/settings">
              <label class="ga-toggle"><input type="checkbox" name="enabled" <%= giveawayConfig.enabled ? "checked" : "" %> /> Enable giveaway dashboard tools</label>
              <label class="ga-toggle"><input type="checkbox" name="dmWinners" <%= giveawayConfig.dmWinners !== false ? "checked" : "" %> /> DM winners when possible</label>

              <label class="ga-field">
                <span>Log Channel</span>
                <select class="ga-select" name="logChannelId">
                  <option value="">No log channel yet</option>
                  <% (channelGroups || []).forEach(group => { %>
                    <optgroup label="📁 <%= group.name %>">
                      <% (group.channels || []).forEach(channel => { %>
                        <option value="<%= channel.id %>" <%= giveawayConfig.logChannelId === channel.id ? "selected" : "" %>># <%= channel.name %></option>
                      <% }) %>
                    </optgroup>
                  <% }) %>
                </select>
              </label>

              <div class="ga-row">
                <label class="ga-field"><span>Default duration</span><input class="ga-input" type="number" min="1" max="525600" name="defaultDurationMinutes" value="<%= giveawayConfig.defaultDurationMinutes || 1440 %>" /></label>
                <label class="ga-field"><span>Default winners</span><input class="ga-input" type="number" min="1" max="25" name="defaultWinners" value="<%= giveawayConfig.defaultWinners || 1 %>" /></label>
              </div>

              <label class="ga-field">
                <span>Notes</span>
                <textarea class="ga-textarea" name="notes"><%= giveawayConfig.notes || "" %></textarea>
              </label>
              <button class="ga-btn secondary" type="submit">💾 Save Settings</button>
            </form>
          </div>
        </div>

        <div class="ga-card">
          <h2>🔥 Active Giveaways</h2>
          <div class="ga-table">
            <% if (!activeGiveaways.length) { %>
              <div class="ga-empty">No active dashboard giveaways yet.</div>
            <% } %>
            <% activeGiveaways.forEach(run => { %>
              <div class="ga-run">
                <div class="ga-run-top">
                  <div>
                    <div class="ga-run-title">🎁 <%= run.prize %></div>
                    <div class="ga-run-meta">
                      <span>Entries: <%= run.entries.length %></span>
                      <span>Winners: <%= run.winnersCount %></span>
                      <span>Ends: <%= formatGiveawayTime(run.endsAt) %></span>
                    </div>
                  </div>
                  <span class="ga-pill live">Running</span>
                </div>
                <div class="ga-actions">
                  <form method="POST" action="<%= routeBase || '' %>/dashboard/giveaways/<%= run._id %>/end"><button class="ga-btn secondary" type="submit">End</button></form>
                  <form method="POST" action="<%= routeBase || '' %>/dashboard/giveaways/<%= run._id %>/delete"><button class="ga-btn danger" type="submit">Delete</button></form>
                </div>
              </div>
            <% }) %>
          </div>
        </div>

        <div class="ga-card">
          <h2>📜 Recent Ended Giveaways</h2>
          <div class="ga-table">
            <% if (!endedGiveaways.length) { %>
              <div class="ga-empty">No ended dashboard giveaways yet.</div>
            <% } %>
            <% endedGiveaways.slice(0, 15).forEach(run => { %>
              <div class="ga-run">
                <div class="ga-run-top">
                  <div>
                    <div class="ga-run-title">🎁 <%= run.prize %></div>
                    <div class="ga-run-meta">
                      <span>Status: <%= run.status %></span>
                      <span>Entries: <%= run.entries.length %></span>
                      <span>Ended: <%= formatGiveawayTime(run.endedAt || run.endsAt) %></span>
                    </div>
                  </div>
                  <span class="ga-pill">Done</span>
                </div>
              </div>
            <% }) %>
          </div>
        </div>
      </section>
    </main>
  </div>
  <script src="/dashboard.js"></script>
  <script src="/assets/js/site-music.js"></script>
</body>
</html>
