<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Login - Legendary Bot Dashboard</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/png" href="/favicon.png?v=16.2.0" />
  <link rel="shortcut icon" type="image/png" href="/favicon.png?v=16.2.0" />

  <style>
    * { box-sizing: border-box; }

    html,
    body {
      margin: 0;
      min-height: 100%;
      font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      background:
        radial-gradient(circle at top left, rgba(168, 85, 247, 0.38), transparent 32%),
        radial-gradient(circle at bottom right, rgba(34, 211, 238, 0.22), transparent 35%),
        linear-gradient(135deg, #070720 0%, #111039 48%, #070720 100%);
      color: #ffffff;
    }

    body {
      min-height: 100vh;
      display: grid;
      place-items: center;
      padding: 28px;
      overflow-x: hidden;
    }

    .login-shell {
      width: min(1225px, 100%);
      min-height: 805px;
      display: grid;
      grid-template-columns: 0.9fr 1.1fr;
      border-radius: 34px;
      overflow: hidden;
      border: 1px solid rgba(255, 255, 255, 0.1);
      background: rgba(13, 13, 38, 0.82);
      box-shadow: 0 30px 90px rgba(0, 0, 0, 0.42), inset 0 1px 0 rgba(255, 255, 255, 0.08);
      backdrop-filter: blur(18px);
    }

    .login-art {
      position: relative;
      padding: 44px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      background: linear-gradient(140deg, rgba(139, 92, 246, 0.88), rgba(59, 130, 246, 0.22)), url("<%= botBanner || '' %>");
      background-size: cover;
      background-position: center;
      isolation: isolate;
    }

    .login-art::before {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(180deg, rgba(4, 4, 18, 0.08), rgba(4, 4, 18, 0.46));
      z-index: -1;
    }

    .brand-mini {
      display: inline-flex;
      align-items: center;
      gap: 14px;
      padding: 14px 16px;
      width: fit-content;
      border-radius: 20px;
      background: rgba(5, 6, 22, 0.42);
      border: 1px solid rgba(255, 255, 255, 0.14);
      box-shadow: 0 14px 35px rgba(0, 0, 0, 0.25);
    }

    .brand-mini img {
      width: 60px;
      height: 60px;
      border-radius: 16px;
      object-fit: cover;
      flex: 0 0 auto;
    }

    .brand-mini span {
      font-size: 17px;
      font-weight: 1000;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: #ffffff;
    }

    .art-title {
      margin: 0;
      font-size: clamp(48px, 6vw, 82px);
      line-height: 0.98;
      letter-spacing: -0.055em;
      font-weight: 1000;
      color: #ffffff;
      text-shadow: 0 18px 45px rgba(0, 0, 0, 0.35);
    }

    .art-subtitle {
      max-width: 470px;
      margin: 24px 0 0;
      color: rgba(255, 255, 255, 0.88);
      font-size: 20px;
      line-height: 1.48;
      font-weight: 700;
    }

    .login-panel {
      padding: 68px 72px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      background: linear-gradient(180deg, rgba(15, 15, 45, 0.98), rgba(8, 8, 28, 0.98));
    }

    .login-logo-row {
      display: flex;
      align-items: center;
      gap: 24px;
      margin-bottom: 34px;
    }

    .login-logo {
      width: 88px;
      height: 88px;
      border-radius: 24px;
      object-fit: cover;
      box-shadow: 0 18px 42px rgba(0, 0, 0, 0.38);
      flex: 0 0 auto;
    }

    .login-heading {
      margin: 0;
      font-size: clamp(44px, 5vw, 72px);
      line-height: 0.9;
      font-weight: 1000;
      letter-spacing: -0.06em;
      color: #f4efff;
    }

    .login-heading span {
      display: block;
      background: linear-gradient(135deg, #ffffff, #b7a2ff 58%, #38bdf8);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }

    .login-subtext {
      margin: 0 0 32px;
      color: #d5d0ff;
      font-size: 19px;
      line-height: 1.55;
      font-weight: 800;
    }

    .login-form { display: grid; gap: 22px; }

    .login-input {
      width: 100%;
      min-height: 82px;
      border: 1px solid rgba(255, 255, 255, 0.12);
      outline: none;
      border-radius: 24px;
      padding: 0 26px;
      background: rgba(255, 255, 255, 0.94);
      color: #16162f;
      font-size: 20px;
      font-weight: 800;
      transition: 0.18s ease;
      box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.22);
    }

    .login-input::placeholder { color: rgba(22, 22, 47, 0.58); }

    .login-input:focus {
      background: #ffffff;
      border-color: rgba(139, 92, 246, 0.7);
      box-shadow: 0 0 0 4px rgba(139, 92, 246, 0.18), inset 0 0 0 1px rgba(139, 92, 246, 0.24);
      transform: translateY(-1px);
    }

    .login-button {
      min-height: 84px;
      border: none;
      border-radius: 24px;
      cursor: pointer;
      color: #ffffff;
      font-size: 21px;
      font-weight: 1000;
      letter-spacing: 0.01em;
      background: linear-gradient(135deg, #7c3aed, #3b82f6 52%, #22d3ee);
      box-shadow: 0 18px 40px rgba(59, 130, 246, 0.28);
      transition: 0.18s ease;
    }

    .login-button:hover {
      transform: translateY(-2px);
      box-shadow: 0 22px 48px rgba(59, 130, 246, 0.38);
      filter: brightness(1.05);
    }

    .login-error {
      margin: 0 0 20px;
      padding: 15px 17px;
      border-radius: 16px;
      background: rgba(239, 68, 68, 0.16);
      border: 1px solid rgba(239, 68, 68, 0.38);
      color: #fecaca;
      font-size: 15px;
      font-weight: 900;
    }

    .login-small {
      margin: 22px 0 0;
      color: rgba(201, 197, 255, 0.72);
      font-size: 14px;
      line-height: 1.45;
      font-weight: 700;
      text-align: center;
    }

    @media (max-width: 900px) {
      body { padding: 18px; align-items: start; }
      .login-shell { grid-template-columns: 1fr; min-height: auto; }
      .login-art { min-height: 330px; }
      .login-panel { padding: 38px 24px; }
      .login-logo { width: 68px; height: 68px; border-radius: 18px; }
    }
  </style>
</head>

<body>
  <section class="login-shell">
    <div class="login-art">
      <div class="brand-mini">
        <img src="<%= botAvatar %>" alt="Legendary Bot" />
        <span>Legendary Bot</span>
      </div>

      <div>
        <h1 class="art-title">Control your server with style.</h1>
        <p class="art-subtitle">Manage messages, embeds, moderation, automations, and server tools from one clean dashboard.</p>
      </div>
    </div>

    <main class="login-panel">
      <div class="login-logo-row">
        <img src="<%= botAvatar %>" class="login-logo" alt="Legendary Bot" />

        <h2 class="login-heading">
          <span>Legendary</span>
          <span>Bot</span>
          <span>Dashboard</span>
        </h2>
      </div>

      <p class="login-subtext">Enter your dashboard password to continue.</p>

      <% if (error) { %>
        <div class="login-error"><%= error %></div>
      <% } %>

      <form class="login-form" method="POST" action="/login" data-no-ajax="true" data-no-loading="false">
        <input class="login-input" type="password" name="password" placeholder="Dashboard Password" autocomplete="current-password" required />
        <button class="login-button" type="submit">Login</button>
      </form>

      <p class="login-small">Secure access only. Keep your dashboard password private.</p>
    </main>
  </section>
<script src="/assets/js/site-music.js"></script></body>
</html>
