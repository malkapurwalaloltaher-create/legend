<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Your Servers - Legendary Bot</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="stylesheet" href="/style.css" />

  <style>
    body {
      margin: 0;
      min-height: 100vh;
      background:
        radial-gradient(circle at top left, rgba(139, 92, 246, 0.32), transparent 34%),
        linear-gradient(135deg, #06051f, #11113c 48%, #070720);
      color: #fff;
      font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }

    .customer-page {
      width: min(1280px, calc(100% - 44px));
      margin: 0 auto;
      padding: 34px 0 56px;
    }

    .customer-topbar {
      display: flex;
      justify-content: space-between;
      gap: 18px;
      align-items: center;
      margin-bottom: 28px;
      padding: 20px;
      border-radius: 28px;
      background: rgba(18, 18, 48, 0.82);
      border: 1px solid rgba(255, 255, 255, 0.08);
      box-shadow: 0 22px 55px rgba(0, 0, 0, 0.25);
    }

    .customer-user {
      display: flex;
      align-items: center;
      gap: 14px;
      min-width: 0;
    }

    .customer-user img {
      width: 62px;
      height: 62px;
      border-radius: 18px;
      object-fit: cover;
    }

    .customer-user h1 {
      margin: 0;
      font-size: 28px;
      line-height: 1;
      font-weight: 1000;
    }

    .customer-user p {
      margin: 6px 0 0;
      color: #c9c5ff;
      font-weight: 700;
    }

    .customer-top-actions {
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
      justify-content: flex-end;
    }

    .customer-small-btn {
      min-height: 46px;
      padding: 0 18px;
      border-radius: 16px;
      color: #fff;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-weight: 950;
      background: rgba(139, 92, 246, 0.18);
      border: 1px solid rgba(139, 92, 246, 0.38);
    }

    .customer-hero {
      padding: 32px;
      border-radius: 30px;
      margin-bottom: 24px;
      background:
        linear-gradient(135deg, rgba(124, 58, 237, 0.72), rgba(14, 116, 144, 0.42)),
        rgba(18, 18, 48, 0.92);
      border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .customer-hero h2 {
      margin: 0;
      font-size: clamp(34px, 4vw, 56px);
      line-height: 1;
      letter-spacing: -0.05em;
      font-weight: 1000;
    }

    .customer-hero p {
      max-width: 840px;
      margin: 14px 0 0;
      color: #ede9fe;
      font-size: 17px;
      line-height: 1.55;
      font-weight: 650;
    }

    .customer-alert {
      margin-bottom: 18px;
      padding: 14px 16px;
      border-radius: 16px;
      font-weight: 850;
    }

    .customer-alert.error {
      color: #fecaca;
      background: rgba(239, 68, 68, 0.16);
      border: 1px solid rgba(239, 68, 68, 0.38);
    }

    .customer-alert.success {
      color: #bbf7d0;
      background: rgba(34, 197, 94, 0.14);
      border: 1px solid rgba(34, 197, 94, 0.34);
    }

    .server-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 18px;
    }

    .server-card {
      padding: 20px;
      border-radius: 26px;
      background: rgba(18, 18, 48, 0.86);
      border: 1px solid rgba(255, 255, 255, 0.08);
      box-shadow: 0 18px 46px rgba(0, 0, 0, 0.22);
      min-height: 255px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .server-head {
      display: flex;
      gap: 14px;
      align-items: center;
      min-width: 0;
    }

    .server-head img {
      width: 66px;
      height: 66px;
      border-radius: 20px;
      object-fit: cover;
      flex: 0 0 auto;
    }

    .server-head h3 {
      margin: 0;
      font-size: 20px;
      line-height: 1.15;
      font-weight: 1000;
      word-break: break-word;
    }

    .server-head p {
      margin: 5px 0 0;
      color: #c9c5ff;
      font-weight: 700;
      font-size: 13px;
    }

    .server-tags {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
      margin: 18px 0;
    }

    .tag {
      padding: 8px 10px;
      border-radius: 999px;
      font-size: 12px;
      font-weight: 1000;
      border: 1px solid rgba(255, 255, 255, 0.1);
      background: rgba(255, 255, 255, 0.06);
      color: #d9d5ff;
    }

    .tag.good {
      color: #5cffd6;
      background: rgba(20, 184, 166, 0.18);
      border-color: rgba(20, 184, 166, 0.42);
    }

    .tag.warn {
      color: #ffd66b;
      background: rgba(245, 158, 11, 0.16);
      border-color: rgba(245, 158, 11, 0.38);
    }

    .tag.bad {
      color: #fecaca;
      background: rgba(239, 68, 68, 0.14);
      border-color: rgba(239, 68, 68, 0.34);
    }

    .server-action {
      width: 100%;
      min-height: 52px;
      border: 0;
      border-radius: 18px;
      color: #fff;
      font-weight: 1000;
      font-size: 15px;
      cursor: pointer;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: linear-gradient(135deg, #7c3aed, #3b82f6 52%, #22d3ee);
      transition: 0.18s ease;
    }

    .server-action:hover {
      transform: translateY(-2px);
      filter: brightness(1.06);
    }

    .server-action.secondary {
      background: rgba(139, 92, 246, 0.18);
      border: 1px solid rgba(139, 92, 246, 0.38);
    }

    .server-action.disabled {
      cursor: not-allowed;
      opacity: 0.55;
      background: rgba(255, 255, 255, 0.08);
    }

    @media (max-width: 1050px) {
      .server-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media (max-width: 720px) {
      .server-grid {
        grid-template-columns: 1fr;
      }

      .customer-topbar {
        align-items: flex-start;
        flex-direction: column;
      }

      .customer-top-actions {
        justify-content: flex-start;
      }
    }
  </style>
</head>
<body>
  <main class="customer-page">
    <header class="customer-topbar">
      <div class="customer-user">
        <img src="<%= discordUser.avatarUrl %>" alt="Discord User" />
        <div>
          <h1><%= discordUser.globalName || discordUser.username %></h1>
          <p>Connected Discord Account</p>
        </div>
      </div>

      <div class="customer-top-actions">
        <a class="customer-small-btn" href="/auth/discord">Refresh Servers</a>
        <a class="customer-small-btn" href="<%= inviteUrl %>" target="_blank" rel="noreferrer">Invite Bot</a>
        <a class="customer-small-btn" href="/customer/logout">Logout</a>
      </div>
    </header>

    <% if (error) { %>
      <div class="customer-alert error"><%= error %></div>
    <% } %>

    <% if (success) { %>
      <div class="customer-alert success"><%= success %></div>
    <% } %>

    <section class="customer-hero">
      <h2>Select a server</h2>
      <p>
        Your customer area: <strong><%= customerBaseUrl %></strong><br />
        Servers you can manage appear first. If Legendary Bot is already installed, click Manage.
        If not installed, click Invite Bot and return here after adding it.
      </p>
    </section>

    <section class="server-grid">
      <% if (!servers || !servers.length) { %>
        <div class="server-card">
          <div>
            <h3>No servers found</h3>
            <p>Login again or make sure your Discord account is in servers where you have Manage Server permission.</p>
          </div>
        </div>
      <% } %>

      <% (servers || []).forEach(server => { %>
        <article class="server-card">
          <div>
            <div class="server-head">
              <img src="<%= server.icon %>" alt="<%= server.name %>" />
              <div>
                <h3><%= server.name %></h3>
                <p><%= server.memberCount ? `${server.memberCount} members` : `Server ID: ${server.id}` %></p>
              </div>
            </div>

            <div class="server-tags">
              <% if (server.canManage) { %>
                <span class="tag good">Can Manage</span>
              <% } else { %>
                <span class="tag bad">No Permission</span>
              <% } %>

              <% if (server.installed) { %>
                <span class="tag good">Bot Installed</span>
              <% } else { %>
                <span class="tag warn">Bot Missing</span>
              <% } %>

              <% if (server.premiumEnabled) { %>
                <span class="tag warn">Premium</span>
              <% } else { %>
                <span class="tag">Free</span>
              <% } %>
            </div>
          </div>

          <% if (server.status === "manage") { %>
            <form method="POST" action="<%= customerBaseUrl %>/server/<%= server.id %>/manage" data-no-ajax="true" data-no-loading="false">
              <button class="server-action" type="submit">Manage Server</button>
            </form>
          <% } else if (server.status === "invite") { %>
            <a class="server-action secondary" href="<%= server.inviteUrl %>" target="_blank" rel="noreferrer">Invite Bot</a>
          <% } else { %>
            <button class="server-action disabled" type="button">No Permission</button>
          <% } %>
        </article>
      <% }) %>
    </section>
  </main>
<script src="/assets/js/site-music.js"></script></body>
</html>
