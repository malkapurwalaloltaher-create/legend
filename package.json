{
  "name": "legendary-bot",
  "version": "20.17.9",
  "description": "Legend Hub Bot v20.17.9 final build with dashboard fallback-query fixes and command-center access-level fix",
  "main": "index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node index.js",
    "db:status": "node scripts/check-split-db-status.js",
    "db:migrate:dry": "node scripts/migrate-to-split-dbs.js --dry-run",
    "db:migrate": "node scripts/migrate-to-split-dbs.js",
    "db:migrate:overwrite": "node scripts/migrate-to-split-dbs.js --overwrite",
    "db:merge:dry": "node scripts/smart-merge-split-dbs.js --dry-run",
    "db:merge": "node scripts/smart-merge-split-dbs.js",
    "backup:local": "node scripts/local-backup-sync.js --pull"
