<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Welcome & Goodbye - Legendary Bot</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="stylesheet" href="/style.css" />
  <link rel="icon" type="image/png" href="/favicon.png?v=6.3.0" />
  <link rel="shortcut icon" type="image/png" href="/favicon.png?v=6.3.0" />
</head>
<body>
  <div class="app-shell">
    <%- include("partials/sidebar") %>

    <main class="main-content">
      <%- include("partials/topbar", {
        pageTitle: "Welcome & Goodbye",
        pageSubtitle: "Customize member join and leave messages for your selected server."
      }) %>

      <% if (success) { %>
        <div class="alert success"><%= success %></div>
      <% } %>

      <% if (error) { %>
        <div class="alert error"><%= error %></div>
      <% } %>

      <section class="hero-card">
        <div class="hero-text">
          <div class="hero-icon-wrap">
            <img src="<%= botAvatar %>" class="hero-bot-avatar" alt="Bot Avatar" />
          </div>
          <div>
            <h2>Welcome & Goodbye Builder</h2>
            <p>
              Design welcome and goodbye messages with custom channels, text, embeds,
              colors, images, live previews, and instant test buttons.
            </p>
          </div>
        </div>
      </section>

      <section class="section-card">
        <div class="section-header">
          <h2>Available Variables</h2>
          <p>Use these in your messages and embeds.</p>
        </div>

        <div class="template-save-box">
          <p><strong>{user}</strong> = mentions the member</p>
          <p><strong>{username}</strong> = member username</p>
          <p><strong>{server}</strong> = server name</p>
          <p><strong>{memberCount}</strong> = current member count</p>
        </div>
      </section>

      <form method="POST" action="/welcome-goodbye/save">
        <div class="builder-grid">
          <section class="section-card">
            <div class="section-header">
              <h2>Welcome Settings</h2>
              <p>Message sent when a member joins.</p>
            </div>

            <div class="form-stack">
              <label class="toggle-line">
                <input type="checkbox" name="welcomeEnabled" <%= settings.welcomeEnabled ? "checked" : "" %> />
                <span>Enable Welcome Messages</span>
              </label>

              <label class="toggle-line">
                <input type="checkbox" name="welcomeEmbedEnabled" id="welcomeEmbedEnabled" <%= settings.welcomeEmbedEnabled !== false ? "checked" : "" %> />
                <span>Send Welcome Embed</span>
              </label>

              <label class="form-group">
                <span>Welcome Channel</span>
                <select name="welcomeChannelId" class="input">
                  <option value="">Select a channel</option>

                  <% channelGroups.forEach(group => { %>
                    <optgroup label="📁 <%= group.name %>">
                      <% group.channels.forEach(channel => { %>
                        <option value="<%= channel.id %>" <%= settings.welcomeChannelId === channel.id ? "selected" : "" %>>
                          # <%= channel.name %>
                        </option>
                      <% }) %>
                    </optgroup>
                  <% }) %>
                </select>
              </label>

              <label class="form-group">
                <span>Welcome Normal Message</span>
                <textarea name="welcomeContent" id="welcomeContent" class="input textarea"><%= settings.welcomeContent || "" %></textarea>
              </label>

              <label class="form-group">
                <span>Welcome Embed Title</span>
                <input name="welcomeEmbedTitle" id="welcomeEmbedTitle" class="input" value="<%= settings.welcomeEmbedTitle || "" %>" />
              </label>

              <label class="form-group">
                <span>Welcome Embed Description</span>
                <textarea name="welcomeEmbedDescription" id="welcomeEmbedDescription" class="input textarea"><%= settings.welcomeEmbedDescription || "" %></textarea>
              </label>

              <div class="form-group">
                <span>Welcome Embed Color</span>
                <div class="color-row">
                  <input type="color" id="welcomeEmbedColorPicker" class="color-picker" value="<%= settings.welcomeEmbedColor || '#8b5cf6' %>" />
                  <input name="welcomeEmbedColor" id="welcomeEmbedColor" class="input color-hex-input" value="<%= settings.welcomeEmbedColor || '#8b5cf6' %>" />
                </div>
              </div>

              <label class="form-group">
                <span>Welcome Footer</span>
                <input name="welcomeEmbedFooter" id="welcomeEmbedFooter" class="input" value="<%= settings.welcomeEmbedFooter || "" %>" />
              </label>

              <label class="form-group">
                <span>Welcome Thumbnail URL</span>
                <input name="welcomeEmbedThumbnail" id="welcomeEmbedThumbnail" class="input" value="<%= settings.welcomeEmbedThumbnail || "" %>" placeholder="https://..." />
              </label>

              <label class="form-group">
                <span>Welcome Image URL</span>
                <input name="welcomeEmbedImage" id="welcomeEmbedImage" class="input" value="<%= settings.welcomeEmbedImage || "" %>" placeholder="https://..." />
              </label>
            </div>
          </section>

          <section class="section-card preview-panel">
            <div class="section-header">
              <h2>Welcome Preview</h2>
              <p>Preview how your welcome message will look.</p>
            </div>

            <div class="preview-normal" id="welcomePreviewNormal"></div>

            <div class="discord-preview" id="welcomeEmbedPreviewBox">
              <div class="discord-embed">
                <div class="discord-embed-border" id="welcomeEmbedBorder"></div>

                <div class="discord-embed-content">
                  <div class="discord-title" id="welcomePreviewTitle">Welcome Title</div>
                  <div class="discord-description" id="welcomePreviewDescription">Welcome description...</div>

                  <img id="welcomePreviewThumbnail" class="preview-thumbnail hidden" alt="Welcome Thumbnail" />
                  <img id="welcomePreviewImage" class="preview-image hidden" alt="Welcome Image" />

                  <div class="discord-footer" id="welcomePreviewFooter">Welcome footer</div>
                </div>
              </div>
            </div>

            <div class="empty-mini hidden" id="welcomeEmbedOffNote">
              Welcome embed is turned off. Only the normal welcome message will be sent.
            </div>
          </section>
        </div>

        <div class="builder-grid">
          <section class="section-card">
            <div class="section-header">
              <h2>Goodbye Settings</h2>
              <p>Message sent when a member leaves.</p>
            </div>

            <div class="form-stack">
              <label class="toggle-line">
                <input type="checkbox" name="goodbyeEnabled" <%= settings.goodbyeEnabled ? "checked" : "" %> />
                <span>Enable Goodbye Messages</span>
              </label>

              <label class="toggle-line">
                <input type="checkbox" name="goodbyeEmbedEnabled" id="goodbyeEmbedEnabled" <%= settings.goodbyeEmbedEnabled !== false ? "checked" : "" %> />
                <span>Send Goodbye Embed</span>
              </label>

              <label class="form-group">
                <span>Goodbye Channel</span>
                <select name="goodbyeChannelId" class="input">
                  <option value="">Select a channel</option>

                  <% channelGroups.forEach(group => { %>
                    <optgroup label="📁 <%= group.name %>">
                      <% group.channels.forEach(channel => { %>
                        <option value="<%= channel.id %>" <%= settings.goodbyeChannelId === channel.id ? "selected" : "" %>>
                          # <%= channel.name %>
                        </option>
                      <% }) %>
                    </optgroup>
                  <% }) %>
                </select>
              </label>

              <label class="form-group">
                <span>Goodbye Normal Message</span>
                <textarea name="goodbyeContent" id="goodbyeContent" class="input textarea"><%= settings.goodbyeContent || "" %></textarea>
              </label>

              <label class="form-group">
                <span>Goodbye Embed Title</span>
                <input name="goodbyeEmbedTitle" id="goodbyeEmbedTitle" class="input" value="<%= settings.goodbyeEmbedTitle || "" %>" />
              </label>

              <label class="form-group">
                <span>Goodbye Embed Description</span>
                <textarea name="goodbyeEmbedDescription" id="goodbyeEmbedDescription" class="input textarea"><%= settings.goodbyeEmbedDescription || "" %></textarea>
              </label>

              <div class="form-group">
                <span>Goodbye Embed Color</span>
                <div class="color-row">
                  <input type="color" id="goodbyeEmbedColorPicker" class="color-picker" value="<%= settings.goodbyeEmbedColor || '#ff6b6b' %>" />
                  <input name="goodbyeEmbedColor" id="goodbyeEmbedColor" class="input color-hex-input" value="<%= settings.goodbyeEmbedColor || '#ff6b6b' %>" />
                </div>
              </div>

              <label class="form-group">
                <span>Goodbye Footer</span>
                <input name="goodbyeEmbedFooter" id="goodbyeEmbedFooter" class="input" value="<%= settings.goodbyeEmbedFooter || "" %>" />
              </label>

              <label class="form-group">
                <span>Goodbye Thumbnail URL</span>
                <input name="goodbyeEmbedThumbnail" id="goodbyeEmbedThumbnail" class="input" value="<%= settings.goodbyeEmbedThumbnail || "" %>" placeholder="https://..." />
              </label>

              <label class="form-group">
                <span>Goodbye Image URL</span>
                <input name="goodbyeEmbedImage" id="goodbyeEmbedImage" class="input" value="<%= settings.goodbyeEmbedImage || "" %>" placeholder="https://..." />
              </label>
            </div>
          </section>

          <section class="section-card preview-panel">
            <div class="section-header">
              <h2>Goodbye Preview</h2>
              <p>Preview how your goodbye message will look.</p>
            </div>

            <div class="preview-normal" id="goodbyePreviewNormal"></div>

            <div class="discord-preview" id="goodbyeEmbedPreviewBox">
              <div class="discord-embed">
                <div class="discord-embed-border" id="goodbyeEmbedBorder"></div>

                <div class="discord-embed-content">
                  <div class="discord-title" id="goodbyePreviewTitle">Goodbye Title</div>
                  <div class="discord-description" id="goodbyePreviewDescription">Goodbye description...</div>

                  <img id="goodbyePreviewThumbnail" class="preview-thumbnail hidden" alt="Goodbye Thumbnail" />
                  <img id="goodbyePreviewImage" class="preview-image hidden" alt="Goodbye Image" />

                  <div class="discord-footer" id="goodbyePreviewFooter">Goodbye footer</div>
                </div>
              </div>
            </div>

            <div class="empty-mini hidden" id="goodbyeEmbedOffNote">
              Goodbye embed is turned off. Only the normal goodbye message will be sent.
            </div>
          </section>
        </div>

        <section class="section-card">
          <div class="section-header">
            <h2>Save Settings</h2>
            <p>Save welcome and goodbye configuration.</p>
          </div>

          <div class="template-save-box">
            <label class="toggle-line">
              <input type="checkbox" name="saveToTemplates" <%= settings.saveToTemplates ? "checked" : "" %> />
              <span>Also save these embed designs into Embed Templates</span>
            </label>
          </div>

          <div class="button-row preview-button-row">
            <button type="submit" class="primary-btn">Save Welcome & Goodbye Settings</button>
          </div>
        </section>
      </form>

      <section class="section-card">
        <div class="section-header">
          <h2>Test Messages</h2>
          <p>Send a test welcome or goodbye message using the saved settings.</p>
        </div>

        <div class="button-row preview-button-row">
          <form method="POST" action="/welcome-goodbye/test/welcome">
            <button type="submit" class="secondary-btn">Send Test Welcome</button>
          </form>

          <form method="POST" action="/welcome-goodbye/test/goodbye">
            <button type="submit" class="secondary-btn">Send Test Goodbye</button>
          </form>
        </div>
      </section>
    </main>
  </div>

  <script src="/dashboard.js"></script>

  <div
    id="welcomeGoodbyeData"
    class="hidden"
    data-server-name="<%= typeof guildName !== 'undefined' ? guildName : '' %>"
    data-member-count="<%= typeof guildMemberCount !== 'undefined' ? guildMemberCount : 0 %>"
  ></div>

  <script>
    const welcomeGoodbyeData = document.getElementById("welcomeGoodbyeData");
    const serverName = welcomeGoodbyeData ? welcomeGoodbyeData.dataset.serverName : "";
    const memberCount = welcomeGoodbyeData ? welcomeGoodbyeData.dataset.memberCount : "0";

    function validHex(value) {
      return /^#[0-9A-Fa-f]{6}$/.test(value);
    }

    function fillVars(text) {
      return String(text || "")
        .replaceAll("{user}", "@NewMember")
        .replaceAll("{username}", "NewMember")
        .replaceAll("{server}", serverName)
        .replaceAll("{memberCount}", memberCount);
    }

    function setupColorSync(hexInput, pickerInput, callback) {
      pickerInput.addEventListener("input", () => {
        hexInput.value = pickerInput.value;
        callback();
      });

      hexInput.addEventListener("input", () => {
        if (validHex(hexInput.value.trim())) {
          pickerInput.value = hexInput.value.trim();
        }
        callback();
      });
    }

    const welcomeEmbedEnabled = document.getElementById("welcomeEmbedEnabled");
    const welcomeEmbedPreviewBox = document.getElementById("welcomeEmbedPreviewBox");
    const welcomeEmbedOffNote = document.getElementById("welcomeEmbedOffNote");

    const welcomeContent = document.getElementById("welcomeContent");
    const welcomeEmbedTitle = document.getElementById("welcomeEmbedTitle");
    const welcomeEmbedDescription = document.getElementById("welcomeEmbedDescription");
    const welcomeEmbedColor = document.getElementById("welcomeEmbedColor");
    const welcomeEmbedColorPicker = document.getElementById("welcomeEmbedColorPicker");
    const welcomeEmbedFooter = document.getElementById("welcomeEmbedFooter");
    const welcomeEmbedThumbnail = document.getElementById("welcomeEmbedThumbnail");
    const welcomeEmbedImage = document.getElementById("welcomeEmbedImage");

    const welcomePreviewNormal = document.getElementById("welcomePreviewNormal");
    const welcomePreviewTitle = document.getElementById("welcomePreviewTitle");
    const welcomePreviewDescription = document.getElementById("welcomePreviewDescription");
    const welcomeEmbedBorder = document.getElementById("welcomeEmbedBorder");
    const welcomePreviewFooter = document.getElementById("welcomePreviewFooter");
    const welcomePreviewThumbnail = document.getElementById("welcomePreviewThumbnail");
    const welcomePreviewImage = document.getElementById("welcomePreviewImage");

    const goodbyeEmbedEnabled = document.getElementById("goodbyeEmbedEnabled");
    const goodbyeEmbedPreviewBox = document.getElementById("goodbyeEmbedPreviewBox");
    const goodbyeEmbedOffNote = document.getElementById("goodbyeEmbedOffNote");

    const goodbyeContent = document.getElementById("goodbyeContent");
    const goodbyeEmbedTitle = document.getElementById("goodbyeEmbedTitle");
    const goodbyeEmbedDescription = document.getElementById("goodbyeEmbedDescription");
    const goodbyeEmbedColor = document.getElementById("goodbyeEmbedColor");
    const goodbyeEmbedColorPicker = document.getElementById("goodbyeEmbedColorPicker");
    const goodbyeEmbedFooter = document.getElementById("goodbyeEmbedFooter");
    const goodbyeEmbedThumbnail = document.getElementById("goodbyeEmbedThumbnail");
    const goodbyeEmbedImage = document.getElementById("goodbyeEmbedImage");

    const goodbyePreviewNormal = document.getElementById("goodbyePreviewNormal");
    const goodbyePreviewTitle = document.getElementById("goodbyePreviewTitle");
    const goodbyePreviewDescription = document.getElementById("goodbyePreviewDescription");
    const goodbyeEmbedBorder = document.getElementById("goodbyeEmbedBorder");
    const goodbyePreviewFooter = document.getElementById("goodbyePreviewFooter");
    const goodbyePreviewThumbnail = document.getElementById("goodbyePreviewThumbnail");
    const goodbyePreviewImage = document.getElementById("goodbyePreviewImage");

    function updateImage(input, imageEl) {
      if (input.value.trim()) {
        imageEl.src = input.value.trim();
        imageEl.classList.remove("hidden");
      } else {
        imageEl.classList.add("hidden");
      }
    }

    function toggleEmbedPreview(enabledCheckbox, previewBox, noteBox) {
      if (enabledCheckbox.checked) {
        previewBox.classList.remove("hidden");
        noteBox.classList.add("hidden");
      } else {
        previewBox.classList.add("hidden");
        noteBox.classList.remove("hidden");
      }
    }

    function updateWelcomePreview() {
      welcomePreviewNormal.textContent = fillVars(welcomeContent.value);
      welcomePreviewTitle.textContent = fillVars(welcomeEmbedTitle.value || "Welcome Title");
      welcomePreviewDescription.textContent = fillVars(welcomeEmbedDescription.value || "Welcome description...");
      welcomePreviewFooter.textContent = fillVars(welcomeEmbedFooter.value || "Welcome footer");
      welcomeEmbedBorder.style.background = validHex(welcomeEmbedColor.value.trim())
        ? welcomeEmbedColor.value.trim()
        : "#8b5cf6";

      updateImage(welcomeEmbedThumbnail, welcomePreviewThumbnail);
      updateImage(welcomeEmbedImage, welcomePreviewImage);
      toggleEmbedPreview(welcomeEmbedEnabled, welcomeEmbedPreviewBox, welcomeEmbedOffNote);
    }

    function updateGoodbyePreview() {
      goodbyePreviewNormal.textContent = fillVars(goodbyeContent.value);
      goodbyePreviewTitle.textContent = fillVars(goodbyeEmbedTitle.value || "Goodbye Title");
      goodbyePreviewDescription.textContent = fillVars(goodbyeEmbedDescription.value || "Goodbye description...");
      goodbyePreviewFooter.textContent = fillVars(goodbyeEmbedFooter.value || "Goodbye footer");
      goodbyeEmbedBorder.style.background = validHex(goodbyeEmbedColor.value.trim())
        ? goodbyeEmbedColor.value.trim()
        : "#ff6b6b";

      updateImage(goodbyeEmbedThumbnail, goodbyePreviewThumbnail);
      updateImage(goodbyeEmbedImage, goodbyePreviewImage);
      toggleEmbedPreview(goodbyeEmbedEnabled, goodbyeEmbedPreviewBox, goodbyeEmbedOffNote);
    }

    setupColorSync(welcomeEmbedColor, welcomeEmbedColorPicker, updateWelcomePreview);
    setupColorSync(goodbyeEmbedColor, goodbyeEmbedColorPicker, updateGoodbyePreview);

    welcomeEmbedEnabled.addEventListener("change", updateWelcomePreview);
    goodbyeEmbedEnabled.addEventListener("change", updateGoodbyePreview);

    [
      welcomeContent,
      welcomeEmbedTitle,
      welcomeEmbedDescription,
      welcomeEmbedFooter,
      welcomeEmbedThumbnail,
      welcomeEmbedImage,
    ].forEach((el) => el.addEventListener("input", updateWelcomePreview));

    [
      goodbyeContent,
      goodbyeEmbedTitle,
      goodbyeEmbedDescription,
      goodbyeEmbedFooter,
      goodbyeEmbedThumbnail,
      goodbyeEmbedImage,
    ].forEach((el) => el.addEventListener("input", updateGoodbyePreview));

    updateWelcomePreview();
    updateGoodbyePreview();
  </script>
<script src="/assets/js/site-music.js"></script></body>
</html>
