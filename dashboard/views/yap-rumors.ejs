<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Yap & Rumors - Legendary Bot</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="stylesheet" href="/style.css" />
  <link rel="icon" type="image/png" href="/favicon.png?v=3.7.0" />
  <link rel="shortcut icon" type="image/png" href="/favicon.png?v=3.7.0" />
</head>
<body>
  <div class="app-shell">
    <%- include("partials/sidebar") %>

    <main class="main-content">
      <%- include("partials/topbar", {
        pageTitle: "Yap & Rumors",
        pageSubtitle: "Control yap loops, rumor loops, custom content, and fallbacks."
      }) %>

      <% if (success) { %>
        <div class="alert success"><%= success %></div>
      <% } %>

      <% if (error) { %>
        <div class="alert error"><%= error %></div>
      <% } %>

      <section class="hero-card">
        <div class="hero-text">
          <div class="hero-icon-wrap">
            <img src="<%= botAvatar %>" class="hero-bot-avatar" alt="Bot Avatar" />
          </div>
          <div>
            <h2>Yap & Rumors Control Center</h2>
            <p>
              Pause, resume, change timers, send instantly, and manage fallback/custom content
              directly from the dashboard.
            </p>
          </div>
        </div>
      </section>

      <form method="POST" action="/yap-rumors/save-loops">
        <div class="sports-grid">
          <section class="section-card sports-card">
            <div class="section-header">
              <h2>🗣️ Yap Loop</h2>
              <p>Control normal yap posts.</p>
            </div>

            <div class="form-stack">
              <label class="form-group">
                <span>Yap Channel</span>
                <select name="yapChannelId" class="input">
                  <option value="">Select yap channel</option>

                  <% channelGroups.forEach(group => { %>
                    <optgroup label="📁 <%= group.name %>">
                      <% group.channels.forEach(channel => { %>
                        <option value="<%= channel.id %>" <%= loopConfig?.yap?.channelId === channel.id ? "selected" : "" %>>
                          # <%= channel.name %>
                        </option>
                      <% }) %>
                    </optgroup>
                  <% }) %>
                </select>
              </label>

              <label class="form-group">
                <span>Yap Interval Minutes</span>
                <input
                  class="input"
                  type="number"
                  name="yapIntervalMinutes"
                  min="5"
                  value="<%= Math.round((loopConfig?.yap?.intervalMs || 1800000) / 60000) %>"
                />
              </label>

              <label class="toggle-line">
                <input type="checkbox" name="yapActive" <%= loopConfig?.yap?.active ? "checked" : "" %> />
                <span>Yap loop active</span>
              </label>

              <div class="loop-status-box">
                <div><strong>Last Source:</strong> <%= loopConfig?.yap?.lastSource || "none" %></div>
                <div><strong>Last Sent:</strong> <%= loopConfig?.yap?.lastSentAt ? new Date(loopConfig.yap.lastSentAt).toLocaleString() : "Never" %></div>
                <div><strong>Last Yap:</strong></div>
                <div class="text-box"><%= loopConfig?.yap?.lastMessage || "Nothing sent yet." %></div>
              </div>
            </div>
          </section>

          <section class="section-card sports-card">
            <div class="section-header">
              <h2>👀 Rumors Loop</h2>
              <p>Control rumor embed posts.</p>
            </div>

            <div class="form-stack">
              <label class="form-group">
                <span>Rumor Channel</span>
                <select name="rumorChannelId" class="input">
                  <option value="">Select rumor channel</option>

                  <% channelGroups.forEach(group => { %>
                    <optgroup label="📁 <%= group.name %>">
                      <% group.channels.forEach(channel => { %>
                        <option value="<%= channel.id %>" <%= loopConfig?.rumors?.channelId === channel.id ? "selected" : "" %>>
                          # <%= channel.name %>
                        </option>
                      <% }) %>
                    </optgroup>
                  <% }) %>
                </select>
              </label>

              <label class="form-group">
                <span>Rumor Interval Minutes</span>
                <input
                  class="input"
                  type="number"
                  name="rumorIntervalMinutes"
                  min="10"
                  value="<%= Math.round((loopConfig?.rumors?.intervalMs || 3600000) / 60000) %>"
                />
              </label>

              <label class="toggle-line">
                <input type="checkbox" name="rumorsActive" <%= loopConfig?.rumors?.active ? "checked" : "" %> />
                <span>Rumors loop active</span>
              </label>

              <div class="loop-status-box">
                <div><strong>Last Source:</strong> <%= loopConfig?.rumors?.lastSource || "none" %></div>
                <div><strong>Last Sent:</strong> <%= loopConfig?.rumors?.lastSentAt ? new Date(loopConfig.rumors.lastSentAt).toLocaleString() : "Never" %></div>
                <div><strong>Last Rumor:</strong></div>
                <div class="text-box"><%= loopConfig?.rumors?.lastMessage || "Nothing sent yet." %></div>
              </div>
            </div>
          </section>
        </div>

        <div class="sticky-save-bar">
          <button type="submit" class="primary-btn">Save Yap/Rumor Settings</button>
        </div>
      </form>

      <section class="section-card">
        <div class="section-header">
          <h2>Send Now</h2>
          <p>Instantly send one yap or one rumor using the current saved channel.</p>
        </div>

        <div class="sports-test-actions">
          <form method="POST" action="/yap-rumors/send-now/yap">
            <button class="mini-btn" type="submit">Send Yap Now</button>
          </form>

          <form method="POST" action="/yap-rumors/send-now/rumors">
            <button class="mini-btn" type="submit">Send Rumor Now</button>
          </form>
        </div>
      </section>

      <div class="builder-grid">
        <section class="section-card">
          <div class="section-header">
            <h2>Add Custom / Fallback Content</h2>
            <p>Add new yaps, rumors, custom posts, and fallback posts.</p>
          </div>

          <form method="POST" action="/yap-rumors/add-content" class="form-stack">
            <label class="form-group">
              <span>Type</span>
              <select name="type" class="input" required>
                <option value="yap">Yap</option>
                <option value="rumor">Rumor</option>
              </select>
            </label>

            <label class="form-group">
              <span>Source Type</span>
              <select name="sourceType" class="input" required>
                <option value="custom">Custom</option>
                <option value="fallback">Fallback</option>
              </select>
            </label>

            <label class="form-group">
              <span>Text</span>
              <textarea
                name="text"
                class="input textarea"
                placeholder="Write the yap or rumor text..."
                required
              ></textarea>
            </label>


            <button type="submit" class="primary-btn">Add Content</button>
          </form>
        </section>

        <section class="section-card">
          <div class="section-header">
            <h2>Saved Content</h2>
            <p>Toggle or delete dashboard-added custom/fallback content.</p>
          </div>

          <div class="table-list">
            <% if (!contents.length) { %>
              <div class="empty-mini">No custom or fallback content added from dashboard yet.</div>
            <% } %>

            <% contents.forEach(item => { %>
              <div class="table-row vertical-row">
                <div>
                  <div class="row-title">
                    <%= item.type === "yap" ? "🗣️ Yap" : "👀 Rumor" %>
                    •
                    <%= item.sourceType === "custom" ? "Custom" : "Fallback" %>
                  </div>

                  <div class="row-sub">
                    Status: <%= item.enabled ? "Enabled" : "Disabled" %>
                  </div>

                  <div class="row-preview"><%= item.text %></div>
                </div>

                <div class="action-row">
                  <span class="status-pill <%= item.enabled ? 'good' : 'bad' %>">
                    <%= item.enabled ? "Enabled" : "Disabled" %>
                  </span>

                  <form method="POST" action="/yap-rumors/toggle-content/<%= item._id %>">
                    <button class="mini-btn" type="submit"><%= item.enabled ? "Disable" : "Enable" %></button>
                  </form>

                  <form method="POST" action="/yap-rumors/delete-content/<%= item._id %>">
                    <button class="mini-btn danger" type="submit">Delete</button>
                  </form>
                </div>
              </div>
            <% }) %>
          </div>
        </section>
      </div>
    </main>
  </div>

  <script src="/dashboard.js"></script>
<script src="/assets/js/site-music.js"></script></body>
</html>
