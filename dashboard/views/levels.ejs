<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Levels - Legendary Bot</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="stylesheet" href="/style.css" />
  <link rel="icon" type="image/png" href="/favicon.png?v=8.5.0" />
  <link rel="shortcut icon" type="image/png" href="/favicon.png?v=8.5.0" />
</head>
<body>
  <div class="app-shell">
    <%- include("partials/sidebar") %>

    <main class="main-content levels-page">
      <%- include("partials/topbar", {
        pageTitle: "Levels",
        pageSubtitle: "Configure XP, rewards, ignored channels, no-XP roles, and multiplier roles."
      }) %>

      <% if (success) { %>
        <div class="alert success"><%= success %></div>
      <% } %>

      <% if (error) { %>
        <div class="alert error"><%= error %></div>
      <% } %>

      <section class="hero-card">
        <div class="hero-text">
          <div class="hero-icon-wrap">
            <img src="<%= botAvatar %>" class="hero-bot-avatar" alt="Bot Avatar" />
          </div>
          <div>
            <h2>Advanced Levels Dashboard</h2>
            <p>
              Control XP settings, level-up messages, reward roles, ignored channels,
              blocked XP roles, multiplier roles, and user XP from one clean page.
            </p>
          </div>
        </div>
      </section>

      <section class="section-card">
        <div class="section-header">
          <h2>Available Variables</h2>
          <p>Use these inside your level-up message and embed.</p>
        </div>

        <div class="template-save-box">
          <p><strong>{user}</strong> = mentions the member</p>
          <p><strong>{username}</strong> = member username</p>
          <p><strong>{server}</strong> = server name</p>
          <p><strong>{level}</strong> = new level number</p>
          <p><strong>{xp}</strong> = current XP amount</p>
        </div>
      </section>

      <section class="section-card">
        <div class="section-header">
          <h2>XP Management Tools</h2>
          <p>Use a user ID, mention, exact username, or server nickname.</p>
        </div>

        <div class="xp-tools-grid">
          <form method="POST" action="/levels/add-xp" class="xp-tool-card">
            <h3>Add XP</h3>

            <label class="form-group">
              <span>User</span>
              <input name="userInput" class="input" placeholder="@user / user ID / username" required />
            </label>

            <label class="form-group">
              <span>XP Amount</span>
              <input name="amount" type="number" min="1" class="input" placeholder="Example: 100" required />
            </label>

            <button type="submit" class="mini-btn">Add XP</button>
          </form>

          <form method="POST" action="/levels/remove-xp" class="xp-tool-card">
            <h3>Remove XP</h3>

            <label class="form-group">
              <span>User</span>
              <input name="userInput" class="input" placeholder="@user / user ID / username" required />
            </label>

            <label class="form-group">
              <span>XP Amount</span>
              <input name="amount" type="number" min="1" class="input" placeholder="Example: 50" required />
            </label>

            <button type="submit" class="mini-btn danger">Remove XP</button>
          </form>

          <form method="POST" action="/levels/set-xp" class="xp-tool-card">
            <h3>Set Exact XP</h3>

            <label class="form-group">
              <span>User</span>
              <input name="userInput" class="input" placeholder="@user / user ID / username" required />
            </label>

            <label class="form-group">
              <span>Exact XP</span>
              <input name="amount" type="number" min="0" class="input" placeholder="Example: 500" required />
            </label>

            <button type="submit" class="mini-btn">Set XP</button>
          </form>

          <form method="POST" action="/levels/set-level" class="xp-tool-card">
            <h3>Set Exact Level</h3>

            <label class="form-group">
              <span>User</span>
              <input name="userInput" class="input" placeholder="@user / user ID / username" required />
            </label>

            <label class="form-group">
              <span>Exact Level</span>
              <input name="level" type="number" min="0" class="input" placeholder="Example: 10" required />
            </label>

            <button type="submit" class="mini-btn">Set Level</button>
          </form>
        </div>
      </section>

      <form method="POST" action="/levels/save" id="levelsForm">
        <input type="hidden" name="rewardsJson" id="rewardsJson" value="<%= rewardsJson || '[]' %>" />
        <input type="hidden" name="ignoredChannelsJson" id="ignoredChannelsJson" value="<%= ignoredChannelsJson || '[]' %>" />
        <input type="hidden" name="noXpRolesJson" id="noXpRolesJson" value="<%= noXpRolesJson || '[]' %>" />
        <input type="hidden" name="multiplierRolesJson" id="multiplierRolesJson" value="<%= multiplierRolesJson || '[]' %>" />

        <div class="builder-grid">
          <section class="section-card">
            <div class="section-header">
              <h2>Leveling Settings</h2>
              <p>Turn leveling on and control XP gain rules.</p>
            </div>

            <div class="form-stack">
              <label class="toggle-line">
                <input type="checkbox" name="enabled" <%= config.enabled ? "checked" : "" %> />
                <span>Enable Leveling</span>
              </label>

              <label class="form-group">
                <span>Level-Up Announcement Channel</span>
                <select name="levelUpChannelId" class="input">
                  <option value="">Use same channel where user leveled up</option>

                  <% channelGroups.forEach(group => { %>
                    <optgroup label="📁 <%= group.name %>">
                      <% group.channels.forEach(channel => { %>
                        <option value="<%= channel.id %>" <%= config.levelUpChannelId === channel.id ? "selected" : "" %>>
                          # <%= channel.name %>
                        </option>
                      <% }) %>
                    </optgroup>
                  <% }) %>
                </select>
              </label>

              <div class="mini-grid">
                <label class="form-group">
                  <span>Minimum XP Per Message</span>
                  <input name="minXp" type="number" min="1" class="input" value="<%= config.minXp || 15 %>" />
                </label>

                <label class="form-group">
                  <span>Maximum XP Per Message</span>
                  <input name="maxXp" type="number" min="1" class="input" value="<%= config.maxXp || 25 %>" />
                </label>
              </div>

              <label class="form-group">
                <span>XP Cooldown Seconds</span>
                <input name="cooldownSeconds" type="number" min="5" class="input" value="<%= config.cooldownSeconds || 60 %>" />
              </label>

              <label class="toggle-line">
                <input type="checkbox" name="sendLevelUpMessage" <%= config.sendLevelUpMessage !== false ? "checked" : "" %> />
                <span>Send Level-Up Message</span>
              </label>

              <label class="form-group">
                <span>Normal Level-Up Message</span>
                <textarea name="levelUpContent" id="levelUpContent" class="input textarea" placeholder="🎉 GG {user}! You reached Level {level}!"><%= config.levelUpContent || "" %></textarea>
              </label>
            </div>
          </section>

          <section class="section-card preview-panel">
            <div class="section-header">
              <h2>Live Preview</h2>
              <p>Preview your level-up announcement.</p>
            </div>

            <div class="preview-normal" id="previewNormal"></div>

            <div class="discord-preview" id="embedPreviewBox">
              <div class="discord-embed">
                <div class="discord-embed-border" id="embedBorder"></div>

                <div class="discord-embed-content">
                  <div class="discord-title" id="previewTitle">🏆 Level Up!</div>
                  <div class="discord-description" id="previewDescription">
                    @Member has reached <strong>Level 5</strong>!
                  </div>

                  <img id="previewThumbnail" class="preview-thumbnail hidden" alt="Thumbnail" />
                  <img id="previewImage" class="preview-image hidden" alt="Image" />

                  <div class="discord-footer" id="previewFooter">Keep chatting to level up!</div>
                </div>
              </div>
            </div>

            <div class="empty-mini hidden" id="embedOffNote">
              Level-up embed is turned off. Only the normal message will be sent.
            </div>
          </section>
        </div>

        <div class="builder-grid">
          <section class="section-card">
            <div class="section-header">
              <h2>Level-Up Embed</h2>
              <p>Customize the embed sent when a member levels up.</p>
            </div>

            <div class="form-stack">
              <label class="toggle-line">
                <input type="checkbox" name="embedEnabled" id="embedEnabled" <%= config.embedEnabled !== false ? "checked" : "" %> />
                <span>Send Level-Up Embed</span>
              </label>

              <div id="embedFields">
                <label class="form-group">
                  <span>Embed Title</span>
                  <input name="embedTitle" id="embedTitle" class="input" value="<%= config.embedTitle || '🏆 Level Up!' %>" />
                </label>

                <label class="form-group">
                  <span>Embed Description</span>
                  <textarea name="embedDescription" id="embedDescription" class="input textarea"><%= config.embedDescription || '{user} has reached **Level {level}** in **{server}**!' %></textarea>
                </label>

                <div class="form-group">
                  <span>Embed Color</span>
                  <div class="color-row">
                    <input type="color" id="embedColorPicker" class="color-picker" value="<%= config.embedColor || '#8b5cf6' %>" />
                    <input name="embedColor" id="embedColor" class="input color-hex-input" value="<%= config.embedColor || '#8b5cf6' %>" />
                  </div>
                </div>

                <label class="form-group">
                  <span>Embed Footer</span>
                  <input name="embedFooter" id="embedFooter" class="input" value="<%= config.embedFooter || 'Keep chatting to level up!' %>" />
                </label>

                <label class="form-group">
                  <span>Embed Thumbnail URL</span>
                  <input name="embedThumbnail" id="embedThumbnail" class="input" value="<%= config.embedThumbnail || '' %>" placeholder="https://..." />
                </label>

                <label class="form-group">
                  <span>Embed Image URL</span>
                  <input name="embedImage" id="embedImage" class="input" value="<%= config.embedImage || '' %>" placeholder="https://..." />
                </label>
              </div>
            </div>
          </section>

          <section class="section-card">
            <div class="section-header">
              <h2>Reward Roles</h2>
              <p>Add roles members should receive when they reach a level.</p>
            </div>

            <section class="template-save-box">
              <div class="section-header compact-header">
                <h2>Reward Manager</h2>
                <p>Manage up to 25 reward roles.</p>
              </div>

              <div class="button-manager-top">
                <span class="status-pill good" id="rewardCounter">Reward 1 / 1</span>
                <span class="status-pill" id="rewardSavedStatus">Saved</span>
              </div>

              <label class="form-group">
                <span>Level</span>
                <input id="rewardLevel" type="number" min="1" class="input" placeholder="Example: 5" />
              </label>

              <label class="form-group">
                <span>Search Roles</span>
                <input id="rewardRoleSearch" class="input" placeholder="Type to search reward roles..." />
              </label>

              <label class="form-group">
                <span>Reward Role</span>
                <select id="rewardRoleId" class="input">
                  <option value="">No role</option>
                  <% roles.forEach(role => { %>
                    <option value="<%= role.id %>"><%= role.name %></option>
                  <% }) %>
                </select>
              </label>

              <div class="button-row">
                <button type="button" class="mini-btn" id="prevReward">Previous</button>
                <button type="button" class="mini-btn" id="nextReward">Next</button>
                <button type="button" class="mini-btn" id="addReward">Add</button>
                <button type="button" class="mini-btn danger" id="deleteReward">Delete</button>
              </div>

              <div class="rr-all-buttons" id="allRewardsList"></div>
            </section>
          </section>
        </div>

        <div class="builder-grid">
          <section class="section-card">
            <div class="section-header">
              <h2>Ignored XP Channels</h2>
              <p>Members will not gain XP in these channels.</p>
            </div>

            <section class="template-save-box">
              <div class="button-manager-top">
                <span class="status-pill good" id="ignoredChannelCounter">Channel 1 / 1</span>
                <span class="status-pill" id="ignoredChannelSavedStatus">Saved</span>
              </div>

              <label class="form-group">
                <span>Search Channels</span>
                <input id="ignoredChannelSearch" class="input" placeholder="Type to search channels..." />
              </label>

              <label class="form-group">
                <span>Ignored Channel</span>
                <select id="ignoredChannelId" class="input">
                  <option value="">No channel</option>
                  <% channelGroups.forEach(group => { %>
                    <optgroup label="📁 <%= group.name %>">
                      <% group.channels.forEach(channel => { %>
                        <option value="<%= channel.id %>"># <%= channel.name %></option>
                      <% }) %>
                    </optgroup>
                  <% }) %>
                </select>
              </label>

              <div class="button-row">
                <button type="button" class="mini-btn" id="prevIgnoredChannel">Previous</button>
                <button type="button" class="mini-btn" id="nextIgnoredChannel">Next</button>
                <button type="button" class="mini-btn" id="addIgnoredChannel">Add</button>
                <button type="button" class="mini-btn danger" id="deleteIgnoredChannel">Delete</button>
              </div>

              <div class="rr-all-buttons" id="allIgnoredChannelsList"></div>
            </section>
          </section>

          <section class="section-card">
            <div class="section-header">
              <h2>No-XP Roles</h2>
              <p>Members with these roles will not gain XP.</p>
            </div>

            <section class="template-save-box">
              <div class="button-manager-top">
                <span class="status-pill good" id="noXpRoleCounter">Role 1 / 1</span>
                <span class="status-pill" id="noXpRoleSavedStatus">Saved</span>
              </div>

              <label class="form-group">
                <span>Search Roles</span>
                <input id="noXpRoleSearch" class="input" placeholder="Type to search roles..." />
              </label>

              <label class="form-group">
                <span>No-XP Role</span>
                <select id="noXpRoleId" class="input">
                  <option value="">No role</option>
                  <% roles.forEach(role => { %>
                    <option value="<%= role.id %>"><%= role.name %></option>
                  <% }) %>
                </select>
              </label>

              <div class="button-row">
                <button type="button" class="mini-btn" id="prevNoXpRole">Previous</button>
                <button type="button" class="mini-btn" id="nextNoXpRole">Next</button>
                <button type="button" class="mini-btn" id="addNoXpRole">Add</button>
                <button type="button" class="mini-btn danger" id="deleteNoXpRole">Delete</button>
              </div>

              <div class="rr-all-buttons" id="allNoXpRolesList"></div>
            </section>
          </section>
        </div>

        <section class="section-card">
          <div class="section-header">
            <h2>XP Multiplier Roles</h2>
            <p>Members with these roles gain boosted XP. Highest multiplier is used.</p>
          </div>

          <section class="template-save-box">
            <div class="button-manager-top">
              <span class="status-pill good" id="multiplierRoleCounter">Multiplier 1 / 1</span>
              <span class="status-pill" id="multiplierRoleSavedStatus">Saved</span>
            </div>

            <label class="form-group">
              <span>Search Roles</span>
              <input id="multiplierRoleSearch" class="input" placeholder="Type to search multiplier roles..." />
            </label>

            <label class="form-group">
              <span>Multiplier Role</span>
              <select id="multiplierRoleId" class="input">
                <option value="">No role</option>
                <% roles.forEach(role => { %>
                  <option value="<%= role.id %>"><%= role.name %></option>
                <% }) %>
              </select>
            </label>

            <label class="form-group">
              <span>Multiplier</span>
              <input id="multiplierValue" type="number" min="1" max="10" step="0.1" class="input" placeholder="Example: 2" />
            </label>

            <div class="button-row">
              <button type="button" class="mini-btn" id="prevMultiplierRole">Previous</button>
              <button type="button" class="mini-btn" id="nextMultiplierRole">Next</button>
              <button type="button" class="mini-btn" id="addMultiplierRole">Add</button>
              <button type="button" class="mini-btn danger" id="deleteMultiplierRole">Delete</button>
            </div>

            <div class="rr-all-buttons" id="allMultiplierRolesList"></div>
          </section>
        </section>

        <section class="section-card">
          <div class="section-header">
            <h2>Save Levels</h2>
            <p>Save this server’s advanced leveling configuration.</p>
          </div>

          <div class="button-row preview-button-row">
            <button type="submit" class="primary-btn">Save Levels Settings</button>
          </div>
        </section>
      </form>

      <section class="section-card">
        <div class="section-header">
          <h2>Top Level Users</h2>
          <p>View saved XP data and manage users from the dashboard.</p>
        </div>

        <div class="levels-table-wrap">
          <% if (!topLevelUsers || !topLevelUsers.length) { %>
            <div class="empty-mini">No XP data yet. Members need to chat first.</div>
          <% } else { %>
            <table class="levels-table">
              <thead>
                <tr>
                  <th>Rank</th>
                  <th>User</th>
                  <th>Level</th>
                  <th>XP</th>
                  <th>Last XP</th>
                  <th>Action</th>
                </tr>
              </thead>

              <tbody>
                <% topLevelUsers.forEach((user, index) => { %>
                  <tr>
                    <td>
                      <% if (index === 0) { %>
                        🥇
                      <% } else if (index === 1) { %>
                        🥈
                      <% } else if (index === 2) { %>
                        🥉
                      <% } else { %>
                        #<%= index + 1 %>
                      <% } %>
                    </td>

                    <td>
                      <div class="levels-user-cell">
                        <span class="levels-user-mention">&lt;@<%= user.userId %>&gt;</span>
                        <span class="levels-username"><%= user.username || "Unknown User" %></span>
                      </div>
                    </td>

                    <td><strong><%= user.level || 0 %></strong></td>
                    <td><%= user.xp || 0 %></td>

                    <td>
                      <% if (user.lastXpAt) { %>
                        <%= new Date(user.lastXpAt).toLocaleString() %>
                      <% } else { %>
                        Never
                      <% } %>
                    </td>

                    <td>
                      <form method="POST" action="/levels/reset-user/<%= user.userId %>">
                        <button type="submit" class="mini-btn danger">Reset</button>
                      </form>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          <% } %>
        </div>

        <% if (topLevelUsers && topLevelUsers.length) { %>
          <div class="button-row preview-button-row">
            <form method="POST" action="/levels/reset-all">
              <button type="submit" class="secondary-btn danger-btn">Reset All XP</button>
            </form>
          </div>
        <% } %>
      </section>
    </main>
  </div>

  <script src="/dashboard.js"></script>

  
    <script type="application/json" id="ejs-data-dashboard-views-levels-ejs-0-roleOptions"><%- JSON.stringify(roles || []).replace(/</g, "\\u003c") %></script>
    <script type="application/json" id="ejs-data-dashboard-views-levels-ejs-1-channelGroupsData"><%- JSON.stringify(channelGroups || []).replace(/</g, "\\u003c") %></script>

    <script type="application/json" id="ejs-data-dashboard-views-levels-ejs-2-startingRewards"><%- JSON.stringify(config.rewards || []).replace(/</g, "\\u003c") %></script>
    <script type="application/json" id="ejs-data-dashboard-views-levels-ejs-3-startingIgnoredChannels"><%- JSON.stringify(config.ignoredChannels || []).replace(/</g, "\\u003c") %></script>
    <script type="application/json" id="ejs-data-dashboard-views-levels-ejs-4-startingNoXpRoles"><%- JSON.stringify(config.noXpRoles || []).replace(/</g, "\\u003c") %></script>
    <script type="application/json" id="ejs-data-dashboard-views-levels-ejs-5-startingMultiplierRoles"><%- JSON.stringify(config.multiplierRoles || []).replace(/</g, "\\u003c") %></script>

    <script type="application/json" id="ejs-data-dashboard-views-levels-ejs-6-serverName"><%- JSON.stringify(typeof guildName !== "undefined" ? guildName : "") %></script>

<script>
    const roleOptions = JSON.parse(document.getElementById("ejs-data-dashboard-views-levels-ejs-0-roleOptions").textContent || "null");
    const channelGroupsData = JSON.parse(document.getElementById("ejs-data-dashboard-views-levels-ejs-1-channelGroupsData").textContent || "null");
    const startingRewards = JSON.parse(document.getElementById("ejs-data-dashboard-views-levels-ejs-2-startingRewards").textContent || "null");
    const startingIgnoredChannels = JSON.parse(document.getElementById("ejs-data-dashboard-views-levels-ejs-3-startingIgnoredChannels").textContent || "null");
    const startingNoXpRoles = JSON.parse(document.getElementById("ejs-data-dashboard-views-levels-ejs-4-startingNoXpRoles").textContent || "null");
    const startingMultiplierRoles = JSON.parse(document.getElementById("ejs-data-dashboard-views-levels-ejs-5-startingMultiplierRoles").textContent || "null");
    const serverName = JSON.parse(document.getElementById("ejs-data-dashboard-views-levels-ejs-6-serverName").textContent || "null");
    const form = document.getElementById("levelsForm");

    const rewardsJson = document.getElementById("rewardsJson");
    const ignoredChannelsJson = document.getElementById("ignoredChannelsJson");
    const noXpRolesJson = document.getElementById("noXpRolesJson");
    const multiplierRolesJson = document.getElementById("multiplierRolesJson");

    const levelUpContent = document.getElementById("levelUpContent");

    const embedEnabled = document.getElementById("embedEnabled");
    const embedFields = document.getElementById("embedFields");
    const embedPreviewBox = document.getElementById("embedPreviewBox");
    const embedOffNote = document.getElementById("embedOffNote");

    const embedTitle = document.getElementById("embedTitle");
    const embedDescription = document.getElementById("embedDescription");
    const embedColor = document.getElementById("embedColor");
    const embedColorPicker = document.getElementById("embedColorPicker");
    const embedFooter = document.getElementById("embedFooter");
    const embedThumbnail = document.getElementById("embedThumbnail");
    const embedImage = document.getElementById("embedImage");

    const previewNormal = document.getElementById("previewNormal");
    const previewTitle = document.getElementById("previewTitle");
    const previewDescription = document.getElementById("previewDescription");
    const embedBorder = document.getElementById("embedBorder");
    const previewFooter = document.getElementById("previewFooter");
    const previewThumbnail = document.getElementById("previewThumbnail");
    const previewImage = document.getElementById("previewImage");

    function validHex(value) {
      return /^#[0-9A-Fa-f]{6}$/.test(value);
    }

    function fillVars(text) {
      return String(text || "")
        .replaceAll("{user}", "@Member")
        .replaceAll("{username}", "Member")
        .replaceAll("{server}", serverName)
        .replaceAll("{level}", "5")
        .replaceAll("{xp}", "420");
    }

    function getRoleName(roleId) {
      const role = roleOptions.find((item) => String(item.id) === String(roleId));
      return role?.name || "";
    }

    function getChannelName(channelId) {
      for (const group of channelGroupsData) {
        const found = (group.channels || []).find((channel) => String(channel.id) === String(channelId));
        if (found) return found.name;
      }

      return "";
    }

    function updateImage(input, imageEl) {
      if (input.value.trim()) {
        imageEl.src = input.value.trim();
        imageEl.classList.remove("hidden");
      } else {
        imageEl.classList.add("hidden");
      }
    }

    function updatePreview() {
      previewNormal.textContent = fillVars(levelUpContent.value || "");

      if (embedEnabled.checked) {
        embedFields.classList.remove("hidden");
        embedPreviewBox.classList.remove("hidden");
        embedOffNote.classList.add("hidden");
      } else {
        embedFields.classList.add("hidden");
        embedPreviewBox.classList.add("hidden");
        embedOffNote.classList.remove("hidden");
      }

      previewTitle.textContent = fillVars(embedTitle.value || "🏆 Level Up!");
      previewDescription.textContent = fillVars(embedDescription.value || "{user} has reached Level {level}!");
      previewFooter.textContent = fillVars(embedFooter.value || "Keep chatting to level up!");
      embedBorder.style.background = validHex(embedColor.value.trim()) ? embedColor.value.trim() : "#8b5cf6";

      updateImage(embedThumbnail, previewThumbnail);
      updateImage(embedImage, previewImage);
    }

    function filterSelectOptions(selectEl, type, query, currentValue) {
      selectEl.innerHTML = "";

      const empty = document.createElement("option");
      empty.value = "";
      empty.textContent = type === "channel" ? "No channel" : "No role";
      selectEl.appendChild(empty);

      const lowered = query.toLowerCase().trim();

      if (type === "channel") {
        channelGroupsData.forEach((group) => {
          const options = (group.channels || []).filter((channel) => {
            return !lowered || channel.name.toLowerCase().includes(lowered);
          });

          if (!options.length) return;

          const optgroup = document.createElement("optgroup");
          optgroup.label = `📁 ${group.name}`;

          options.forEach((channel) => {
            const option = document.createElement("option");
            option.value = channel.id;
            option.textContent = `# ${channel.name}`;
            optgroup.appendChild(option);
          });

          selectEl.appendChild(optgroup);
        });
      } else {
        roleOptions
          .filter((role) => !lowered || role.name.toLowerCase().includes(lowered))
          .forEach((role) => {
            const option = document.createElement("option");
            option.value = role.id;
            option.textContent = role.name;
            selectEl.appendChild(option);
          });
      }

      if ([...selectEl.querySelectorAll("option")].some((opt) => opt.value === currentValue)) {
        selectEl.value = currentValue;
      }
    }

    function createSingleSelectManager(config) {
      let items = Array.isArray(config.startingItems) && config.startingItems.length
        ? config.startingItems.map(config.normalize)
        : [config.emptyItem()];

      let currentIndex = 0;

      function saveCurrent() {
        items[currentIndex] = config.read();
        config.hidden.value = JSON.stringify(items.filter(config.isValid));
        config.savedStatus.textContent = "Saved";
        config.savedStatus.classList.add("good");
        renderList();
      }

      function loadCurrent() {
        const item = items[currentIndex] || config.emptyItem();
        config.write(item);
        config.counter.textContent = `${config.counterLabel} ${currentIndex + 1} / ${items.length}`;
        config.savedStatus.textContent = "Saved";
        config.savedStatus.classList.add("good");
        renderList();
      }

      function renderList() {
        config.list.innerHTML = "";

        items.forEach((item, index) => {
          const label = config.label(item, index);

          const btn = document.createElement("button");
          btn.type = "button";
          btn.className = `rr-button-index ${index === currentIndex ? "active" : ""}`;
          btn.textContent = label;

          btn.addEventListener("click", () => {
            saveCurrent();
            currentIndex = index;
            loadCurrent();
          });

          config.list.appendChild(btn);
        });

        config.hidden.value = JSON.stringify(items.filter(config.isValid));
      }

      config.inputs.forEach((input) => {
        input.addEventListener("input", () => {
          config.savedStatus.textContent = "Unsaved";
          config.savedStatus.classList.remove("good");
          saveCurrent();
        });

        input.addEventListener("change", () => {
          config.savedStatus.textContent = "Unsaved";
          config.savedStatus.classList.remove("good");
          saveCurrent();
        });
      });

      config.prev.addEventListener("click", () => {
        saveCurrent();
        currentIndex = Math.max(0, currentIndex - 1);
        loadCurrent();
      });

      config.next.addEventListener("click", () => {
        saveCurrent();
        currentIndex = Math.min(items.length - 1, currentIndex + 1);
        loadCurrent();
      });

      config.add.addEventListener("click", () => {
        saveCurrent();

        if (items.length >= config.max) {
          alert(`Maximum ${config.max} items.`);
          return;
        }

        items.push(config.emptyItem());
        currentIndex = items.length - 1;

        if (config.searchInput) config.searchInput.value = "";
        if (config.onSearch) config.onSearch();

        loadCurrent();
      });

      config.delete.addEventListener("click", () => {
        if (items.length <= 1) {
          items[0] = config.emptyItem();
          currentIndex = 0;
          loadCurrent();
          return;
        }

        items.splice(currentIndex, 1);
        currentIndex = Math.max(0, currentIndex - 1);
        loadCurrent();
      });

      if (config.searchInput && config.onSearch) {
        config.searchInput.addEventListener("input", config.onSearch);
      }

      loadCurrent();

      return {
        saveCurrent,
      };
    }

    embedColorPicker.addEventListener("input", () => {
      embedColor.value = embedColorPicker.value;
      updatePreview();
    });

    embedColor.addEventListener("input", () => {
      if (validHex(embedColor.value.trim())) {
        embedColorPicker.value = embedColor.value.trim();
      }

      updatePreview();
    });

    [
      levelUpContent,
      embedEnabled,
      embedTitle,
      embedDescription,
      embedFooter,
      embedThumbnail,
      embedImage,
    ].forEach((el) => {
      el.addEventListener("input", updatePreview);
      el.addEventListener("change", updatePreview);
    });

    const rewardManager = createSingleSelectManager({
      counterLabel: "Reward",
      max: 25,
      hidden: rewardsJson,
      startingItems: startingRewards,
      counter: document.getElementById("rewardCounter"),
      savedStatus: document.getElementById("rewardSavedStatus"),
      list: document.getElementById("allRewardsList"),
      prev: document.getElementById("prevReward"),
      next: document.getElementById("nextReward"),
      add: document.getElementById("addReward"),
      delete: document.getElementById("deleteReward"),
      inputs: [document.getElementById("rewardLevel"), document.getElementById("rewardRoleId")],
      searchInput: document.getElementById("rewardRoleSearch"),
      emptyItem: () => ({ level: "", roleId: "" }),
      normalize: (item) => ({ level: item.level || "", roleId: item.roleId || "" }),
      read: () => ({
        level: document.getElementById("rewardLevel").value,
        roleId: document.getElementById("rewardRoleId").value,
      }),
      write: (item) => {
        document.getElementById("rewardLevel").value = item.level || "";
        document.getElementById("rewardRoleId").value = item.roleId || "";
      },
      isValid: (item) => item.level && item.roleId,
      label: (item, index) => {
        const roleName = getRoleName(item.roleId);
        return item.level && roleName ? `Level ${item.level} → ${roleName}` : `Reward ${index + 1}: incomplete`;
      },
      onSearch: () => {
        const select = document.getElementById("rewardRoleId");
        filterSelectOptions(select, "role", document.getElementById("rewardRoleSearch").value, select.value);
      },
    });

    const ignoredChannelManager = createSingleSelectManager({
      counterLabel: "Channel",
      max: 50,
      hidden: ignoredChannelsJson,
      startingItems: startingIgnoredChannels,
      counter: document.getElementById("ignoredChannelCounter"),
      savedStatus: document.getElementById("ignoredChannelSavedStatus"),
      list: document.getElementById("allIgnoredChannelsList"),
      prev: document.getElementById("prevIgnoredChannel"),
      next: document.getElementById("nextIgnoredChannel"),
      add: document.getElementById("addIgnoredChannel"),
      delete: document.getElementById("deleteIgnoredChannel"),
      inputs: [document.getElementById("ignoredChannelId")],
      searchInput: document.getElementById("ignoredChannelSearch"),
      emptyItem: () => ({ channelId: "" }),
      normalize: (item) => ({ channelId: item.channelId || "" }),
      read: () => ({ channelId: document.getElementById("ignoredChannelId").value }),
      write: (item) => {
        document.getElementById("ignoredChannelId").value = item.channelId || "";
      },
      isValid: (item) => item.channelId,
      label: (item, index) => {
        const name = getChannelName(item.channelId);
        return name ? `#${name}` : `Channel ${index + 1}: incomplete`;
      },
      onSearch: () => {
        const select = document.getElementById("ignoredChannelId");
        filterSelectOptions(select, "channel", document.getElementById("ignoredChannelSearch").value, select.value);
      },
    });

    const noXpRoleManager = createSingleSelectManager({
      counterLabel: "Role",
      max: 50,
      hidden: noXpRolesJson,
      startingItems: startingNoXpRoles,
      counter: document.getElementById("noXpRoleCounter"),
      savedStatus: document.getElementById("noXpRoleSavedStatus"),
      list: document.getElementById("allNoXpRolesList"),
      prev: document.getElementById("prevNoXpRole"),
      next: document.getElementById("nextNoXpRole"),
      add: document.getElementById("addNoXpRole"),
      delete: document.getElementById("deleteNoXpRole"),
      inputs: [document.getElementById("noXpRoleId")],
      searchInput: document.getElementById("noXpRoleSearch"),
      emptyItem: () => ({ roleId: "" }),
      normalize: (item) => ({ roleId: item.roleId || "" }),
      read: () => ({ roleId: document.getElementById("noXpRoleId").value }),
      write: (item) => {
        document.getElementById("noXpRoleId").value = item.roleId || "";
      },
      isValid: (item) => item.roleId,
      label: (item, index) => {
        const name = getRoleName(item.roleId);
        return name ? name : `Role ${index + 1}: incomplete`;
      },
      onSearch: () => {
        const select = document.getElementById("noXpRoleId");
        filterSelectOptions(select, "role", document.getElementById("noXpRoleSearch").value, select.value);
      },
    });

    const multiplierRoleManager = createSingleSelectManager({
      counterLabel: "Multiplier",
      max: 25,
      hidden: multiplierRolesJson,
      startingItems: startingMultiplierRoles,
      counter: document.getElementById("multiplierRoleCounter"),
      savedStatus: document.getElementById("multiplierRoleSavedStatus"),
      list: document.getElementById("allMultiplierRolesList"),
      prev: document.getElementById("prevMultiplierRole"),
      next: document.getElementById("nextMultiplierRole"),
      add: document.getElementById("addMultiplierRole"),
      delete: document.getElementById("deleteMultiplierRole"),
      inputs: [document.getElementById("multiplierRoleId"), document.getElementById("multiplierValue")],
      searchInput: document.getElementById("multiplierRoleSearch"),
      emptyItem: () => ({ roleId: "", multiplier: "" }),
      normalize: (item) => ({ roleId: item.roleId || "", multiplier: item.multiplier || "" }),
      read: () => ({
        roleId: document.getElementById("multiplierRoleId").value,
        multiplier: document.getElementById("multiplierValue").value,
      }),
      write: (item) => {
        document.getElementById("multiplierRoleId").value = item.roleId || "";
        document.getElementById("multiplierValue").value = item.multiplier || "";
      },
      isValid: (item) => item.roleId && item.multiplier,
      label: (item, index) => {
        const name = getRoleName(item.roleId);
        return name && item.multiplier ? `${name} → ${item.multiplier}x XP` : `Multiplier ${index + 1}: incomplete`;
      },
      onSearch: () => {
        const select = document.getElementById("multiplierRoleId");
        filterSelectOptions(select, "role", document.getElementById("multiplierRoleSearch").value, select.value);
      },
    });

    form.addEventListener("submit", () => {
      rewardManager.saveCurrent();
      ignoredChannelManager.saveCurrent();
      noXpRoleManager.saveCurrent();
      multiplierRoleManager.saveCurrent();
    });

    updatePreview();
  </script>
