  <div class="lc-popout" id="lcProfilePopout"></div>

  <div class="lc-context-menu" id="lcContextMenu">
    <button data-context-action="profile">View Profile</button>
    <button data-context-action="dm">DM as Bot</button>
    <button data-context-action="timeout">Timeout 10 min</button>
    <button data-context-action="addRole">Add Selected Role</button>
    <button data-context-action="removeRole">Remove Selected Role</button>
    <button class="danger" data-context-action="kick">Kick</button>
    <button class="danger" data-context-action="ban">Ban</button>
  </div>

  <div class="lc-toast" id="lcToast"></div>

  <script type="application/json" id="ejs-data-dashboard-views-command-center-ejs-999-legendary-cc"><%- JSON.stringify({ routeBase: routeBase || "", guildId: guildId || "", botName: botName || "Legendary Bot" }).replace(/</g, "\u003c") %></script>

  <script>
    window.LEGENDARY_CC = JSON.parse(document.getElementById("ejs-data-dashboard-views-command-center-ejs-999-legendary-cc").textContent || "{}");
  </script>

  <script>
    (() => {
      const slashCommands = [
        { name: "/weather", icon: "🌦️", usage: "/weather Dubai", desc: "Post weather request in public chat" },
        { name: "/say", icon: "💬", usage: "/say hello everyone", desc: "Send a clean bot message" },
        { name: "/ping", icon: "🏓", usage: "/ping", desc: "Show bot online status" },
        { name: "/help", icon: "⚡", usage: "/help", desc: "Show Command Center commands" },
      ];

      const state = {
        channelGroups: [],
        roles: [],
        commands: [],
        memberGroups: [],
        flatMembers: [],
        selectedChannel: null,
        selectedMember: null,
        contextMember: null,
        messages: new Map(),
        newestId: "",
        oldestId: "",
        liveTimer: null,
        replyToMessageId: "",
        loading: false,
      };

      const el = (id) => document.getElementById(id);
      const channelList = el("lcChannelList");
      const channelSearch = el("lcChannelSearch");
      const messagesEl = el("lcMessages");
      const input = el("lcMessageInput");
      const sendBtn = el("lcSendBtn");
      const refreshBtn = el("lcRefreshBtn");
      const backBtn = el("lcBackBtn");
      const titleEl = el("lcChannelTitle");
      const topicEl = el("lcChannelTopic");
      const replyBox = el("lcReplyBox");
      const replyText = el("lcReplyText");
      const cancelReply = el("lcCancelReply");
      const toast = el("lcToast");
      const memberSearch = el("lcMemberSearch");
      const memberResults = el("lcMemberResults");
      const selectedMemberText = el("lcSelectedMemberText");
      const dmText = el("lcDmText");
      const sendDmBtn = el("lcSendDmBtn");
      const reasonInput = el("lcReason");
      const roleSelect = el("lcRoleSelect");
      const voiceStatus = el("lcVoiceStatus");
      const newCategoryName = el("lcNewCategoryName");
      const createCategoryBtn = el("lcCreateCategoryBtn");
      const newChannelName = el("lcNewChannelName");
      const newChannelParent = el("lcNewChannelParent");
      const newChannelType = el("lcNewChannelType");
      const createChannelBtn = el("lcCreateChannelBtn");
      const newRoleName = el("lcNewRoleName");
      const newRoleColor = el("lcNewRoleColor");
      const createRoleBtn = el("lcCreateRoleBtn");
      const toolsDrawer = el("lcToolsDrawer");
      const openTools = el("lcOpenTools");
      const openToolsTop = el("lcOpenToolsTop");
      const closeTools = el("lcCloseTools");
      const profilePopout = el("lcProfilePopout");
      const contextMenu = el("lcContextMenu");
      const slashMenu = el("lcSlashMenu");
      const mentionMenu = el("lcMentionMenu");
      const refreshMembers = el("lcRefreshMembers");
      const serverMenuBtn = el("lcServerMenuBtn");
      const serverMenuPanel = el("lcServerMenuPanel");
      const menuCreateChannel = el("lcMenuCreateChannel");
      const menuCreateCategory = el("lcMenuCreateCategory");
      const menuCreateRole = el("lcMenuCreateRole");
      const menuServerSettings = el("lcMenuServerSettings");

      function showToast(message, type = "success") {
        toast.textContent = message;
        toast.className = `lc-toast show ${type}`;
        setTimeout(() => toast.classList.remove("show"), 3800);
      }

      function escapeHtml(value) {
        return String(value ?? "")
          .replaceAll("&", "&amp;")
          .replaceAll("<", "&lt;")
          .replaceAll(">", "&gt;")
          .replaceAll('"', "&quot;")
          .replaceAll("'", "&#039;");
      }

      function formatTime(timestamp) {
        try { return new Date(timestamp).toLocaleString(); } catch { return ""; }
      }

      async function api(path, options = {}) {
        const response = await fetch(path, {
          credentials: "same-origin",
          headers: {
            "Accept": "application/json",
            ...(options.body ? { "Content-Type": "application/json" } : {}),
            ...(options.headers || {}),
          },
          ...options,
        });
        const data = await response.json().catch(() => ({ ok: false, message: "Invalid server response" }));
        if (!response.ok || data.ok === false) throw new Error(data.message || "Request failed");
        return data;
      }

      function visibleChannel(channel) {
        const q = channelSearch.value.trim().toLowerCase();
        if (!q) return true;
        return channel.name.toLowerCase().includes(q);
      }

      function renderChannels() {
        channelList.innerHTML = "";
        for (const group of state.channelGroups) {
          const filtered = (group.channels || []).filter(visibleChannel);
          if (!filtered.length && channelSearch.value.trim()) continue;

          const cat = document.createElement("div");
          cat.className = "lc-category";
          cat.innerHTML = `<span>${escapeHtml(group.name)}</span><span>${filtered.length}</span>`;
          channelList.appendChild(cat);

          if (!filtered.length) {
            const empty = document.createElement("div");
            empty.className = "lc-channel";
            empty.style.opacity = ".45";
            empty.textContent = "— empty —";
            channelList.appendChild(empty);
            continue;
          }

          for (const channel of filtered) {
            const btn = document.createElement("button");
            btn.type = "button";
            btn.className = "lc-channel";
            btn.dataset.channelId = channel.id;
            btn.innerHTML = `<span>#</span><span>${escapeHtml(channel.name)}</span>`;
            btn.addEventListener("click", () => selectChannel(channel));
            channelList.appendChild(btn);
          }
        }
        setActiveChannelButton();
        renderCategoryOptions();
      }

      function setActiveChannelButton() {
        document.querySelectorAll(".lc-channel").forEach((btn) => {
          btn.classList.toggle("active", btn.dataset.channelId === state.selectedChannel?.id);
        });
      }

      function renderRoles() {
        roleSelect.innerHTML = `<option value="">Select role...</option>` + state.roles.map((role) => (
          `<option value="${escapeHtml(role.id)}">${escapeHtml(role.name)}</option>`
        )).join("");
      }

      function renderCategoryOptions() {
        const categories = state.channelGroups.filter((group) => group.id !== "no-category");
        newChannelParent.innerHTML = `<option value="">No category</option>` + categories.map((group) => (
          `<option value="${escapeHtml(group.id)}">${escapeHtml(group.name)}</option>`
        )).join("");
      }

      function getCurrentToken() {
        const beforeCursor = input.value.slice(0, input.selectionStart || input.value.length);
        const match = beforeCursor.match(/(^|\s)([@#\/][^\s]*)$/);
        if (!match) return null;
        return {
          token: match[2],
          start: beforeCursor.length - match[2].length,
          end: input.selectionStart || input.value.length,
        };
      }

      function replaceCurrentToken(value) {
        const token = getCurrentToken();
        if (!token) return;
        input.value = input.value.slice(0, token.start) + value + " " + input.value.slice(token.end);
        const pos = token.start + value.length + 1;
        input.setSelectionRange(pos, pos);
        input.focus();
      }

      function renderSlashMenu() {
        const token = getCurrentToken();
        if (!token || !token.token.startsWith("/")) {
          slashMenu.classList.remove("show");
          return;
        }

        const query = token.token.toLowerCase();
        const dynamicCommands = (state.commands || []).map((cmd) => ({
          name: `/${cmd.name}`,
          icon: "⚡",
          usage: `/${cmd.name}`,
          desc: cmd.description || "Legendary Bot command",
        }));

        const builtIns = slashCommands;
        const merged = [...builtIns, ...dynamicCommands].filter((cmd, index, arr) =>
          arr.findIndex((item) => item.name === cmd.name) === index
        );

        const list = merged.filter((cmd) => cmd.name.toLowerCase().includes(query)).slice(0, 25);

        slashMenu.innerHTML = list.map((cmd) => `
          <div class="lc-command-item" data-command="${escapeHtml(cmd.usage)}">
            <div class="lc-command-icon">${escapeHtml(cmd.icon || "⚡")}</div>
            <div>
              <div class="lc-command-name">${escapeHtml(cmd.name)}</div>
              <div class="lc-command-desc">${escapeHtml(cmd.desc || "Legendary Bot command")} • ${escapeHtml(cmd.usage)}</div>
            </div>
          </div>
        `).join("");

        slashMenu.querySelectorAll(".lc-command-item").forEach((item) => {
          item.addEventListener("click", () => {
            replaceCurrentToken(item.dataset.command || "");
            slashMenu.classList.remove("show");
            input.focus();
          });
        });

        slashMenu.classList.toggle("show", Boolean(list.length));
      }

      function renderMentionMenu() {
        const token = getCurrentToken();
        if (!token || (!token.token.startsWith("@") && !token.token.startsWith("#"))) {
          mentionMenu.classList.remove("show");
          return;
        }

        const query = token.token.slice(1).toLowerCase();
        let html = "";

        if (token.token.startsWith("@")) {
          const members = (state.flatMembers || [])
            .filter((member) =>
              !query ||
              String(member.displayName || "").toLowerCase().includes(query) ||
              String(member.username || "").toLowerCase().includes(query) ||
              String(member.id || "").includes(query)
            )
            .slice(0, 15);

          const roles = (state.roles || [])
            .filter((role) => !query || String(role.name || "").toLowerCase().includes(query))
            .slice(0, 10);

          html += members.map((member) => `
            <div class="lc-mention-item" data-insert="<@${escapeHtml(member.id)}>" data-kind="member">
              <div class="lc-mention-avatar">${member.avatar ? `<img src="${escapeHtml(member.avatar)}" alt="avatar"/>` : escapeHtml((member.displayName || "?").slice(0,1))}</div>
              <div>
                <div class="lc-command-name" style="color:${escapeHtml(member.color || "#fff")}">${escapeHtml(member.displayName || member.username)}</div>
                <div class="lc-command-desc">Member</div>
              </div>
              <span>@</span>
            </div>
          `).join("");

          html += roles.map((role) => `
            <div class="lc-mention-item" data-insert="<@&${escapeHtml(role.id)}>" data-kind="role">
              <div class="lc-mention-avatar" style="color:${escapeHtml(role.color || "#99aab5")}">●</div>
              <div>
                <div class="lc-command-name" style="color:${escapeHtml(role.color || "#fff")}">${escapeHtml(role.name)}</div>
                <div class="lc-command-desc">Role</div>
              </div>
              <span>@</span>
            </div>
          `).join("");
        }

        if (token.token.startsWith("#")) {
          const channels = state.channelGroups
            .flatMap((group) => group.channels || [])
            .filter((channel) => !query || String(channel.name || "").toLowerCase().includes(query))
            .slice(0, 20);

          html += channels.map((channel) => `
            <div class="lc-mention-item" data-insert="<#${escapeHtml(channel.id)}>" data-kind="channel">
              <div class="lc-mention-avatar">#</div>
              <div>
                <div class="lc-command-name">${escapeHtml(channel.name)}</div>
                <div class="lc-command-desc">Channel</div>
              </div>
              <span>#</span>
            </div>
          `).join("");
        }

        mentionMenu.innerHTML = html || `<div class="lc-command-desc" style="padding:10px;">No results found.</div>`;

        mentionMenu.querySelectorAll(".lc-mention-item").forEach((item) => {
          item.addEventListener("click", () => {
            replaceCurrentToken(item.dataset.insert || "");
            mentionMenu.classList.remove("show");
            input.focus();
          });
        });

        mentionMenu.classList.add("show");
      }

      function memberFromMessageAuthor(message) {
        const author = message.author || {};
        return {
          id: author.id || "",
          displayName: author.username || "Unknown",
          username: author.username || "Unknown",
          avatar: author.avatar || "",
          roles: [],
          bot: Boolean(author.bot),
        };
      }

      function messageHtml(message) {
        const author = message.author || {};
        const avatar = author.avatar ? `<img src="${escapeHtml(author.avatar)}" alt="avatar"/>` : escapeHtml((author.username || "?").slice(0,1).toUpperCase());
        const attachments = (message.attachments || []).length
          ? `<div class="lc-attachments">${message.attachments.map(a => `<a class="lc-attachment" href="${escapeHtml(a.url)}" target="_blank" rel="noreferrer">${escapeHtml(a.name || "Attachment")}</a>`).join("")}</div>`
          : "";
        const content = message.cleanContent || message.content || (attachments ? "" : "[no text content]");

        return `
          <article class="lc-message" data-message-id="${escapeHtml(message.id)}" data-author-id="${escapeHtml(author.id || "")}" data-author-name="${escapeHtml(author.username || "Unknown")}" data-author-avatar="${escapeHtml(author.avatar || "")}">
            <div class="lc-avatar lc-author-open">${avatar}</div>
            <div>
              <div class="lc-msg-top">
                <span class="lc-author lc-author-open">${escapeHtml(author.username || "Unknown")}</span>
                ${author.bot ? `<span class="lc-bot">BOT</span>` : ""}
                <span class="lc-time">${escapeHtml(formatTime(message.createdTimestamp))}</span>
              </div>
              <div class="lc-content">${escapeHtml(content)}</div>
              ${attachments}
              <div class="lc-msg-buttons">
                <button class="lc-btn lc-reply-btn" type="button" data-message-id="${escapeHtml(message.id)}" data-author="${escapeHtml(author.username || "Unknown")}">Reply</button>
                <button class="lc-btn lc-delete-btn" type="button" data-message-id="${escapeHtml(message.id)}">Delete</button>
              </div>
            </div>
          </article>`;
      }

      function mergeMessages(messages) {
        for (const message of messages || []) state.messages.set(message.id, message);
        const sorted = [...state.messages.values()].sort((a, b) => a.createdTimestamp - b.createdTimestamp);
        state.oldestId = sorted[0]?.id || "";
        state.newestId = sorted[sorted.length - 1]?.id || "";
      }

      function renderMessages({ keepScroll = false } = {}) {
        const beforeHeight = messagesEl.scrollHeight;
        const beforeScroll = messagesEl.scrollTop;
        const messages = [...state.messages.values()].sort((a, b) => a.createdTimestamp - b.createdTimestamp);

        if (!state.selectedChannel) {
          messagesEl.innerHTML = `<div class="lc-empty"><h2>Legendary Command Center</h2><p>Pick a channel from the left.</p></div>`;
          return;
        }

        messagesEl.innerHTML = `
          <button class="lc-load-older" id="lcLoadOlderBtn" type="button">Load older messages</button>
          ${messages.length ? messages.map(messageHtml).join("") : `<div class="lc-empty"><h2>#${escapeHtml(state.selectedChannel.name)}</h2><p>No messages found yet, or the bot cannot read message history.</p></div>`}
        `;

        el("lcLoadOlderBtn")?.addEventListener("click", loadOlderMessages);
        messagesEl.querySelectorAll(".lc-reply-btn").forEach((btn) => {
          btn.addEventListener("click", () => {
            state.replyToMessageId = btn.dataset.messageId || "";
            replyText.textContent = `Replying to ${btn.dataset.author || "message"}`;
            replyBox.classList.add("show");
            input.focus();
          });
        });
        messagesEl.querySelectorAll(".lc-delete-btn").forEach((btn) => {
          btn.addEventListener("click", () => deleteMessage(btn.dataset.messageId || ""));
        });
        messagesEl.querySelectorAll(".lc-message").forEach((row) => {
          row.addEventListener("contextmenu", (event) => {
            event.preventDefault();
            const member = {
              id: row.dataset.authorId,
              displayName: row.dataset.authorName,
              username: row.dataset.authorName,
              avatar: row.dataset.authorAvatar,
              roles: [],
            };
            openContextMenu(event.clientX, event.clientY, member);
          });
          row.querySelectorAll(".lc-author-open").forEach((item) => {
            item.addEventListener("click", () => {
              const member = {
                id: row.dataset.authorId,
                displayName: row.dataset.authorName,
                username: row.dataset.authorName,
                avatar: row.dataset.authorAvatar,
                roles: [],
              };
              selectMember(member);
              openProfile(member);
            });
          });
        });

        if (keepScroll) {
          const afterHeight = messagesEl.scrollHeight;
          messagesEl.scrollTop = beforeScroll + (afterHeight - beforeHeight);
        } else {
          messagesEl.scrollTop = messagesEl.scrollHeight;
        }
      }

      async function selectChannel(channel) {
        state.selectedChannel = channel;
        state.messages.clear();
        state.newestId = "";
        state.oldestId = "";
        state.replyToMessageId = "";
        setActiveChannelButton();
        titleEl.textContent = `# ${channel.name}`;
        topicEl.textContent = channel.topic || "Live channel viewer powered by Legendary Bot.";
        input.disabled = false;
        sendBtn.disabled = false;
        replyBox.classList.remove("show");
        messagesEl.innerHTML = `<div class="lc-empty"><h2>Loading...</h2><p>Fetching recent messages.</p></div>`;
        await loadRecentMessages();
        startLivePolling();
      }

      async function loadRecentMessages() {
        if (!state.selectedChannel) return;
        try {
          const data = await api(`/api/command-center/messages?channelId=${encodeURIComponent(state.selectedChannel.id)}&limit=35`);
          mergeMessages(data.messages || []);
          renderMessages();
        } catch (error) {
          showToast(error.message, "error");
          messagesEl.innerHTML = `<div class="lc-empty"><h2>Could not load</h2><p>${escapeHtml(error.message)}</p></div>`;
        }
      }

      async function loadOlderMessages() {
        if (!state.selectedChannel || !state.oldestId || state.loading) return;
        state.loading = true;
        try {
          const data = await api(`/api/command-center/messages?channelId=${encodeURIComponent(state.selectedChannel.id)}&before=${encodeURIComponent(state.oldestId)}&limit=50`);
          mergeMessages(data.messages || []);
          renderMessages({ keepScroll: true });
        } catch (error) {
          showToast(error.message, "error");
        } finally {
          state.loading = false;
        }
      }

      async function checkNewMessages() {
        if (!state.selectedChannel || !state.newestId || state.loading) return;
        try {
          const data = await api(`/api/command-center/messages?channelId=${encodeURIComponent(state.selectedChannel.id)}&after=${encodeURIComponent(state.newestId)}&limit=50`);
          if ((data.messages || []).length) {
            const nearBottom = messagesEl.scrollTop + messagesEl.clientHeight >= messagesEl.scrollHeight - 120;
            mergeMessages(data.messages || []);
            renderMessages({ keepScroll: !nearBottom });
            if (nearBottom) messagesEl.scrollTop = messagesEl.scrollHeight;
          }
        } catch {}
      }

      function startLivePolling() {
        if (state.liveTimer) clearInterval(state.liveTimer);
        state.liveTimer = setInterval(checkNewMessages, 2800);
      }

      async function sendMessage() {
        if (!state.selectedChannel) return;
        const content = input.value.trim();
        if (!content) return;

        sendBtn.disabled = true;
        sendBtn.textContent = "Sending...";

        try {
          if (content.startsWith("/")) {
            const data = await api("/api/command-center/slash-command", {
              method: "POST",
              body: JSON.stringify({ channelId: state.selectedChannel.id, command: content }),
            });
            if (data.sent) mergeMessages([data.sent]);
          } else {
            const data = await api("/api/command-center/send-message", {
              method: "POST",
              body: JSON.stringify({ channelId: state.selectedChannel.id, content, replyToMessageId: state.replyToMessageId || "" }),
            });
            if (data.sent) mergeMessages([data.sent]);
          }

          renderMessages();
          input.value = "";
          state.replyToMessageId = "";
          replyBox.classList.remove("show");
          slashMenu.classList.remove("show");
          mentionMenu.classList.remove("show");
          showToast("Message sent", "success");
        } catch (error) {
          showToast(error.message, "error");
        } finally {
          sendBtn.disabled = false;
          sendBtn.textContent = "Send";
        }
      }

      async function deleteMessage(messageId) {
        if (!state.selectedChannel || !messageId) return;
        if (!confirm("Delete this message as the bot?")) return;
        try {
          await api("/api/command-center/delete-message", {
            method: "POST",
            body: JSON.stringify({ channelId: state.selectedChannel.id, messageId }),
          });
          state.messages.delete(messageId);
          renderMessages({ keepScroll: true });
          showToast("Message deleted", "success");
        } catch (error) {
          showToast(error.message, "error");
        }
      }

      function selectMember(member) {
        state.selectedMember = member;
        selectedMemberText.textContent = `${member.displayName || member.username || "Unknown"} • ${member.id || "unknown"}`;
      }

      function renderMemberRows(groupsOrMembers) {
        const groups = Array.isArray(groupsOrMembers) && groupsOrMembers[0]?.members
          ? groupsOrMembers
          : [{ id: "members", name: "Members", color: "#99aab5", members: groupsOrMembers || [] }];

        state.memberGroups = groups;
        state.flatMembers = groups.flatMap((group) => group.members || []);

        memberResults.innerHTML = groups.map((group) => `
          <div class="lc-member-section">
            <span style="display:flex; align-items:center; gap:7px;">
              <span class="lc-member-color-dot" style="color:${escapeHtml(group.color || "#99aab5")}; background:${escapeHtml(group.color || "#99aab5")}"></span>
              ${escapeHtml(group.name || "Members")}
            </span>
            <span>${(group.members || []).length}</span>
          </div>
          ${(group.members || []).map((member) => `
            <div class="lc-member-row" data-member='${escapeHtml(JSON.stringify(member))}'>
              <img src="${escapeHtml(member.avatar)}" alt="avatar"/>
              <div style="min-width:0; flex:1;">
                <div class="lc-member-name" style="color:${escapeHtml(member.color || group.color || "#fff")}">${escapeHtml(member.displayName)}</div>
                <div class="lc-member-sub">${member.bot ? "Bot" : (member.topRole?.name || "Member")}</div>
              </div>
            </div>
          `).join("")}
        `).join("") || `<p style="color:var(--muted); padding:8px;">No members found.</p>`;

        memberResults.querySelectorAll(".lc-member-row").forEach((row) => {
          const member = JSON.parse(row.dataset.member || "{}");
          row.addEventListener("click", () => {
            memberResults.querySelectorAll(".lc-member-row").forEach((r) => r.classList.remove("active"));
            row.classList.add("active");
            selectMember(member);
            openProfile(member);
          });
          row.addEventListener("contextmenu", (event) => {
            event.preventDefault();
            selectMember(member);
            openContextMenu(event.clientX, event.clientY, member);
          });
        });
      }

      async function searchMembers(forceAll = false) {
        const q = forceAll ? "" : memberSearch.value.trim();
        try {
          const data = await api(`/api/command-center/members?q=${encodeURIComponent(q)}`);
          renderMemberRows(data.groups || data.members || []);
        } catch (error) {
          showToast(error.message, "error");
        }
      }

      function openProfile(member) {
        const roles = member.roles || [];
        const roleOptions = state.roles
          .filter((role) => !roles.some((r) => r.id === role.id))
          .map((role) => `<option value="${escapeHtml(role.id)}">${escapeHtml(role.name)}</option>`)
          .join("");

        profilePopout.innerHTML = `
          <div class="lc-popout-banner"></div>
          <div class="lc-popout-content">
            <div class="lc-popout-avatar">${member.avatar ? `<img src="${escapeHtml(member.avatar)}" alt="avatar"/>` : ""}</div>
            <div class="lc-profile-name">${escapeHtml(member.displayName || member.username || "Unknown")}</div>
            <div class="lc-profile-id">${escapeHtml(member.id || "Unknown ID")}</div>
            <div class="lc-role-pills">
              ${roles.length ? roles.map((role) => `
                <span class="lc-role-pill" title="${escapeHtml(role.id)}">
                  <span>${escapeHtml(role.name)}</span>
                  <button class="lc-role-remove" data-remove-role="${escapeHtml(role.id)}">×</button>
                </span>
              `).join("") : `<span class="lc-role-pill">No roles loaded</span>`}
            </div>
            <select id="lcProfileAddRole" class="lc-field">
              <option value="">+ Add role...</option>
              ${roleOptions}
            </select>
            <textarea id="lcProfileDmText" class="lc-field" placeholder="DM ${escapeHtml(member.displayName || "member")} as bot..."></textarea>
            <button id="lcProfileDmBtn" class="lc-btn lc-good" style="width:100%; margin-top:8px;">Send DM</button>
            <button id="lcLoadDmBtn" class="lc-btn" style="width:100%; margin-top:8px;">Open Bot DM Thread</button>
            <div id="lcProfileDmThread" class="lc-dm-thread" style="display:none;"></div>
            <div class="lc-grid2">
              <button class="lc-btn" data-profile-action="timeout">Timeout</button>
              <button class="lc-btn" data-profile-action="untimeout">Untimeout</button>
              <button class="lc-btn lc-danger" data-profile-action="kick">Kick</button>
              <button class="lc-btn lc-danger" data-profile-action="ban">Ban</button>
            </div>
          </div>
        `;

        profilePopout.classList.add("show");

        profilePopout.querySelectorAll("[data-remove-role]").forEach((btn) => {
          btn.addEventListener("click", () => updateMemberRole(member, btn.dataset.removeRole, "remove"));
        });

        profilePopout.querySelector("#lcProfileAddRole")?.addEventListener("change", (event) => {
          if (event.target.value) updateMemberRole(member, event.target.value, "add");
        });

        profilePopout.querySelector("#lcProfileDmBtn")?.addEventListener("click", async () => {
          const text = profilePopout.querySelector("#lcProfileDmText")?.value?.trim() || "";
          if (!text) return showToast("Write a DM message first", "error");
          await sendDmTo(member, text);
          profilePopout.querySelector("#lcProfileDmText").value = "";
          await loadDmThread(member);
        });

        profilePopout.querySelector("#lcLoadDmBtn")?.addEventListener("click", () => loadDmThread(member));

        profilePopout.querySelectorAll("[data-profile-action]").forEach((btn) => {
          btn.addEventListener("click", () => runMemberAction(btn.dataset.profileAction, member));
        });
      }

      function openContextMenu(x, y, member) {
        state.contextMember = member;
        contextMenu.style.left = `${Math.min(x, window.innerWidth - 210)}px`;
        contextMenu.style.top = `${Math.min(y, window.innerHeight - 260)}px`;
        contextMenu.classList.add("show");
      }

      async function loadDmThread(member) {
        if (!member?.id) return showToast("Select a member first", "error");
        const thread = profilePopout.querySelector("#lcProfileDmThread");
        if (!thread) return;

        thread.style.display = "block";
        thread.innerHTML = `<div class="lc-dm-line">Loading bot DM thread...</div>`;

        try {
          const data = await api(`/api/command-center/dm-messages?memberId=${encodeURIComponent(member.id)}`);
          const lines = (data.messages || []).map((message) => `
            <div class="lc-dm-line">
              <strong>${escapeHtml(message.author?.username || "Unknown")}</strong>
              <span style="color:var(--muted); font-size:.72rem;">${escapeHtml(formatTime(message.createdTimestamp))}</span>
              <div>${escapeHtml(message.cleanContent || message.content || "[no text content]")}</div>
            </div>
          `).join("");

          thread.innerHTML = lines || `<div class="lc-dm-line">No bot DM messages found with this member yet.</div>`;
          thread.scrollTop = thread.scrollHeight;
        } catch (error) {
          thread.innerHTML = `<div class="lc-dm-line">${escapeHtml(error.message)}</div>`;
        }
      }

      async function sendDmTo(member, content) {
        if (!member?.id) return showToast("Select a member first", "error");
        await api("/api/command-center/dm", {
          method: "POST",
          body: JSON.stringify({ memberId: member.id, content }),
        });
        showToast("DM sent as bot", "success");
      }

      async function sendDm() {
        if (!state.selectedMember) return showToast("Select a member first", "error");
        const content = dmText.value.trim();
        if (!content) return showToast("Write a DM message first", "error");
        try {
          await sendDmTo(state.selectedMember, content);
          dmText.value = "";
        } catch (error) {
          showToast(error.message, "error");
        }
      }

      async function updateMemberRole(member, roleId, mode) {
        if (!member?.id) return showToast("Select a member first", "error");
        if (!roleId) return showToast("Select a role first", "error");

        try {
          const data = await api("/api/command-center/member-role", {
            method: "POST",
            body: JSON.stringify({ memberId: member.id, roleId, mode }),
          });
          if (data.member) {
            selectMember(data.member);
            openProfile(data.member);
          }
          showToast(data.message || "Role updated", "success");
          await searchMembers(true);
        } catch (error) {
          showToast(error.message, "error");
        }
      }

      async function runMemberAction(action, member = state.selectedMember) {
        if (!member?.id) return showToast("Select a member first", "error");
        if ((action === "kick" || action === "ban") && !confirm(`Are you sure you want to ${action} ${member.displayName || member.username}?`)) return;
        try {
          await api("/api/command-center/member-action", {
            method: "POST",
            body: JSON.stringify({
              memberId: member.id,
              action,
              reason: reasonInput.value.trim() || "Legendary Command Center action",
              roleId: roleSelect.value,
              minutes: 10,
            }),
          });
          showToast(`Action completed: ${action}`, "success");
        } catch (error) {
          showToast(error.message, "error");
        }
      }

      async function createCategory() {
        const name = newCategoryName.value.trim();
        if (!name) return showToast("Write category name first", "error");
        try {
          await api("/api/command-center/create-category", { method: "POST", body: JSON.stringify({ name }) });
          newCategoryName.value = "";
          showToast("Category created", "success");
          await init(true);
        } catch (error) {
          showToast(error.message, "error");
        }
      }

      async function createChannel() {
        const name = newChannelName.value.trim();
        if (!name) return showToast("Write channel name first", "error");
        try {
          await api("/api/command-center/create-channel", {
            method: "POST",
            body: JSON.stringify({ name, parentId: newChannelParent.value, type: newChannelType.value }),
          });
          newChannelName.value = "";
          showToast("Channel created", "success");
          await init(true);
        } catch (error) {
          showToast(error.message, "error");
        }
      }

      async function createRole() {
        const name = newRoleName.value.trim();
        const color = newRoleColor.value.trim() || "#8b5cf6";
        if (!name) return showToast("Write role name first", "error");
        try {
          await api("/api/command-center/create-role", { method: "POST", body: JSON.stringify({ name, color }) });
          newRoleName.value = "";
          showToast("Role created", "success");
          await init(true);
        } catch (error) {
          showToast(error.message, "error");
        }
      }

      async function initVoiceStatus() {
        try {
          const data = await api("/api/command-center/voice-status");
          voiceStatus.textContent = data.message || "Voice status loaded.";
        } catch {}
      }

      async function init(keepSelected = false) {
        try {
          const oldSelectedId = state.selectedChannel?.id || "";
          const data = await api("/api/command-center/bootstrap");
          state.channelGroups = data.channelGroups || [];
          state.roles = data.roles || [];

          try {
            const commandData = await api("/api/command-center/commands");
            state.commands = commandData.commands || [];
          } catch {
            state.commands = [];
          }
          renderChannels();
          renderRoles();
          initVoiceStatus();
          await searchMembers(true);
          const allChannels = state.channelGroups.flatMap((group) => group.channels || []);
          const nextChannel = keepSelected ? allChannels.find((channel) => channel.id === oldSelectedId) : null;
          const firstChannel = nextChannel || allChannels[0];
          if (firstChannel && (!state.selectedChannel || !keepSelected)) await selectChannel(firstChannel);
        } catch (error) {
          showToast(error.message, "error");
          channelList.innerHTML = `<div class="lc-category">Error</div><button class="lc-channel">${escapeHtml(error.message)}</button>`;
        }
      }

      let memberSearchTimer = null;
      channelSearch.addEventListener("input", renderChannels);
      memberSearch.addEventListener("input", () => {
        clearTimeout(memberSearchTimer);
        memberSearchTimer = setTimeout(() => searchMembers(false), 350);
      });
      input.addEventListener("input", () => { renderSlashMenu(); renderMentionMenu(); });
      input.addEventListener("focus", () => { renderSlashMenu(); renderMentionMenu(); });

      contextMenu.querySelectorAll("[data-context-action]").forEach((btn) => {
        btn.addEventListener("click", async () => {
          const action = btn.dataset.contextAction;
          const member = state.contextMember;
          contextMenu.classList.remove("show");
          if (!member) return;
          selectMember(member);
          if (action === "profile") return openProfile(member);
          if (action === "dm") {
            toolsDrawer.classList.add("show");
            dmText.focus();
            return;
          }
          if (action === "addRole") return updateMemberRole(member, roleSelect.value, "add");
          if (action === "removeRole") return updateMemberRole(member, roleSelect.value, "remove");
          return runMemberAction(action, member);
        });
      });

      document.addEventListener("click", (event) => {
        if (!event.target.closest("#lcContextMenu")) contextMenu.classList.remove("show");
        if (!event.target.closest("#lcProfilePopout") && !event.target.closest(".lc-member-row") && !event.target.closest(".lc-author-open")) {
          profilePopout.classList.remove("show");
        }
      });

      serverMenuBtn.addEventListener("click", (event) => {
        event.stopPropagation();
        serverMenuPanel.classList.toggle("show");
      });
      document.addEventListener("click", (event) => {
        if (!event.target.closest("#lcServerMenuPanel") && !event.target.closest("#lcServerMenuBtn")) {
          serverMenuPanel.classList.remove("show");
        }
      });
      menuCreateChannel.addEventListener("click", () => {
        serverMenuPanel.classList.remove("show");
        toolsDrawer.classList.add("show");
        newChannelName.focus();
      });
      menuCreateCategory.addEventListener("click", () => {
        serverMenuPanel.classList.remove("show");
        toolsDrawer.classList.add("show");
        newCategoryName.focus();
      });
      menuCreateRole.addEventListener("click", () => {
        serverMenuPanel.classList.remove("show");
        toolsDrawer.classList.add("show");
        newRoleName.focus();
      });
      menuServerSettings.addEventListener("click", () => {
        serverMenuPanel.classList.remove("show");
        toolsDrawer.classList.add("show");
        showToast("Server Settings drawer is planned next. Basic create/edit tools are here now.", "success");
      });

      openTools.addEventListener("click", () => toolsDrawer.classList.add("show"));
      openToolsTop.addEventListener("click", () => toolsDrawer.classList.add("show"));
      closeTools.addEventListener("click", () => toolsDrawer.classList.remove("show"));
      refreshMembers.addEventListener("click", () => searchMembers(true));
      sendDmBtn.addEventListener("click", sendDm);
      document.querySelectorAll("[data-member-action]").forEach((btn) => {
        btn.addEventListener("click", () => runMemberAction(btn.dataset.memberAction));
      });
      createCategoryBtn.addEventListener("click", createCategory);
      createChannelBtn.addEventListener("click", createChannel);
      createRoleBtn.addEventListener("click", createRole);
      sendBtn.addEventListener("click", sendMessage);
      input.addEventListener("keydown", (event) => {
        if (event.key === "Enter" && !event.shiftKey) {
          event.preventDefault();
          sendMessage();
        }
        if (event.key === "Escape") {
          slashMenu.classList.remove("show");
          mentionMenu.classList.remove("show");
        }
      });
      refreshBtn.addEventListener("click", loadRecentMessages);
      backBtn.addEventListener("click", () => window.location.href = `${window.LEGENDARY_CC.routeBase}/dashboard`);
      cancelReply.addEventListener("click", () => {
        state.replyToMessageId = "";
        replyBox.classList.remove("show");
      });

      init();
    })();
  </script>
<script src="/assets/js/site-music.js"></script></body>
</html>
