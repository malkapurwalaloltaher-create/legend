<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Analytics Center - Legendary Bot</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="stylesheet" href="/style.css" />
  <link rel="icon" type="image/png" href="/favicon.png?v=mega31" />
  <style>
    .mega-page{display:grid;gap:18px}.mega-hero{position:relative;overflow:hidden;border-radius:30px;padding:30px;background:linear-gradient(135deg,rgba(139,92,246,.25),rgba(34,211,238,.13)),rgba(12,15,39,.82);border:1px solid rgba(255,255,255,.13);box-shadow:0 24px 70px rgba(0,0,0,.26)}.mega-hero:after{content:"";position:absolute;right:-80px;bottom:-90px;width:230px;height:230px;border-radius:50%;background:rgba(34,211,238,.13);filter:blur(8px)}.mega-badge{display:inline-flex;align-items:center;gap:7px;padding:7px 10px;border-radius:999px;background:rgba(34,211,238,.12);border:1px solid rgba(34,211,238,.25);color:#cffafe;font-weight:1000;font-size:.78rem}.mega-hero h1{margin:14px 0 0;font-size:clamp(2.2rem,4vw,4.6rem);letter-spacing:-.075em;line-height:.92}.mega-hero p{margin:12px 0 0;color:#cbd5ff;line-height:1.6;max-width:950px}.mega-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}.mega-card{border-radius:24px;border:1px solid rgba(255,255,255,.12);background:rgba(255,255,255,.055);padding:20px;box-shadow:0 16px 40px rgba(0,0,0,.18);position:relative;overflow:hidden}.mega-card h2,.mega-card h3{margin:0 0 10px}.mega-muted{color:#b9c2ff;line-height:1.55}.mega-stat{font-size:2.4rem;font-weight:1000;letter-spacing:-.05em}.mega-mini{font-size:.82rem;color:#93c5fd;font-weight:900}.mega-list{display:grid;gap:10px;margin-top:12px}.mega-item{padding:12px;border-radius:16px;background:rgba(0,0,0,.18);border:1px solid rgba(255,255,255,.08)}.mega-form{display:grid;gap:14px}.mega-textarea{width:100%;min-height:120px;resize:vertical;border-radius:16px;border:1px solid rgba(255,255,255,.12);background:rgba(255,255,255,.08);color:#fff;padding:12px 14px;font-weight:800}.mega-toggle{display:flex;gap:10px;align-items:center;font-weight:900}.mega-btn{border:0;border-radius:15px;padding:12px 16px;font-weight:1000;color:#06111d;background:linear-gradient(135deg,#8b5cf6,#22d3ee);cursor:pointer}.pulse-line{height:8px;border-radius:999px;background:rgba(255,255,255,.08);overflow:hidden;margin-top:14px}.pulse-line i{display:block;height:100%;width:38%;border-radius:999px;background:linear-gradient(90deg,#8b5cf6,#22d3ee);animation:sweep 1.8s ease-in-out infinite}@keyframes sweep{0%{transform:translateX(-110%)}100%{transform:translateX(285%)}}@media(max-width:950px){.mega-grid{grid-template-columns:1fr}.mega-hero{padding:23px}}
  </style>
</head>
<body>
  <div class="app-shell">
    <%- include("partials/sidebar") %>
    <main class="main-content">
      <%- include("partials/topbar", { pageTitle: "Analytics Center", pageSubtitle: "Track activity, commands, moderation, tickets, giveaways, levels, sports, and server growth." }) %>
      <% if (success) { %><div class="alert success"><%= success %></div><% } %>
      <% if (error) { %><div class="alert error"><%= error %></div><% } %>
      <section class="mega-page">
        <div class="mega-hero"><span class="mega-badge">📊 Mega 3.1 Safe Foundation</span><h1>Analytics Center</h1><p>This page is the safe analytics hub foundation. It keeps the previous Mega 1 and Mega 2 work, then prepares live counters for commands, moderation, giveaways, tickets, levels, AI, sports, and workflows.</p></div>
        <div class="mega-grid">
          <div class="mega-card"><div class="mega-mini">COMMANDS</div><div class="mega-stat"><%= analyticsStats.commands || 0 %></div><p class="mega-muted">Command usage tracking hook.</p><div class="pulse-line"><i></i></div></div>
          <div class="mega-card"><div class="mega-mini">MODERATION</div><div class="mega-stat"><%= analyticsStats.moderation || 0 %></div><p class="mega-muted">Warnings, bans, timeouts, notes, automod.</p><div class="pulse-line"><i></i></div></div>
          <div class="mega-card"><div class="mega-mini">GIVEAWAYS</div><div class="mega-stat"><%= analyticsStats.giveaways || 0 %></div><p class="mega-muted">Giveaway starts, entries, winners, rerolls.</p><div class="pulse-line"><i></i></div></div>
        </div>
        <div class="mega-grid">
          <div class="mega-card"><h3>🎫 Tickets</h3><p class="mega-muted">Open, claimed, closed, average response, transcripts, ratings.</p></div>
          <div class="mega-card"><h3>🤖 AI</h3><p class="mega-muted">AI sessions, memory hits, provider fallback, usage limits.</p></div>
          <div class="mega-card"><h3>⚽ Sports</h3><p class="mega-muted">Football/cricket channel activity, alerts, subscriptions.</p></div>
        </div>
        <form class="mega-card mega-form" method="POST" action="/analytics/save">
          <label class="mega-toggle"><input type="checkbox" name="enabled" <%= analyticsConfig.enabled ? "checked" : "" %> /> Enable analytics tracking foundation</label>
          <label><strong>Analytics Notes</strong><textarea class="mega-textarea" name="notes"><%= analyticsConfig.notes || "" %></textarea></label>
          <button class="mega-btn" type="submit">Save Analytics Settings</button>
        </form>
      </section>
    </main>
  </div>
  <script src="/dashboard.js"></script>
  <script src="/assets/js/site-music.js"></script>
</body>
</html>
