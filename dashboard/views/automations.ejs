<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"/><title>Automations - Legendary Bot</title><meta name="viewport" content="width=device-width, initial-scale=1.0"/><link rel="stylesheet" href="/style.css"/><link rel="icon" type="image/png" href="/favicon.png?v=10.0.0"/></head><body><div class="app-shell"><%- include("partials/sidebar") %><main class="main-content"><%- include("partials/topbar", { pageTitle: "Automations", pageSubtitle: "Create repeating message automations." }) %><% if (success) { %><div class="alert success"><%= success %></div><% } %><% if (error) { %><div class="alert error"><%= error %></div><% } %><section class="hero-card"><div class="hero-text"><div class="hero-icon-wrap"><img src="<%= botAvatar %>" class="hero-bot-avatar"/></div><div><h2>🔁 Automation Builder</h2><p>Make repeating messages without going to code.</p></div></div></section><section class="section-card"><form method="POST" action="/automations/create" class="form-stack padded-form"><label class="form-group"><span>Name</span><input name="name" class="input" placeholder="Daily reminder"/></label><label class="form-group"><span>Channel</span><select name="channelId" class="input" required><option value="">Select channel</option><% channelGroups.forEach(group => { %><optgroup label="📁 <%= group.name %>"><% group.channels.forEach(channel => { %><option value="<%= channel.id %>"># <%= channel.name %></option><% }) %></optgroup><% }) %></select></label><label class="form-group"><span>Message</span><textarea name="content" class="input textarea" required></textarea></label><label class="form-group"><span>Every X hours</span><input name="intervalHours" type="number" min="1" class="input" value="12"/></label><button class="primary-btn">Create Automation</button></form></section><section class="section-card"><div class="section-header"><h2>Recent Automations</h2></div><div class="template-grid"><% if (!jobs.length) { %><div class="empty-mini">No automations yet.</div><% } %><% jobs.forEach(job => { %><div class="template-card"><h3><%= job.name %></h3><p>#<%= job.channelName %> • every <%= job.intervalHours %>h • <%= job.active ? 'Active' : 'Paused' %></p></div><% }) %></div></section></main></div><script src="/dashboard.js"></script><script src="/assets/js/site-music.js"></script></body></html>
