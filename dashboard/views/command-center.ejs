      <button id="lcCreateCategoryBtn" class="lc-btn" type="button" style="width:100%; margin-top:8px;">Create Category</button>
      <input id="lcNewChannelName" class="lc-field" placeholder="New channel name..."/>
      <select id="lcNewChannelParent" class="lc-field"><option value="">No category</option></select>
      <select id="lcNewChannelType" class="lc-field"><option value="text">Text Channel</option><option value="voice">Voice Channel</option></select>
      <button id="lcCreateChannelBtn" class="lc-btn" type="button" style="width:100%; margin-top:8px;">Create Channel</button>
      <input id="lcNewRoleName" class="lc-field" placeholder="New role name..."/>
      <input id="lcNewRoleColor" class="lc-field" placeholder="#8b5cf6"/>
      <button id="lcCreateRoleBtn" class="lc-btn" type="button" style="width:100%; margin-top:8px;">Create Role</button>
    </div>

    <div class="lc-card">
      <h3>Voice / Music</h3>
      <p id="lcVoiceStatus">Voice controls placeholder is ready. Full music engine needs the next dedicated music build.</p>
