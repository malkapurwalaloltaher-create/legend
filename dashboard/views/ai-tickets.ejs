<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <title>AI Tickets - Legendary Bot</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <link rel="stylesheet" href="/style.css"/>
  <link rel="icon" type="image/png" href="/favicon.png?v=18.5.5"/>

  <style>
    .ai-page-wrap {
      display: grid;
      gap: 20px;
    }

    .ai-hero {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 20px;
      align-items: center;
      padding: 28px;
      border-radius: 28px;
      border: 1px solid rgba(139, 92, 246, 0.34);
      background:
        radial-gradient(circle at top left, rgba(139, 92, 246, 0.34), transparent 35%),
        radial-gradient(circle at bottom right, rgba(34, 211, 238, 0.22), transparent 40%),
        rgba(12, 10, 36, 0.96);
      box-shadow: 0 24px 70px rgba(0, 0, 0, 0.25);
    }

    .ai-hero h2 {
      margin: 0;
      font-size: clamp(2rem, 4vw, 4.2rem);
      line-height: 0.98;
      letter-spacing: -0.06em;
    }

    .ai-hero p {
      max-width: 760px;
      margin: 14px 0 0;
      color: rgba(237, 233, 254, 0.78);
      font-weight: 700;
      line-height: 1.65;
    }

    .ai-hero-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 9px 12px;
      margin-bottom: 12px;
      border-radius: 999px;
      background: rgba(34, 197, 94, 0.14);
      border: 1px solid rgba(34, 197, 94, 0.35);
      color: #bbf7d0;
      font-weight: 900;
      font-size: 0.85rem;
    }

    .ai-hero-icon {
      width: 112px;
      height: 112px;
      border-radius: 34px;
      display: grid;
      place-items: center;
      font-size: 56px;
      background: linear-gradient(135deg, rgba(139, 92, 246, 0.36), rgba(34, 211, 238, 0.22));
      border: 1px solid rgba(255, 255, 255, 0.12);
    }

    .ai-module-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(235px, 1fr));
      gap: 16px;
    }

    .ai-module-card {
      position: relative;
      display: flex;
      gap: 14px;
      min-height: 154px;
      padding: 20px;
      border-radius: 26px;
      text-decoration: none;
      color: inherit;
      border: 1px solid rgba(139, 92, 246, 0.3);
      background: rgba(15, 13, 45, 0.94);
      transition: transform 0.18s ease, border-color 0.18s ease, background 0.18s ease;
      overflow: hidden;
    }

    .ai-module-card::after {
      content: "";
      position: absolute;
      inset: auto -20% -45% 30%;
      height: 110px;
      background: radial-gradient(circle, rgba(139, 92, 246, 0.22), transparent 65%);
      pointer-events: none;
    }

    .ai-module-card:hover {
      transform: translateY(-3px);
      border-color: rgba(34, 211, 238, 0.7);
      background: linear-gradient(135deg, rgba(31, 22, 72, 0.96), rgba(7, 35, 62, 0.96));
    }

    .ai-module-card.active {
      border-color: rgba(34, 197, 94, 0.72);
      box-shadow: 0 0 0 1px rgba(34, 197, 94, 0.2), 0 18px 55px rgba(34, 197, 94, 0.08);
    }

    .ai-module-card.locked {
      opacity: 0.82;
    }

    .ai-module-icon {
      width: 50px;
      height: 50px;
      border-radius: 18px;
      display: grid;
      place-items: center;
      font-size: 27px;
      background: rgba(139, 92, 246, 0.18);
      flex: 0 0 auto;
      z-index: 1;
    }

    .ai-module-card h3 {
      margin: 0 0 8px;
      font-size: 1.1rem;
      z-index: 1;
    }

    .ai-module-card p {
      margin: 0 0 13px;
      color: rgba(237, 233, 254, 0.72);
      line-height: 1.45;
      z-index: 1;
    }

    .ai-pill {
      display: inline-flex;
      padding: 7px 11px;
      border-radius: 999px;
      font-size: 0.78rem;
      font-weight: 1000;
      letter-spacing: 0.03em;
      z-index: 1;
    }

    .ai-pill.ready {
      color: #bbf7d0;
      background: rgba(34, 197, 94, 0.16);
      border: 1px solid rgba(34, 197, 94, 0.42);
    }

    .ai-pill.soon {
      color: #fde68a;
      background: rgba(245, 158, 11, 0.15);
      border: 1px solid rgba(245, 158, 11, 0.42);
    }

    .ai-top-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 16px;
    }

    .ai-back-btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 12px 16px;
      border-radius: 16px;
      background: rgba(255, 255, 255, 0.08);
      border: 1px solid rgba(255, 255, 255, 0.12);
      color: #fff;
      text-decoration: none;
      font-weight: 900;
    }

    .ai-settings-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 16px;
    }

    .ai-mini-help {
      padding: 18px;
      border-radius: 20px;
      background: rgba(34, 211, 238, 0.08);
      border: 1px solid rgba(34, 211, 238, 0.22);
      color: rgba(224, 242, 254, 0.92);
      line-height: 1.6;
      font-weight: 700;
    }

    .module-placeholder {
      padding: 26px;
      border-radius: 26px;
      border: 1px dashed rgba(245, 158, 11, 0.55);
      background: rgba(245, 158, 11, 0.11);
      color: #fde68a;
    }

    .module-placeholder h2 {
      margin-top: 0;
    }

    @media (max-width: 800px) {
      .ai-hero {
        grid-template-columns: 1fr;
      }

      .ai-hero-icon {
        width: 82px;
        height: 82px;
        font-size: 42px;
      }
    }

    .ai-pretty-hidden {
      position: absolute !important;
      opacity: 0 !important;
      pointer-events: none !important;
      width: 1px !important;
      height: 1px !important;
    }

    .pretty-select {
      position: relative;
      width: 100%;
      z-index: 5;
    }

    .pretty-select.open {
      z-index: 80;
    }

    .pretty-select-button {
      width: 100%;
      min-height: 48px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: 13px 15px;
      border-radius: 16px;
      border: 1px solid rgba(139, 92, 246, 0.34);
      background: rgba(12, 10, 32, 0.92);
      color: #fff;
      cursor: pointer;
      font-weight: 800;
      text-align: left;
      transition: border-color 0.18s ease, background 0.18s ease, box-shadow 0.18s ease;
    }

    .pretty-select-button:hover,
    .pretty-select.open .pretty-select-button {
      border-color: rgba(34, 211, 238, 0.72);
      background: linear-gradient(135deg, rgba(31, 22, 72, 0.96), rgba(7, 35, 62, 0.96));
      box-shadow: 0 14px 34px rgba(34, 211, 238, 0.09);
    }

    .pretty-select-value {
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .pretty-select-arrow {
      flex: 0 0 auto;
      opacity: 0.8;
      transition: transform 0.18s ease;
    }

    .pretty-select.open .pretty-select-arrow {
      transform: rotate(180deg);
    }

    .pretty-select-menu {
      position: absolute;
      left: 0;
      right: 0;
      top: calc(100% + 8px);
      padding: 12px;
      border-radius: 20px;
      border: 1px solid rgba(139, 92, 246, 0.38);
      background:
        radial-gradient(circle at top left, rgba(139, 92, 246, 0.18), transparent 34%),
        rgba(9, 8, 27, 0.98);
      box-shadow: 0 22px 70px rgba(0, 0, 0, 0.42);
      backdrop-filter: blur(16px);
      display: none;
    }

    .pretty-select.open .pretty-select-menu {
      display: block;
      animation: prettyDropIn 0.16s ease;
    }

    .pretty-select-search {
      width: 100%;
      height: 44px;
      border-radius: 14px;
      border: 1px solid rgba(255, 255, 255, 0.12);
      background: rgba(255, 255, 255, 0.07);
      color: #fff;
      padding: 0 14px;
      outline: none;
      font-weight: 800;
      margin-bottom: 10px;
    }

    .pretty-select-search:focus {
      border-color: rgba(34, 211, 238, 0.7);
    }

    .pretty-select-options {
      max-height: 290px;
      overflow: auto;
      padding-right: 4px;
    }

    .pretty-select-group {
      margin: 10px 0 7px;
      padding: 0 9px;
      color: rgba(237, 233, 254, 0.55);
      font-size: 0.76rem;
      font-weight: 1000;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .pretty-select-option {
      width: 100%;
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 11px 12px;
      border: 0;
      border-radius: 13px;
      background: transparent;
      color: rgba(255, 255, 255, 0.88);
      cursor: pointer;
      text-align: left;
      font-weight: 800;
      margin-bottom: 4px;
    }

    .pretty-select-option:hover {
      background: rgba(139, 92, 246, 0.18);
      color: #fff;
    }

    .pretty-select-option.selected {
      background: linear-gradient(135deg, rgba(34, 197, 94, 0.22), rgba(34, 211, 238, 0.16));
      color: #bbf7d0;
      border: 1px solid rgba(34, 197, 94, 0.32);
    }

    .pretty-select-option.disabled {
      cursor: not-allowed;
      opacity: 0.48;
    }

    .pretty-select-empty {
      padding: 16px 12px;
      text-align: center;
      color: rgba(237, 233, 254, 0.62);
      font-weight: 800;
    }

    @keyframes prettyDropIn {
      from {
        opacity: 0;
        transform: translateY(-5px) scale(0.98);
      }
      to {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
    }


    .ai-pretty-picker {
      position: relative;
      width: 100%;
      z-index: 10;
    }

    .ai-pretty-picker.open {
      z-index: 999;
    }

    .ai-pretty-picker-btn {
      width: 100%;
      min-height: 50px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: 13px 15px;
      border-radius: 16px;
      border: 1px solid rgba(139, 92, 246, 0.38);
      background: rgba(12, 10, 32, 0.94);
      color: #fff;
      cursor: pointer;
      font-weight: 900;
      text-align: left;
    }

    .ai-pretty-picker-btn:hover,
    .ai-pretty-picker.open .ai-pretty-picker-btn {
      border-color: rgba(34, 211, 238, 0.82);
      background: linear-gradient(135deg, rgba(31, 22, 72, 0.97), rgba(7, 35, 62, 0.97));
      box-shadow: 0 18px 38px rgba(34, 211, 238, 0.10);
    }

    .ai-pretty-picker-value {
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .ai-pretty-picker-arrow {
      flex: 0 0 auto;
      opacity: 0.85;
      transition: transform 0.18s ease;
    }

    .ai-pretty-picker.open .ai-pretty-picker-arrow {
      transform: rotate(180deg);
    }

    .ai-pretty-picker-menu {
      position: absolute;
      left: 0;
      right: 0;
      top: calc(100% + 8px);
      display: none;
      padding: 12px;
      border-radius: 22px;
      border: 1px solid rgba(139, 92, 246, 0.42);
      background:
        radial-gradient(circle at top left, rgba(139, 92, 246, 0.22), transparent 34%),
        rgba(9, 8, 27, 0.985);
      box-shadow: 0 26px 80px rgba(0, 0, 0, 0.48);
      backdrop-filter: blur(18px);
    }

    .ai-pretty-picker.open .ai-pretty-picker-menu {
      display: block;
      animation: aiPrettyDrop 0.16s ease;
    }

    .ai-pretty-picker-search {
      width: 100%;
      height: 45px;
      border-radius: 14px;
      border: 1px solid rgba(255, 255, 255, 0.13);
      background: rgba(255, 255, 255, 0.075);
      color: #fff;
      outline: none;
      padding: 0 14px;
      font-weight: 900;
      margin-bottom: 10px;
    }

    .ai-pretty-picker-search:focus {
      border-color: rgba(34, 211, 238, 0.78);
    }

    .ai-pretty-picker-list {
      max-height: 310px;
      overflow: auto;
      padding-right: 4px;
    }

    .ai-pretty-picker-group {
      margin: 10px 0 7px;
      padding: 0 9px;
      color: rgba(237, 233, 254, 0.58);
      font-size: 0.76rem;
      font-weight: 1000;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .ai-pretty-picker-option {
      width: 100%;
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 11px 12px;
      border: 0;
      border-radius: 14px;
      background: transparent;
      color: rgba(255, 255, 255, 0.9);
      cursor: pointer;
      text-align: left;
      font-weight: 900;
      margin-bottom: 4px;
    }

    .ai-pretty-picker-option:hover {
      background: rgba(139, 92, 246, 0.20);
      color: #fff;
    }

    .ai-pretty-picker-option.selected {
      background: linear-gradient(135deg, rgba(34, 197, 94, 0.22), rgba(34, 211, 238, 0.16));
      color: #bbf7d0;
      border: 1px solid rgba(34, 197, 94, 0.34);
    }

    .ai-pretty-picker-option.disabled {
      cursor: not-allowed;
      opacity: 0.48;
    }

    .ai-pretty-picker-empty {
      display: none;
      padding: 16px 12px;
      text-align: center;
      color: rgba(237, 233, 254, 0.62);
      font-weight: 900;
    }

    @keyframes aiPrettyDrop {
      from {
        opacity: 0;
        transform: translateY(-5px) scale(0.98);
      }
      to {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
    }

  </style>
</head>
<body>
<div class="app-shell">
  <%- include("partials/sidebar") %>

  <main class="main-content">
    <%- include("partials/topbar", {
      pageTitle: "AI Tickets",
      pageSubtitle: "Configure AI TicketTool modules, scoring, review routing, reports, and future AI flows."
    }) %>

    <% const moduleKey = selectedModule || "home"; %>

    <% if (success) { %><div class="alert success"><%= success %></div><% } %>
    <% if (error) { %><div class="alert error"><%= error %></div><% } %>

    <div class="ai-page-wrap">
      <section class="ai-hero">
        <div>
          <div class="ai-hero-badge">🤖 Owner AI Control Panel</div>
          <h2>AI Ticket System</h2>
          <p>
            Choose a ticket module, edit scoring logic, connect review channels, detect AI-copy style answers,
            and send final reports to staff or a webhook. Staff Applications is ready now; the other modules are already prepared for future phases.
          </p>
        </div>
        <div class="ai-hero-icon">🎫</div>
      </section>

      <% if (moduleKey === "home") { %>
        <section class="section-card">
          <div class="section-header">
            <h2>Select AI Ticket Module</h2>
            <p>Pick what you want to configure. Only Staff Applications is active right now.</p>
          </div>

          <div class="ai-module-grid">
            <a class="ai-module-card active" href="<%= routeBase %>/ai-tickets/staff_application" data-dashboard-loading="true" data-loading-title="Opening Staff Applications...">
              <div class="ai-module-icon">🛡️</div>
              <div>
                <h3>Staff Applications</h3>
                <p>Ready. Configure questions, score limits, auto approve role, AI-copy detection, and review reports.</p>
                <span class="ai-pill ready">Ready</span>
              </div>
            </a>

            <a class="ai-module-card locked" href="<%= routeBase %>/ai-tickets/ban_appeal" data-dashboard-loading="true" data-loading-title="Opening Ban Appeals...">
              <div class="ai-module-icon">🔨</div>
              <div>
                <h3>Ban Appeals</h3>
                <p>Placeholder created. This phase is not ready to use yet.</p>
                <span class="ai-pill soon">Not Ready Yet</span>
              </div>
            </a>

            <a class="ai-module-card locked" href="<%= routeBase %>/ai-tickets/warn_appeal" data-dashboard-loading="true" data-loading-title="Opening Warn Appeals...">
              <div class="ai-module-icon">⚠️</div>
              <div>
                <h3>Warn Appeals</h3>
                <p>Placeholder created. This phase is not ready to use yet.</p>
                <span class="ai-pill soon">Not Ready Yet</span>
              </div>
            </a>

            <a class="ai-module-card locked" href="<%= routeBase %>/ai-tickets/partnership" data-dashboard-loading="true" data-loading-title="Opening Partnerships...">
              <div class="ai-module-icon">🤝</div>
              <div>
                <h3>Partnerships</h3>
                <p>Placeholder created. This phase is not ready to use yet.</p>
                <span class="ai-pill soon">Not Ready Yet</span>
              </div>
            </a>

            <a class="ai-module-card locked" href="<%= routeBase %>/ai-tickets/support" data-dashboard-loading="true" data-loading-title="Opening Support AI...">
              <div class="ai-module-icon">🛟</div>
              <div>
                <h3>Support AI</h3>
                <p>Placeholder created. This phase is not ready to use yet.</p>
                <span class="ai-pill soon">Not Ready Yet</span>
              </div>
            </a>
          </div>
        </section>
      <% } else if (moduleKey !== "staff_application") { %>
        <section class="section-card">
          <div class="ai-top-actions">
            <a href="<%= routeBase %>/ai-tickets" class="ai-back-btn" data-dashboard-loading="true" data-loading-title="Returning to AI Modules...">⬅️ Back to AI Modules</a>
          </div>

          <div class="module-placeholder">
            <h2>🚧 This phase is not ready to use yet</h2>
            <p>
              This module page is already prepared so later we can activate it by editing the files,
              not rebuilding the whole dashboard from zero.
            </p>
          </div>
        </section>
      <% } else { %>
        <section class="section-card">
          <div class="ai-top-actions">
            <a href="<%= routeBase %>/ai-tickets" class="ai-back-btn" data-dashboard-loading="true" data-loading-title="Returning to AI Modules...">⬅️ Back to AI Modules</a>
            <span class="ai-pill ready">🛡️ Staff Applications Ready</span>
          </div>

          <div class="ai-mini-help">
            Users can send multiple messages for one answer. The bot only moves to the next question when they type
            <strong>$next</strong>. Final AI review happens after the full interview, not after every question.
          </div>
        </section>

        <section class="section-card">
          <form method="POST" action="<%= routeBase %>/ai-tickets/save" class="form-stack padded-form" data-dashboard-ajax="true" data-loading-text="Saving AI Ticket settings without reloading the page." data-stay="true">
            <div class="section-header">
              <h2>Staff Application Logic</h2>
              <p>Edit the full scoring and automation logic for staff applications.</p>
            </div>

            <label class="toggle-line">
              <input type="checkbox" name="enabled" <%= config.enabled !== false ? "checked" : "" %>/>
              <span>Enable AI Ticket System</span>
            </label>

            <label class="toggle-line">
              <input type="checkbox" name="aiEnabled" <%= config.aiEnabled !== false ? "checked" : "" %>/>
              <span>Use AI providers when keys are available</span>
            </label>

            <div class="ai-settings-grid">
              <label class="form-group">
                <span>Preferred Provider</span>
                <select name="preferredProvider" class="input">
                  <% ["auto", "groq", "openrouter", "gemini", "local"].forEach(provider => { %>
                    <option value="<%= provider %>" <%= config.preferredProvider === provider ? "selected" : "" %>><%= provider %></option>
                  <% }) %>
                </select>
              </label>

              <label class="form-group">
                <span>Strictness</span>
                <select name="strictness" class="input">
                  <% ["relaxed", "normal", "strict"].forEach(mode => { %>
                    <option value="<%= mode %>" <%= config.strictness === mode ? "selected" : "" %>><%= mode %></option>
                  <% }) %>
                </select>
              </label>

              <label class="form-group">
                <span>Final Score Out Of</span>
                <input class="input" type="number" name="finalScoreMax" min="10" max="1000" value="<%= config.finalScoreMax || 100 %>"/>
              </label>

              <label class="form-group">
                <span>Pass Score</span>
                <input class="input" type="number" name="passScore" min="1" max="1000" value="<%= config.passScore || 100 %>"/>
              </label>

              <label class="form-group">
                <span>Staff Review Min Score</span>
                <input class="input" type="number" name="staffReviewMinScore" min="0" max="1000" value="<%= config.staffReviewMinScore || 75 %>"/>
              </label>

              <label class="form-group">
                <span>Pending Review Ping Minutes</span>
                <input class="input" type="number" name="pendingPingMinutes" min="5" max="1440" value="<%= config.pendingPingMinutes || 30 %>"/>
              </label>

              <label class="form-group">
                <span>Session Timeout Minutes</span>
                <input class="input" type="number" name="sessionTimeoutMinutes" min="15" max="1440" value="<%= config.sessionTimeoutMinutes || 60 %>"/>
              </label>

              <label class="form-group">
                <span>Next Command</span>
                <input class="input" name="nextCommand" value="<%= config.nextCommand || '$next' %>"/>
              </label>

              <label class="form-group">
                <span>Auto Approve Role ID</span>
                <input class="input" name="autoApproveRoleId" value="<%= config.autoApproveRoleId || '' %>" placeholder="Role ID to give when score passes"/>
              </label>

              <label class="form-group">
                <span>Report Webhook URL</span>
                <input class="input" name="reportWebhookUrl" value="<%= config.reportWebhookUrl || '' %>" placeholder="Optional Discord webhook URL"/>
              </label>

              <label class="form-group">
                <span>AI Copy Min Characters</span>
                <input class="input" type="number" name="aiCopyMinChars" min="100" max="3000" value="<%= config.aiCopyMinChars || 350 %>"/>
              </label>

              <label class="form-group">
                <span>AI Copy Fast Seconds</span>
                <input class="input" type="number" name="aiCopyFastSeconds" min="5" max="300" value="<%= config.aiCopyFastSeconds || 45 %>"/>
              </label>

              <label class="form-group">
                <span>AI Copy Score Cap</span>
                <input class="input" type="number" name="aiCopyScoreCap" min="1" max="10" value="<%= config.aiCopyScoreCap || 7 %>"/>
              </label>
            </div>

            <div class="section-card nested-card">
              <h3>Flow + Automation</h3>

              <label class="toggle-line">
                <input type="checkbox" name="requireNextCommand" <%= config.requireNextCommand !== false ? "checked" : "" %>/>
                <span>Require $next before moving to the next question</span>
              </label>

              <label class="toggle-line">
                <input type="checkbox" name="autoApproveEnabled" <%= config.autoApproveEnabled === true ? "checked" : "" %>/>
                <span>Enable auto approve when score reaches pass score</span>
              </label>

              <label class="toggle-line">
                <input type="checkbox" name="autoApproveOnlyIfNoAiFlags" <%= config.autoApproveOnlyIfNoAiFlags !== false ? "checked" : "" %>/>
                <span>Do not auto approve if AI-copy suspicion flags exist</span>
              </label>

              <label class="toggle-line">
                <input type="checkbox" name="aiCopyDetectionEnabled" <%= config.aiCopyDetectionEnabled !== false ? "checked" : "" %>/>
                <span>Enable AI-copy suspicion detection</span>
              </label>

              <label class="toggle-line">
                <input type="checkbox" name="saveRawAnswersAfterReport" <%= config.saveRawAnswersAfterReport !== false ? "checked" : "" %>/>
                <span>Keep raw answers saved after report</span>
              </label>
            </div>

            <div class="section-card nested-card">
              <h3>Ticket Type Routing</h3>
              <p class="muted">Pick the TicketTool open category, review channel, and optional ping role. These searchable dropdowns save the real Discord IDs to MongoDB.</p>

              <% const safeCategories = (typeof categories !== "undefined" && Array.isArray(categories)) ? categories : []; %>
              <% const safeChannelGroups = (typeof allChannelGroups !== "undefined" && Array.isArray(allChannelGroups)) ? allChannelGroups : ((typeof channelGroups !== "undefined" && Array.isArray(channelGroups)) ? channelGroups : []); %>
              <% const safeRoles = (typeof roles !== "undefined" && Array.isArray(roles)) ? roles : []; %>

              <% (config.types || []).forEach(type => { %>
                <%
                  let selectedCategoryName = "Select category";
                  const selectedCategoryItem = safeCategories.find(category => category.id === type.categoryId);
                  if (selectedCategoryItem) selectedCategoryName = selectedCategoryItem.name;
                  else if (type.categoryId) selectedCategoryName = "Saved category ID: " + type.categoryId;

                  let selectedReviewChannelName = "Select review channel";
                  safeChannelGroups.forEach(group => {
                    (group.channels || []).forEach(channel => {
                      if (channel.id === type.reviewChannelId) selectedReviewChannelName = "#" + channel.name;
                    });
                  });
                  if (!selectedReviewChannelName || selectedReviewChannelName === "Select review channel") {
                    if (type.reviewChannelId) selectedReviewChannelName = "Saved channel ID: " + type.reviewChannelId;
                  }

                  let selectedRoleName = "No ping role";
                  const selectedRoleItem = safeRoles.find(role => role.id === type.pingRoleId);
                  if (selectedRoleItem) selectedRoleName = "@" + selectedRoleItem.name;
                  else if (type.pingRoleId) selectedRoleName = "Saved role ID: " + type.pingRoleId;
                %>

                <div class="section-card nested-card">
                  <h3><%= type.label %></h3>

                  <label class="toggle-line">
                    <input type="checkbox" name="<%= type.key %>_enabled" <%= type.enabled !== false ? "checked" : "" %>/>
                    <span>Enable this ticket type</span>
                  </label>

                  <div class="ai-settings-grid">
                    <label class="form-group">
                      <span>TicketTool Open Category</span>
                      <input type="hidden" name="<%= type.key %>_categoryId" value="<%= type.categoryId || '' %>"/>
                      <div class="ai-pretty-picker" data-target="<%= type.key %>_categoryId">
                        <button type="button" class="ai-pretty-picker-btn">
                          <span class="ai-pretty-picker-value"><%= selectedCategoryName %></span>
                          <span class="ai-pretty-picker-arrow">⌄</span>
                        </button>
                        <div class="ai-pretty-picker-menu">
                          <input class="ai-pretty-picker-search" type="search" placeholder="Search category..." autocomplete="off"/>
                          <div class="ai-pretty-picker-list">
                            <% safeCategories.forEach(category => { %>
                              <button type="button" class="ai-pretty-picker-option <%= type.categoryId === category.id ? 'selected' : '' %>" data-value="<%= category.id %>" data-label="<%= category.name %>">📁 <%= category.name %></button>
                            <% }) %>
                            <% if (type.categoryId && !safeCategories.some(category => category.id === type.categoryId)) { %>
                              <button type="button" class="ai-pretty-picker-option selected" data-value="<%= type.categoryId %>" data-label="Saved category ID: <%= type.categoryId %>">📁 Saved category ID: <%= type.categoryId %></button>
                            <% } %>
                          </div>
                          <div class="ai-pretty-picker-empty">No category found</div>
                        </div>
                      </div>
                    </label>

                    <label class="form-group">
                      <span>Review Channel</span>
                      <input type="hidden" name="<%= type.key %>_reviewChannelId" value="<%= type.reviewChannelId || '' %>"/>
                      <div class="ai-pretty-picker" data-target="<%= type.key %>_reviewChannelId">
                        <button type="button" class="ai-pretty-picker-btn">
                          <span class="ai-pretty-picker-value"><%= selectedReviewChannelName %></span>
                          <span class="ai-pretty-picker-arrow">⌄</span>
                        </button>
                        <div class="ai-pretty-picker-menu">
                          <input class="ai-pretty-picker-search" type="search" placeholder="Search channel..." autocomplete="off"/>
                          <div class="ai-pretty-picker-list">
                            <% safeChannelGroups.forEach(group => { %>
                              <div class="ai-pretty-picker-group"><%= group.name %></div>
                              <% if (!(group.channels || []).length) { %>
                                <button type="button" class="ai-pretty-picker-option disabled" disabled data-label="<%= group.name %> empty category">— Empty category —</button>
                              <% } %>
                              <% (group.channels || []).forEach(channel => { %>
                                <button type="button" class="ai-pretty-picker-option <%= type.reviewChannelId === channel.id ? 'selected' : '' %>" data-value="<%= channel.id %>" data-label="<%= channel.name %> <%= group.name %>"># <%= channel.name %></button>
                              <% }) %>
                            <% }) %>
                            <% if (type.reviewChannelId && !safeChannelGroups.some(group => (group.channels || []).some(channel => channel.id === type.reviewChannelId))) { %>
                              <button type="button" class="ai-pretty-picker-option selected" data-value="<%= type.reviewChannelId %>" data-label="Saved channel ID: <%= type.reviewChannelId %>"># Saved channel ID: <%= type.reviewChannelId %></button>
                            <% } %>
                          </div>
                          <div class="ai-pretty-picker-empty">No channel found</div>
                        </div>
                      </div>
                    </label>

                    <label class="form-group">
                      <span>Optional Ping Role</span>
                      <input type="hidden" name="<%= type.key %>_pingRoleId" value="<%= type.pingRoleId || '' %>"/>
                      <div class="ai-pretty-picker" data-target="<%= type.key %>_pingRoleId">
                        <button type="button" class="ai-pretty-picker-btn">
                          <span class="ai-pretty-picker-value"><%= selectedRoleName %></span>
                          <span class="ai-pretty-picker-arrow">⌄</span>
                        </button>
                        <div class="ai-pretty-picker-menu">
                          <input class="ai-pretty-picker-search" type="search" placeholder="Search role..." autocomplete="off"/>
                          <div class="ai-pretty-picker-list">
                            <button type="button" class="ai-pretty-picker-option <%= !type.pingRoleId ? 'selected' : '' %>" data-value="" data-label="No ping role">No ping role</button>
                            <% safeRoles.forEach(role => { %>
                              <button type="button" class="ai-pretty-picker-option <%= type.pingRoleId === role.id ? 'selected' : '' %>" data-value="<%= role.id %>" data-label="<%= role.name %>">@ <%= role.name %></button>
                            <% }) %>
                            <% if (type.pingRoleId && !safeRoles.some(role => role.id === type.pingRoleId)) { %>
                              <button type="button" class="ai-pretty-picker-option selected" data-value="<%= type.pingRoleId %>" data-label="Saved role ID: <%= type.pingRoleId %>">@ Saved role ID: <%= type.pingRoleId %></button>
                            <% } %>
                          </div>
                          <div class="ai-pretty-picker-empty">No role found</div>
                        </div>
                      </div>
                    </label>
                  </div>
                </div>
              <% }) %>
            </div></div>

            <button class="primary-btn">Save Staff Application Settings</button>
          </form>
        </section>
      <% } %>
    </div>
  </main>
</div>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const closeAllPrettySelects = (except = null) => {
      document.querySelectorAll(".pretty-select.open").forEach((box) => {
        if (box !== except) box.classList.remove("open");
      });
    };

    const buildPrettySelect = (select) => {
      if (!select || select.dataset.prettyReady === "true") return;

      select.dataset.prettyReady = "true";
      select.classList.add("ai-pretty-hidden");

      const wrapper = document.createElement("div");
      wrapper.className = "pretty-select";

      const button = document.createElement("button");
      button.type = "button";
      button.className = "pretty-select-button";
      button.innerHTML = '<span class="pretty-select-value"></span><span class="pretty-select-arrow">⌄</span>';

      const menu = document.createElement("div");
      menu.className = "pretty-select-menu";

      const search = document.createElement("input");
      search.type = "search";
      search.className = "pretty-select-search";
      search.placeholder = select.dataset.prettyPlaceholder || "Search...";
      search.autocomplete = "off";

      const optionsWrap = document.createElement("div");
      optionsWrap.className = "pretty-select-options";

      const empty = document.createElement("div");
      empty.className = "pretty-select-empty";
      empty.textContent = "No results found";
      empty.style.display = "none";

      menu.appendChild(search);
      menu.appendChild(optionsWrap);
      menu.appendChild(empty);

      select.parentNode.insertBefore(wrapper, select.nextSibling);
      wrapper.appendChild(button);
      wrapper.appendChild(menu);

      const getSelectedText = () => {
        const option = select.options[select.selectedIndex];
        return option ? option.textContent.trim() : "Select option";
      };

      const updateButton = () => {
        const value = button.querySelector(".pretty-select-value");
        value.textContent = getSelectedText() || "Select option";
      };

      const makeOptionButton = (option, groupLabel = "") => {
        const optionButton = document.createElement("button");
        optionButton.type = "button";
        optionButton.className = "pretty-select-option";
        optionButton.dataset.value = option.value;
        optionButton.dataset.search = `${option.textContent} ${groupLabel}`.toLowerCase();
        optionButton.innerHTML = `<span>${option.textContent.trim()}</span>`;

        if (option.disabled) {
          optionButton.classList.add("disabled");
          optionButton.disabled = true;
        }

        if (option.selected) optionButton.classList.add("selected");

        optionButton.addEventListener("click", () => {
          if (option.disabled) return;

          select.value = option.value;
          select.dispatchEvent(new Event("input", { bubbles: true }));
          select.dispatchEvent(new Event("change", { bubbles: true }));

          optionsWrap.querySelectorAll(".pretty-select-option").forEach((btn) => btn.classList.remove("selected"));
          optionButton.classList.add("selected");
          updateButton();
          wrapper.classList.remove("open");
        });

        return optionButton;
      };

      const rebuildOptions = () => {
        optionsWrap.innerHTML = "";

        Array.from(select.children).forEach((child) => {
          if (child.tagName === "OPTGROUP") {
            const groupTitle = document.createElement("div");
            groupTitle.className = "pretty-select-group";
            groupTitle.textContent = child.label;
            optionsWrap.appendChild(groupTitle);

            Array.from(child.children).forEach((option) => {
              optionsWrap.appendChild(makeOptionButton(option, child.label));
            });
          } else if (child.tagName === "OPTION") {
            optionsWrap.appendChild(makeOptionButton(child));
          }
        });
      };

      const filterOptions = () => {
        const query = search.value.trim().toLowerCase();
        let visibleCount = 0;

        optionsWrap.querySelectorAll(".pretty-select-option").forEach((optionButton) => {
          const match = !query || optionButton.dataset.search.includes(query);
          optionButton.style.display = match ? "" : "none";
          if (match && !optionButton.classList.contains("disabled")) visibleCount += 1;
        });

        optionsWrap.querySelectorAll(".pretty-select-group").forEach((group) => {
          let next = group.nextElementSibling;
          let hasVisible = false;

          while (next && !next.classList.contains("pretty-select-group")) {
            if (next.classList.contains("pretty-select-option") && next.style.display !== "none") {
              hasVisible = true;
              break;
            }
            next = next.nextElementSibling;
          }

          group.style.display = hasVisible ? "" : "none";
        });

        empty.style.display = visibleCount ? "none" : "";
      };

      button.addEventListener("click", () => {
        const willOpen = !wrapper.classList.contains("open");
        closeAllPrettySelects(wrapper);

        if (willOpen) {
          wrapper.classList.add("open");
          search.value = "";
          filterOptions();
          setTimeout(() => search.focus(), 20);
        } else {
          wrapper.classList.remove("open");
        }
      });

      search.addEventListener("input", filterOptions);

      select.addEventListener("change", () => {
        updateButton();
        rebuildOptions();
        filterOptions();
      });

      rebuildOptions();
      updateButton();
    };

    document.querySelectorAll("select.ai-pretty-select").forEach(buildPrettySelect);

    document.addEventListener("click", (event) => {
      if (!event.target.closest(".pretty-select")) closeAllPrettySelects();
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") closeAllPrettySelects();
    });
  });
</script>


<script>
  document.addEventListener("DOMContentLoaded", () => {
    const closeAllPickers = (except = null) => {
      document.querySelectorAll(".ai-pretty-picker.open").forEach((picker) => {
        if (picker !== except) picker.classList.remove("open");
      });
    };

    document.querySelectorAll(".ai-pretty-picker").forEach((picker) => {
      if (picker.dataset.ready === "true") return;
      picker.dataset.ready = "true";

      const targetName = picker.dataset.target;
      const hiddenInput = document.querySelector(`input[name="${CSS.escape(targetName)}"]`);
      const button = picker.querySelector(".ai-pretty-picker-btn");
      const valueText = picker.querySelector(".ai-pretty-picker-value");
      const search = picker.querySelector(".ai-pretty-picker-search");
      const empty = picker.querySelector(".ai-pretty-picker-empty");
      const options = [...picker.querySelectorAll(".ai-pretty-picker-option")];

      const setSelected = (option) => {
        if (!hiddenInput || !option || option.disabled) return;

        hiddenInput.value = option.dataset.value || "";
        hiddenInput.dispatchEvent(new Event("input", { bubbles: true }));
        hiddenInput.dispatchEvent(new Event("change", { bubbles: true }));

        options.forEach((item) => item.classList.remove("selected"));
        option.classList.add("selected");

        valueText.textContent = option.textContent.trim() || "Select option";
        picker.classList.remove("open");
      };

      const filter = () => {
        const query = (search.value || "").trim().toLowerCase();
        let visible = 0;

        options.forEach((option) => {
          const label = (option.dataset.label || option.textContent || "").toLowerCase();
          const match = !query || label.includes(query);
          option.style.display = match ? "" : "none";
          if (match && !option.disabled) visible += 1;
        });

        picker.querySelectorAll(".ai-pretty-picker-group").forEach((group) => {
          let next = group.nextElementSibling;
          let groupHasVisible = false;

          while (next && !next.classList.contains("ai-pretty-picker-group")) {
            if (next.classList.contains("ai-pretty-picker-option") && next.style.display !== "none") {
              groupHasVisible = true;
              break;
            }
            next = next.nextElementSibling;
          }

          group.style.display = groupHasVisible ? "" : "none";
        });

        if (empty) empty.style.display = visible ? "none" : "block";
      };

      button.addEventListener("click", () => {
        const shouldOpen = !picker.classList.contains("open");
        closeAllPickers(picker);

        if (shouldOpen) {
          picker.classList.add("open");
          search.value = "";
          filter();
          setTimeout(() => search.focus(), 20);
        } else {
          picker.classList.remove("open");
        }
      });

      options.forEach((option) => {
        option.addEventListener("click", () => setSelected(option));
      });

      search.addEventListener("input", filter);
    });

    document.addEventListener("click", (event) => {
      if (!event.target.closest(".ai-pretty-picker")) closeAllPickers();
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") closeAllPickers();
    });
  });
</script>

<script src="/dashboard.js"></script>
<script src="/assets/js/site-music.js"></script></body>
</html>
