  "dependencies": {
    "@google/genai": "^1.46.0",
    "discord.js": "^14.19.3",
    "dotenv": "^16.5.0",
    "ejs": "^3.1.10",
    "express": "^4.18.3",
    "express-session": "^1.18.1",
    "mongoose": "^8.0.0"
  }
