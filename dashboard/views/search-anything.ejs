<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"/><title>Search Anything - Legendary Bot</title><meta name="viewport" content="width=device-width, initial-scale=1.0"/><link rel="stylesheet" href="/style.css"/><link rel="icon" type="image/png" href="/favicon.png?v=10.0.0"/></head><body><div class="app-shell"><%- include("partials/sidebar") %><main class="main-content"><%- include("partials/topbar", { pageTitle: "Search Anything", pageSubtitle: "Search saved dashboard data." }) %><% if (error) { %><div class="alert error"><%= error %></div><% } %><section class="hero-card"><div class="hero-text"><div class="hero-icon-wrap"><img src="<%= botAvatar %>" class="hero-bot-avatar"/></div><div><h2>🔎 Search Anything</h2><p>Search templates, auto messages, confessions, XP users, and custom commands.</p></div></div></section><section class="section-card"><form method="GET" action="/search-anything" class="form-stack padded-form"><label class="form-group"><span>Search</span><input name="q" class="input" value="<%= query || '' %>" placeholder="Search dashboard data..."/></label><button class="primary-btn">Search</button></form></section><section class="section-card"><div class="section-header"><h2>Results</h2><p><%= results.length %> result(s)</p></div><div class="template-grid"><% if (!results.length) { %><div class="empty-mini">Type something above to search.</div><% } %><% results.forEach(item => { %><div class="template-card"><span class="status-pill good"><%= item.type %></span><h3><%= item.title %></h3><p><%= item.detail %></p></div><% }) %></div></section></main></div><script src="/dashboard.js"></script></body></html>
