<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Legendary Command Center</title>
  <link rel="icon" type="image/png" href="/favicon.png"/>
  <link rel="stylesheet" href="/style.css"/>
  <style>
    :root {
      --bg: #080a13;
      --rail: #060711;
      --side: #111421;
      --chat: #0c0f1e;
      --panel: #15192b;
      --soft: rgba(255,255,255,0.075);
      --border: rgba(255,255,255,0.105);
      --text: #f8fafc;
      --muted: rgba(226,232,240,0.68);
      --purple: #8b5cf6;
      --cyan: #22d3ee;
      --green: #22c55e;
      --red: #ef4444;
      --discord: #5865f2;
    }

    * { box-sizing: border-box; }
    body {
      margin: 0;
      height: 100vh;
      overflow: hidden;
      background: var(--bg);
      color: var(--text);
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }

    button, input, textarea, select { font: inherit; }

    .lc-app {
      height: 100vh;
      display: grid;
      grid-template-columns: 72px 260px minmax(0, 1fr) 280px;
      background: var(--bg);
    }

    .lc-rail {
      background: #060711;
      border-right: 1px solid var(--border);
      padding: 12px 8px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 11px;
      min-height: 0;
    }

    .lc-logo, .lc-guild-bubble {
      width: 50px;
      height: 50px;
      border-radius: 18px;
      display: grid;
      place-items: center;
      overflow: hidden;
      color: #fff;
      text-decoration: none;
      font-weight: 1000;
      transition: border-radius .18s ease, transform .18s ease;
    }

    .lc-logo:hover, .lc-guild-bubble:hover {
      border-radius: 15px;
      transform: translateY(-1px);
    }

    .lc-logo {
      background: linear-gradient(135deg, var(--purple), var(--cyan));
      box-shadow: 0 18px 44px rgba(139,92,246,.30);
      font-size: 24px;
    }

    .lc-guild-bubble {
      background: var(--panel);
      border: 1px solid var(--border);
    }

    .lc-guild-bubble img { width: 100%; height: 100%; object-fit: cover; }

    .lc-sidebar {
      min-width: 0;
      background: #111421;
      border-right: 1px solid var(--border);
      display: flex;
      flex-direction: column;
      min-height: 0;
    }

    .lc-guild-head {
      height: 56px;
      padding: 12px 14px;
      border-bottom: 1px solid rgba(0,0,0,.35);
      box-shadow: 0 1px 0 rgba(255,255,255,.04);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      flex: 0 0 auto;
    }

    .lc-guild-title {
      font-size: .94rem;
      font-weight: 1000;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .lc-guild-sub {
      color: var(--muted);
      font-size: .72rem;
      margin-top: 2px;
    }

    .lc-channel-search {
      padding: 10px 10px 8px;
      flex: 0 0 auto;
    }

    .lc-search-input {
      width: 100%;
      border: 1px solid transparent;
      background: rgba(0,0,0,.22);
      color: #fff;
      outline: none;
      border-radius: 8px;
      padding: 9px 10px;
      font-weight: 800;
      font-size: .86rem;
    }

    .lc-channel-list {
      overflow: auto;
      flex: 1;
      min-height: 0;
      padding: 4px 8px 10px;
    }

    .lc-category {
      margin: 13px 0 5px;
      padding: 0 6px;
      color: rgba(226,232,240,.48);
      font-size: .69rem;
      font-weight: 1000;
      letter-spacing: .08em;
      text-transform: uppercase;
      display: flex;
      justify-content: space-between;
      gap: 8px;
    }

    .lc-channel {
      width: 100%;
      border: 0;
      border-radius: 7px;
      padding: 7px 8px;
      background: transparent;
      color: rgba(226,232,240,.70);
      display: flex;
      align-items: center;
      gap: 8px;
      text-align: left;
      cursor: pointer;
      font-weight: 800;
      margin: 2px 0;
      min-width: 0;
    }

    .lc-channel span:last-child {
      min-width: 0;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .lc-channel:hover { background: rgba(255,255,255,.07); color: #fff; }
    .lc-channel.active { background: rgba(255,255,255,.11); color: #fff; }

    .lc-main {
      min-width: 0;
      display: grid;
      grid-template-rows: 56px minmax(0, 1fr) auto;
      background: #0c0f1e;
      min-height: 0;
    }

    .lc-chat-head {
      border-bottom: 1px solid var(--border);
      padding: 0 16px;
      display: flex;
      align-items: center;
      gap: 14px;
      background: #0f1324;
      min-width: 0;
    }

    .lc-chat-title { min-width: 0; flex: 1; }
    .lc-chat-title strong { display: block; font-size: 1rem; font-weight: 1000; }
    .lc-chat-title span {
      display: block;
      margin-top: 2px;
      color: var(--muted);
      font-size: .78rem;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .lc-actions { display: flex; gap: 8px; }
    .lc-btn {
      border: 1px solid var(--border);
      background: rgba(255,255,255,.075);
      color: #fff;
      border-radius: 8px;
      padding: 8px 10px;
      font-weight: 900;
      cursor: pointer;
      font-size: .84rem;
    }
    .lc-btn:hover { border-color: rgba(34,211,238,.55); background: rgba(34,211,238,.12); }

    .lc-icon-btn {
      width: 34px;
      height: 34px;
      display: grid;
      place-items: center;
      border: 1px solid var(--border);
      background: rgba(255,255,255,.06);
      color: #fff;
      border-radius: 10px;
      cursor: pointer;
      font-weight: 1000;
    }

    .lc-messages {
      overflow: auto;
      padding: 12px 18px 14px;
      display: flex;
      flex-direction: column;
      gap: 1px;
      min-height: 0;
    }

    .lc-empty {
      margin: auto;
      max-width: 560px;
      text-align: center;
      color: var(--muted);
    }
    .lc-empty h2 {
      margin: 0 0 10px;
      color: #fff;
      font-size: clamp(2rem, 3.7vw, 4.3rem);
      letter-spacing: -.08em;
      line-height: .9;
    }

    .lc-load-older {
      align-self: center;
      margin-bottom: 10px;
      border: 1px solid rgba(139,92,246,.36);
      background: rgba(139,92,246,.13);
      color: #fff;
      border-radius: 999px;
      padding: 8px 13px;
      cursor: pointer;
      font-weight: 1000;
      font-size: .82rem;
    }

    .lc-message {
      display: grid;
      grid-template-columns: 44px minmax(0, 1fr);
      gap: 10px;
      padding: 7px 8px;
      border-radius: 8px;
      position: relative;
    }
    .lc-message:hover { background: rgba(255,255,255,.045); }
    .lc-message:hover .lc-msg-buttons { opacity: 1; }

    .lc-avatar {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      background: linear-gradient(135deg, rgba(139,92,246,.48), rgba(34,211,238,.35));
      overflow: hidden;
      display: grid;
      place-items: center;
      font-weight: 1000;
      cursor: pointer;
    }
    .lc-avatar img { width: 100%; height: 100%; object-fit: cover; }

    .lc-msg-top {
      display: flex;
      align-items: baseline;
      gap: 8px;
      min-width: 0;
    }
    .lc-author { color: #fff; font-weight: 1000; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; cursor: pointer; }
    .lc-bot { font-size: .65rem; padding: 2px 5px; border-radius: 5px; background: var(--discord); color: #fff; font-weight: 1000; }
    .lc-time { color: rgba(226,232,240,.40); font-size: .72rem; white-space: nowrap; }
    .lc-content { margin-top: 2px; white-space: pre-wrap; word-break: break-word; line-height: 1.42; color: rgba(248,250,252,.90); }

    .lc-msg-buttons {
      position: absolute;
      right: 10px;
      top: -10px;
      display: flex;
      gap: 6px;
      opacity: 0;
      background: #111421;
      border: 1px solid var(--border);
      border-radius: 9px;
      padding: 4px;
      box-shadow: 0 12px 26px rgba(0,0,0,.25);
    }
    .lc-msg-buttons .lc-btn { padding: 5px 8px; border-radius: 7px; font-size: .72rem; }

    .lc-attachments { margin-top: 7px; display: flex; flex-wrap: wrap; gap: 7px; }
    .lc-attachment {
      color: #bfdbfe;
      text-decoration: none;
      border: 1px solid rgba(59,130,246,.25);
      background: rgba(59,130,246,.10);
      border-radius: 8px;
      padding: 7px 9px;
      font-weight: 850;
      max-width: 260px;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .lc-composer {
      border-top: 1px solid var(--border);
      padding: 10px 14px 14px;
      background: #0f1324;
      position: relative;
    }

    .lc-reply-box {
      display: none;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 8px;
      border: 1px solid rgba(34,211,238,.25);
      background: rgba(34,211,238,.08);
      border-radius: 10px;
      padding: 8px 10px;
      font-size: .82rem;
      font-weight: 850;
      color: rgba(226,232,240,.86);
    }
    .lc-reply-box.show { display: flex; }

    .lc-slash-menu {
      display: none;
      position: absolute;
      left: 14px;
      right: 14px;
      bottom: calc(100% - 4px);
      max-height: 260px;
      overflow: auto;
      background: #15192b;
      border: 1px solid rgba(139,92,246,.35);
      border-radius: 14px;
      box-shadow: 0 22px 60px rgba(0,0,0,.42);
      padding: 8px;
      z-index: 80;
    }
    .lc-slash-menu.show { display: block; }

    .lc-command-item {
      display: grid;
      grid-template-columns: 42px 1fr;
      gap: 10px;
      align-items: center;
      padding: 9px;
      border-radius: 10px;
      cursor: pointer;
      color: rgba(248,250,252,.92);
    }
    .lc-command-item:hover, .lc-command-item.active { background: rgba(88,101,242,.26); }
    .lc-command-icon {
      width: 36px;
      height: 36px;
      border-radius: 12px;
      display: grid;
      place-items: center;
      background: rgba(88,101,242,.28);
      font-weight: 1000;
    }
    .lc-command-name { font-weight: 1000; }
    .lc-command-desc { color: var(--muted); font-size: .78rem; margin-top: 2px; }

    .lc-compose-row {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 10px;
      align-items: end;
    }

    .lc-input {
      width: 100%;
      min-height: 48px;
      max-height: 120px;
      resize: vertical;
      border: 1px solid transparent;
      border-radius: 13px;
      background: rgba(255,255,255,.075);
      color: #fff;
      outline: none;
      padding: 13px 14px;
      font-weight: 750;
      line-height: 1.4;
    }
    .lc-input:focus { border-color: rgba(34,211,238,.50); }

    .lc-send {
      border: 0;
      border-radius: 13px;
      min-height: 48px;
      padding: 0 16px;
      background: var(--discord);
      color: #fff;
      cursor: pointer;
      font-weight: 1000;
      box-shadow: 0 14px 30px rgba(88,101,242,.23);
    }
    .lc-send:disabled { opacity: .45; cursor: not-allowed; }

    .lc-right {
      min-width: 0;
      background: #111421;
      border-left: 1px solid var(--border);
      display: grid;
      grid-template-rows: 56px minmax(0, 1fr);
      min-height: 0;
    }

    .lc-members-head {
      height: 56px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 14px;
      border-bottom: 1px solid var(--border);
      font-weight: 1000;
    }

    .lc-members-body {
      min-height: 0;
      overflow: auto;
      padding: 10px;
    }

    .lc-card {
      margin-bottom: 10px;
      padding: 12px;
      border-radius: 14px;
      background: rgba(255,255,255,.045);
      border: 1px solid var(--border);
    }
    .lc-card h3 { margin: 0 0 7px; font-size: .92rem; }
    .lc-card p { margin: 0; color: var(--muted); font-size: .80rem; line-height: 1.4; }

    .lc-member-row {
      display: flex;
      gap: 9px;
      align-items: center;
      padding: 8px;
      border-radius: 9px;
      cursor: pointer;
      margin-top: 4px;
      background: transparent;
    }
    .lc-member-row:hover, .lc-member-row.active { background: rgba(255,255,255,.075); }
    .lc-member-row img { width: 34px; height: 34px; border-radius: 50%; }
    .lc-member-name { min-width: 0; flex: 1; font-weight: 900; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .lc-member-sub { font-size: .72rem; color: var(--muted); }

    .lc-field {
      width: 100%;
      border: 1px solid var(--border);
      background: rgba(255,255,255,.075);
      color: #fff;
      outline: none;
      border-radius: 10px;
      padding: 9px 10px;
      font-weight: 800;
      margin-top: 7px;
      font-size: .83rem;
    }

    .lc-grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 7px; margin-top: 9px; }
    .lc-danger { background: rgba(239,68,68,.14); border-color: rgba(239,68,68,.35); }
    .lc-good { background: rgba(34,197,94,.14); border-color: rgba(34,197,94,.35); }

    .lc-tools-drawer {
      display: none;
      position: fixed;
      right: 20px;
      bottom: 20px;
      width: min(420px, calc(100vw - 40px));
      max-height: min(640px, calc(100vh - 40px));
      overflow: auto;
      z-index: 100;
      background: #111421;
      border: 1px solid rgba(139,92,246,.35);
      border-radius: 18px;
      box-shadow: 0 30px 90px rgba(0,0,0,.55);
      padding: 14px;
    }
    .lc-tools-drawer.show { display: block; }

    .lc-popout {
      display: none;
      position: fixed;
      right: 310px;
      top: 72px;
      width: 340px;
      max-height: calc(100vh - 95px);
      overflow: auto;
      z-index: 110;
      background: #111421;
      border: 1px solid rgba(139,92,246,.35);
      border-radius: 18px;
      box-shadow: 0 30px 90px rgba(0,0,0,.55);
    }
    .lc-popout.show { display: block; }
    .lc-popout-banner { height: 78px; background: linear-gradient(135deg, var(--purple), var(--cyan)); }
    .lc-popout-content { padding: 0 14px 14px; }
    .lc-popout-avatar {
      width: 76px;
      height: 76px;
      border-radius: 50%;
      margin-top: -38px;
      border: 6px solid #111421;
      overflow: hidden;
      background: var(--panel);
    }
    .lc-popout-avatar img { width: 100%; height: 100%; object-fit: cover; }
    .lc-profile-name { font-size: 1.1rem; font-weight: 1000; margin-top: 8px; }
    .lc-profile-id { color: var(--muted); font-size: .75rem; margin-top: 2px; }
    .lc-role-pills { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 10px; }
    .lc-role-pill {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: rgba(255,255,255,.075);
      border: 1px solid var(--border);
      border-radius: 999px;
      padding: 5px 8px;
      font-size: .76rem;
      font-weight: 850;
    }
    .lc-role-remove {
      border: 0;
      background: transparent;
      color: rgba(255,255,255,.70);
      cursor: pointer;
      font-weight: 1000;
      padding: 0;
    }

    .lc-context-menu {
      display: none;
      position: fixed;
      z-index: 140;
      min-width: 190px;
      background: #111421;
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 6px;
      box-shadow: 0 20px 50px rgba(0,0,0,.45);
    }
    .lc-context-menu.show { display: block; }
    .lc-context-menu button {
      width: 100%;
      border: 0;
      background: transparent;
      color: #fff;
      text-align: left;
      border-radius: 8px;
      padding: 9px 10px;
      cursor: pointer;
      font-weight: 850;
      font-size: .84rem;
    }
    .lc-context-menu button:hover { background: rgba(255,255,255,.08); }
    .lc-context-menu button.danger { color: #fecaca; }

    .lc-toast {
      position: fixed;
      right: 20px;
      bottom: 20px;
      z-index: 99999;
      display: none;
      min-width: 280px;
      max-width: 440px;
      padding: 14px 16px;
      border-radius: 18px;
      background: rgba(15,23,42,.97);
      border: 1px solid var(--border);
      color: #fff;
      font-weight: 900;
      box-shadow: 0 20px 60px rgba(0,0,0,.34);
    }
    .lc-toast.show { display: block; }
    .lc-toast.error { border-color: rgba(239,68,68,.58); background: rgba(69,10,10,.97); }
    .lc-toast.success { border-color: rgba(34,197,94,.58); background: rgba(5,46,22,.97); }


    .lc-server-menu { position: relative; min-width: 0; flex: 1; }
    .lc-server-menu-btn { width: 100%; border: 0; background: transparent; color: #fff; text-align: left; padding: 0; cursor: pointer; display: flex; align-items: center; justify-content: space-between; gap: 8px; }
    .lc-server-menu-panel { display: none; position: absolute; top: calc(100% + 10px); left: 0; width: 235px; background: #15192b; border: 1px solid rgba(139, 92, 246, .35); border-radius: 14px; padding: 7px; box-shadow: 0 24px 70px rgba(0,0,0,.50); z-index: 120; }
    .lc-server-menu-panel.show { display: block; }
    .lc-server-menu-panel button { width: 100%; border: 0; background: transparent; color: #fff; text-align: left; border-radius: 9px; padding: 10px 11px; cursor: pointer; font-weight: 850; }
    .lc-server-menu-panel button:hover { background: rgba(255,255,255,.08); }
    .lc-member-section { margin: 13px 0 5px; padding: 0 8px; color: rgba(226,232,240,.48); font-size: .68rem; font-weight: 1000; letter-spacing: .08em; text-transform: uppercase; display: flex; justify-content: space-between; gap: 8px; }
    .lc-member-color-dot { width: 9px; height: 9px; border-radius: 99px; flex: 0 0 auto; box-shadow: 0 0 12px currentColor; }
    .lc-mention-menu { display: none; position: absolute; left: 14px; right: 14px; bottom: calc(100% - 4px); max-height: 280px; overflow: auto; background: #15192b; border: 1px solid rgba(88,101,242,.40); border-radius: 14px; box-shadow: 0 22px 60px rgba(0,0,0,.42); padding: 8px; z-index: 85; }
    .lc-mention-menu.show { display: block; }
    .lc-mention-item { display: grid; grid-template-columns: 34px 1fr auto; gap: 10px; align-items: center; padding: 8px; border-radius: 10px; cursor: pointer; color: rgba(248,250,252,.92); }
    .lc-mention-item:hover { background: rgba(88,101,242,.26); }
    .lc-mention-avatar { width: 32px; height: 32px; border-radius: 50%; overflow: hidden; background: rgba(88,101,242,.25); display: grid; place-items: center; font-weight: 1000; }
    .lc-mention-avatar img { width: 100%; height: 100%; object-fit: cover; }
    .lc-dm-thread { max-height: 220px; overflow: auto; margin-top: 10px; padding: 8px; border: 1px solid var(--border); background: rgba(0,0,0,.16); border-radius: 12px; }
    .lc-dm-line { padding: 7px 8px; border-radius: 9px; margin-bottom: 5px; background: rgba(255,255,255,.045); font-size: .8rem; line-height: 1.35; }

    @media (max-width: 1180px) {
      .lc-app { grid-template-columns: 72px 240px minmax(0,1fr); }
      .lc-right { display: none; }
      .lc-popout { right: 20px; }
    }
    @media (max-width: 760px) {
      body { overflow: auto; }
      .lc-app { height: auto; min-height: 100vh; grid-template-columns: 1fr; }
      .lc-rail { display: none; }
      .lc-sidebar { min-height: 280px; }
      .lc-main { min-height: 720px; }
      .lc-popout { left: 12px; right: 12px; width: auto; }
    }
  </style>
</head>
<body>
  <div class="lc-app">
    <aside class="lc-rail">
      <a class="lc-logo" href="<%= routeBase %>/dashboard" title="Dashboard">⚡</a>
      <div class="lc-guild-bubble" title="<%= guildName %>">
        <% if (guildIcon) { %><img src="<%= guildIcon %>" alt="<%= guildName %>"/><% } else { %><span>L</span><% } %>
      </div>
      <button class="lc-icon-btn" id="lcOpenTools" title="Server Builder">＋</button>
    </aside>

    <aside class="lc-sidebar">
      <div class="lc-guild-head">
        <div class="lc-server-menu">
          <button class="lc-server-menu-btn" id="lcServerMenuBtn" type="button">
            <div style="min-width:0;">
              <div class="lc-guild-title"><%= guildName %></div>
              <div class="lc-guild-sub">Legendary Bot</div>
            </div>
            <span>⌄</span>
          </button>
          <div class="lc-server-menu-panel" id="lcServerMenuPanel">
            <button type="button" id="lcMenuCreateChannel">Create Channel</button>
            <button type="button" id="lcMenuCreateCategory">Create Category</button>
            <button type="button" id="lcMenuCreateRole">Create Role</button>
            <button type="button" id="lcMenuServerSettings">Server Settings</button>
          </div>
        </div>
        <button class="lc-icon-btn" id="lcBackBtn" type="button">⌂</button>
      </div>
      <div class="lc-channel-search">
        <input id="lcChannelSearch" class="lc-search-input" placeholder="Find channel"/>
      </div>
      <div class="lc-channel-list" id="lcChannelList">
        <div class="lc-category">Loading channels...</div>
      </div>
    </aside>

    <main class="lc-main">
      <header class="lc-chat-head">
        <div class="lc-chat-title">
          <strong id="lcChannelTitle"># select-a-channel</strong>
          <span id="lcChannelTopic">Choose a channel to view messages and send as <%= botName %>.</span>
        </div>
        <div class="lc-actions">
          <button class="lc-btn" id="lcRefreshBtn" type="button">Refresh</button>
          <button class="lc-btn" id="lcOpenToolsTop" type="button">Tools</button>
        </div>
      </header>

      <section class="lc-messages" id="lcMessages">
        <div class="lc-empty">
          <h2>Legendary Command Center</h2>
          <p>Pick a channel. Type <b>/</b> to open the command list. Right-click a member for quick actions.</p>
        </div>
      </section>

      <section class="lc-composer">
        <div class="lc-slash-menu" id="lcSlashMenu"></div>
        <div class="lc-mention-menu" id="lcMentionMenu"></div>
        <div class="lc-reply-box" id="lcReplyBox">
          <span id="lcReplyText">Replying...</span>
          <button class="lc-btn" id="lcCancelReply" type="button">Cancel</button>
        </div>
        <div class="lc-compose-row">
          <textarea class="lc-input" id="lcMessageInput" placeholder="Message #channel as <%= botName %>..." disabled></textarea>
          <button class="lc-send" id="lcSendBtn" type="button" disabled>Send</button>
        </div>
      </section>
    </main>

    <aside class="lc-right">
      <div class="lc-members-head">
        <span>Members</span>
        <button class="lc-icon-btn" id="lcRefreshMembers" type="button">↻</button>
      </div>
      <div class="lc-members-body">
        <div class="lc-card">
          <h3>Member Search</h3>
          <input id="lcMemberSearch" class="lc-field" placeholder="Search username / ID..."/>
        </div>
        <div id="lcMemberResults"></div>
      </div>
    </aside>
  </div>

  <div class="lc-tools-drawer" id="lcToolsDrawer">
    <div style="display:flex; justify-content:space-between; gap:12px; align-items:center; margin-bottom:10px;">
      <strong>Server Builder</strong>
      <button class="lc-icon-btn" id="lcCloseTools">×</button>
