<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"/><title>Custom Commands - Legendary Bot</title><meta name="viewport" content="width=device-width, initial-scale=1.0"/><link rel="stylesheet" href="/style.css"/><link rel="icon" type="image/png" href="/favicon.png?v=10.0.0"/></head><body><div class="app-shell"><%- include("partials/sidebar") %><main class="main-content"><%- include("partials/topbar", { pageTitle: "Custom Commands", pageSubtitle: "Create prefix commands from the dashboard." }) %><% if (success) { %><div class="alert success"><%= success %></div><% } %><% if (error) { %><div class="alert error"><%= error %></div><% } %><section class="hero-card"><div class="hero-text"><div class="hero-icon-wrap"><img src="<%= botAvatar %>" class="hero-bot-avatar"/></div><div><h2>⌨️ Custom Command Builder</h2><p>Create commands like $rules, $links, or $vip with normal text or embed replies.</p></div></div></section><section class="section-card"><form method="POST" action="/custom-commands/create" class="form-stack padded-form"><label class="form-group"><span>Trigger</span><input name="trigger" class="input" placeholder="rules" required/></label><label class="form-group"><span>Normal Response</span><textarea name="response" class="input textarea"></textarea></label><label class="toggle-line"><input type="checkbox" name="embedEnabled"/><span>Send Embed</span></label><input name="embedTitle" class="input" placeholder="Embed title"/><textarea name="embedDescription" class="input textarea" placeholder="Embed description"></textarea><div class="color-row"><input type="color" name="embedColor" class="color-picker" value="#8b5cf6"/><input class="input color-hex-input" value="#8b5cf6"/></div><button class="primary-btn">Save Command</button></form></section><section class="section-card"><div class="section-header"><h2>Saved Commands</h2></div><div class="template-grid"><% if (!commands.length) { %><div class="empty-mini">No custom commands yet.</div><% } %><% commands.forEach(cmd => { %><div class="template-card"><h3>$<%= cmd.trigger %></h3><p><%= cmd.enabled ? 'Enabled' : 'Disabled' %></p><p><%= cmd.response || cmd.embedTitle || 'Embed command' %></p><div class="action-row"><form method="POST" action="/custom-commands/toggle/<%= cmd._id %>"><button class="mini-btn"><%= cmd.enabled ? 'Disable' : 'Enable' %></button></form><form method="POST" action="/custom-commands/delete/<%= cmd._id %>"><button class="mini-btn danger">Delete</button></form></div></div><% }) %></div></section></main></div><script src="/dashboard.js"></script><script src="/assets/js/site-music.js"></script></body></html>
