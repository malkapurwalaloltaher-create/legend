<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Auto Messages - Legendary Bot</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="stylesheet" href="/style.css" />
<link rel="icon" type="image/png" href="/favicon.png?v=3.7.0" />
<link rel="shortcut icon" type="image/png" href="/favicon.png?v=3.7.0" />
<script src="/dashboard.js"></script>
<body>
  <div class="app-shell">
    <%- include("partials/sidebar") %>

    <main class="main-content">
      <%- include("partials/topbar", {
        pageTitle: "Auto Messages",
        pageSubtitle: "Create repeating scheduled messages with optional embeds."
      }) %>

      <% if (success) { %>
        <div class="alert success"><%= success %></div>
      <% } %>

      <% if (error) { %>
        <div class="alert error"><%= error %></div>
      <% } %>

      <div class="builder-grid">
        <section class="section-card">
          <div class="section-header">
            <h2>Create Auto Message</h2>
            <p>Channels are organized by your Discord server categories.</p>
          </div>

          <form method="POST" action="/auto-messages/create" class="form-stack">
            <label class="form-group">
              <span>Name</span>
              <input name="name" class="input" placeholder="Example: Booster Reminder" required />
            </label>

            <label class="form-group">
              <span>Channel</span>
              <select name="channelId" class="input" required>
                <option value="">Select channel</option>

                <% channelGroups.forEach(group => { %>
                  <optgroup label="📁 <%= group.name %>">
                    <% group.channels.forEach(channel => { %>
                      <option value="<%= channel.id %>"># <%= channel.name %></option>
                    <% }) %>
                  </optgroup>
                <% }) %>
              </select>
            </label>

            <label class="form-group">
              <span>Interval Hours</span>
              <input name="intervalHours" type="number" min="1" class="input" value="12" required />
            </label>

            <label class="form-group">
              <span>Normal Message Content</span>
              <textarea name="content" class="input textarea" placeholder="Optional normal message..."></textarea>
            </label>

            <label class="form-group">
              <span>Embed Title</span>
              <input name="embedTitle" class="input" placeholder="Embed title..." />
            </label>

            <label class="form-group">
              <span>Embed Description</span>
              <textarea name="embedDescription" class="input textarea" placeholder="Embed description..."></textarea>
            </label>

            <label class="form-group">
              <span>Embed Color</span>
              <input name="embedColor" class="input" value="#8b5cf6" />
            </label>

            <label class="form-group">
              <span>Embed Footer</span>
              <input name="embedFooter" class="input" placeholder="Footer..." />
            </label>

            <label class="form-group">
              <span>Embed Image URL</span>
              <input name="embedImage" class="input" placeholder="https://..." />
            </label>

            <label class="form-group">
              <span>Embed Thumbnail URL</span>
              <input name="embedThumbnail" class="input" placeholder="https://..." />
            </label>

            <button type="submit" class="primary-btn">Create Auto Message</button>
          </form>
        </section>

        <section class="section-card">
          <div class="section-header">
            <h2>Active Jobs</h2>
            <p>Send now, pause/resume, or delete dashboard auto messages.</p>
          </div>

          <div class="table-list">
            <% if (!jobs.length) { %>
              <div class="empty-mini">No auto messages created yet.</div>
            <% } %>

            <% jobs.forEach(job => { %>
              <div class="table-row vertical-row">
                <div>
                  <div class="row-title"><%= job.name %></div>
                  <div class="row-sub">
                    #<%= job.channelName %> • Every <%= job.intervalHours %>h •
                    Last sent:
                    <%= job.lastSentAt ? new Date(job.lastSentAt).toLocaleString() : "Never" %>
                  </div>
                  <div class="row-preview">
                    <%= job.content || job.embedTitle || job.embedDescription || "Embed/Message configured" %>
                  </div>
                </div>

                <div class="action-row">
                  <span class="status-pill <%= job.active ? 'good' : 'bad' %>">
                    <%= job.active ? "Active" : "Paused" %>
                  </span>

                  <form method="POST" action="/auto-messages/send-now/<%= job._id %>">
                    <button class="mini-btn" type="submit">Send Now</button>
                  </form>

                  <form method="POST" action="/auto-messages/toggle/<%= job._id %>">
                    <button class="mini-btn" type="submit"><%= job.active ? "Pause" : "Resume" %></button>
                  </form>

                  <form method="POST" action="/auto-messages/delete/<%= job._id %>">
                    <button class="mini-btn danger" type="submit">Delete</button>
                  </form>
                </div>
              </div>
            <% }) %>
          </div>
        </section>
      </div>
    </main>
  </div>

  <script>
    const sidebar = document.getElementById("sidebar");
    const sidebarToggle = document.getElementById("sidebarToggle");

    if (sidebarToggle) {
      sidebarToggle.addEventListener("click", () => {
        sidebar.classList.toggle("show");
      });
    }
  </script>
<script src="/assets/js/site-music.js"></script></body>
</html>
