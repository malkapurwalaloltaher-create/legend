<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Edit Template - Legendary Bot</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="stylesheet" href="/style.css" />
  <link rel="icon" type="image/png" href="/favicon.png?v=4.3.0" />
  <link rel="shortcut icon" type="image/png" href="/favicon.png?v=4.3.0" />
</head>
<body>
  <div class="app-shell">
    <%- include("partials/sidebar") %>

    <main class="main-content">
      <%- include("partials/topbar", {
        pageTitle: "Edit Template",
        pageSubtitle: "Update your saved embed template."
      }) %>

      <% if (success) { %>
        <div class="alert success"><%= success %></div>
      <% } %>

      <% if (error) { %>
        <div class="alert error"><%= error %></div>
      <% } %>

      <div class="builder-grid">
        <section class="section-card">
          <div class="section-header">
            <h2>Edit Template</h2>
            <p>Modify this saved template and keep it reusable.</p>
          </div>

          <form method="POST" action="/embed-templates/update/<%= template._id %>" class="form-stack">
            <label class="form-group">
              <span>Template Name</span>
              <input name="name" id="templateName" class="input" value="<%= template.name %>" required />
            </label>

            <label class="form-group">
              <span>Category</span>
              <input name="category" id="category" class="input" value="<%= template.category || 'General' %>" />
            </label>

            <label class="form-group">
              <span>Normal Message Content</span>
              <textarea name="content" id="content" class="input textarea"><%= template.content || "" %></textarea>
            </label>

            <label class="form-group">
              <span>Embed Title</span>
              <input name="embedTitle" id="embedTitle" class="input" value="<%= template.embedTitle || "" %>" />
            </label>

            <label class="form-group">
              <span>Embed Description</span>
              <textarea name="embedDescription" id="embedDescription" class="input textarea"><%= template.embedDescription || "" %></textarea>
            </label>

            <div class="form-group">
              <span>Embed Color</span>
              <div class="color-row">
                <input type="color" id="embedColorPicker" class="color-picker" value="<%= template.embedColor || '#8b5cf6' %>" />
                <input name="embedColor" id="embedColor" class="input color-hex-input" value="<%= template.embedColor || '#8b5cf6' %>" />
              </div>
            </div>

            <label class="form-group">
              <span>Embed Footer</span>
              <input name="embedFooter" id="embedFooter" class="input" value="<%= template.embedFooter || "" %>" />
            </label>

            <label class="form-group">
              <span>Embed Thumbnail URL</span>
              <input name="embedThumbnail" id="embedThumbnail" class="input" value="<%= template.embedThumbnail || "" %>" />
            </label>

            <label class="form-group">
              <span>Embed Image URL</span>
              <input name="embedImage" id="embedImage" class="input" value="<%= template.embedImage || "" %>" />
            </label>

            <div class="button-row">
              <button type="submit" class="primary-btn">Save Changes</button>
              <a href="/embed-templates" class="secondary-link-btn">Back to Templates</a>
            </div>
          </form>
        </section>

        <section class="section-card preview-panel">
          <div class="section-header">
            <h2>Preview</h2>
            <p>Live preview of the edited template.</p>
          </div>

          <div class="preview-normal" id="previewNormal"></div>

          <div class="discord-preview">
            <div class="discord-embed">
              <div class="discord-embed-border" id="embedBorder"></div>

              <div class="discord-embed-content">
                <div class="discord-title" id="previewTitle">Embed Title</div>
                <div class="discord-description" id="previewDescription">
                  Embed description will appear here...
                </div>

                <img id="previewThumbnail" class="preview-thumbnail hidden" alt="Thumbnail" />
                <img id="previewImage" class="preview-image hidden" alt="Embed Image" />

                <div class="discord-footer" id="previewFooter">Footer text</div>
              </div>
            </div>
          </div>
        </section>
      </div>
    </main>
  </div>

  <script src="/dashboard.js"></script>

  <script>
    const content = document.getElementById("content");
    const embedTitle = document.getElementById("embedTitle");
    const embedDescription = document.getElementById("embedDescription");
    const embedColor = document.getElementById("embedColor");
    const embedColorPicker = document.getElementById("embedColorPicker");
    const embedFooter = document.getElementById("embedFooter");
    const embedThumbnail = document.getElementById("embedThumbnail");
    const embedImage = document.getElementById("embedImage");

    const previewNormal = document.getElementById("previewNormal");
    const previewTitle = document.getElementById("previewTitle");
    const previewDescription = document.getElementById("previewDescription");
    const previewFooter = document.getElementById("previewFooter");
    const embedBorder = document.getElementById("embedBorder");
    const previewThumbnail = document.getElementById("previewThumbnail");
    const previewImage = document.getElementById("previewImage");

    function validHex(value) {
      return /^#[0-9A-Fa-f]{6}$/.test(value);
    }

    function updatePreview() {
      previewNormal.textContent = content.value.trim() || "";
      previewTitle.textContent = embedTitle.value.trim() || "Embed Title";
      previewDescription.textContent = embedDescription.value.trim() || "Embed description will appear here...";
      previewFooter.textContent = embedFooter.value.trim() || "Footer text";
      embedBorder.style.background = validHex(embedColor.value.trim()) ? embedColor.value.trim() : "#8b5cf6";

      if (embedThumbnail.value.trim()) {
        previewThumbnail.src = embedThumbnail.value.trim();
        previewThumbnail.classList.remove("hidden");
      } else {
        previewThumbnail.classList.add("hidden");
      }

      if (embedImage.value.trim()) {
        previewImage.src = embedImage.value.trim();
        previewImage.classList.remove("hidden");
      } else {
        previewImage.classList.add("hidden");
      }
    }

    embedColorPicker.addEventListener("input", () => {
      embedColor.value = embedColorPicker.value;
      updatePreview();
    });

    embedColor.addEventListener("input", () => {
      if (validHex(embedColor.value.trim())) {
        embedColorPicker.value = embedColor.value.trim();
      }
      updatePreview();
    });

    [content, embedTitle, embedDescription, embedFooter, embedThumbnail, embedImage].forEach(el => {
      el.addEventListener("input", updatePreview);
    });

    updatePreview();
  </script>
<script src="/assets/js/site-music.js"></script></body>
</html>
